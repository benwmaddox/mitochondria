// behaviours first checked by the Rust runtime's own tests, kept here when it was removed: structs holding only
// collections stay distinct; a failed request rolls back every write; a freed slot is reused lowest first; a pool of
// 100000 items with nested lists commits only the headers of items in use (see the memory line)
--- state
struct M { n: i32; }
struct W { s: pool<M, 4>; }
struct T { a: i64; b: i64; name: string<16>; }
struct R { m: list<M, 8>; }
struct App {
    w0: W;
    w1: W;
    t: T;
    ms: pool<M, 4>;
    rs: pool<R, 100000>;
}
state app: App;
--- api
endpoint POST /w1 { let m = alloc app.w1.s; m.n = 1; respond 201 { "slot": slot(m) }; }
endpoint GET /w { respond 200 { "w0": count(app.w0.s), "w1": count(app.w1.s) }; }
endpoint POST /t { app.t.a = 1; app.t.b = 2; app.t.name = "changed"; let m = alloc app.ms; m.n = 9; if body("fail") == "yes" { fail 409 "rolled back"; } respond 200 { "a": app.t.a }; }
endpoint GET /t { respond 200 { "a": app.t.a, "b": app.t.b, "name": app.t.name, "ms": count(app.ms) }; }
endpoint POST /ms { let m = alloc app.ms; m.n = int(body("n")); respond 201 { "slot": slot(m) }; }
endpoint DELETE /ms/{k} { free app.ms[int(param("k"))]; respond 200 {}; }
endpoint GET /scope { let x = 1; var sum = 0; if true { let x = 10; sum = sum + x; } respond 200 { "x": x, "t": sum }; }
endpoint POST /rs { let r = alloc app.rs; let m = alloc r.m; m.n = 1; respond 201 { "slot": slot(r), "m": count(r.m) }; }
--- requests
POST /w1
GET /w
POST /t {"fail": "yes"}
GET /t
POST /t {"fail": "no"}
GET /t
POST /ms {"n": 1}
POST /ms {"n": 2}
POST /ms {"n": 3}
DELETE /ms/1
DELETE /ms/0
POST /ms {"n": 4}
POST /ms {"n": 5}
POST /rs
GET /scope
