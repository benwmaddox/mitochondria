// an input's range may use constants of a group: `in 0..Limits.MAX`, `in -Limits.MAX..Limits.MAX`, or a mix with numbers
--- program
const Limits { MAX: i64 = 100; MIN: i64 = 10; }
struct T { n: i64; }
state t: T;

@get("/a/{n}")
fn get_a(n: i64 in 0..Limits.MAX) -> Response<{ n: i64 }> { return ok({ "n": n * 2 }); }
@get("/b/{n}")
fn get_b(n: i64 in -Limits.MAX..Limits.MAX) -> Response<{ n: i64 }> { return ok({ "n": n * 1000000000 }); }
@get("/c/{n}")
fn get_c(n: i64 in Limits.MIN..50) -> Response<{ n: i64 }> { return ok({ "n": n }); }
--- requests
GET /a/0
GET /a/100
GET /a/101
GET /b/-100
GET /b/-101
GET /c/9
GET /c/10
GET /c/51
