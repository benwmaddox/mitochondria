// values whose kind changes: a var holding a reference, a var given another kind, functions returning different kinds
--- program
struct Node { name: string<8>; next: ref<app.nodes>; }
struct App {
    nodes: pool<Node, 4> checked;
    top: Top;
}
state app: App;
struct Top { head: ref<app.nodes>; }

fn find(name) { each n in app.nodes { if n.name == name { return n; } } return null; }
fn describe(k) { if k == 0 { return "zero"; } if k < 0 { return null; } return k; }
@post("/nodes")
fn post_nodes() -> Response<{ slot: i64 }> {
    let n = app.nodes.add();
    n.name = body("name");
    n.next = app.top.head;
    app.top.head = n;
    return created({ "slot": slot(n) });
}
@delete("/nodes/{name}")
fn delete_nodes_name() -> Response<{}> { let n = find(param("name")); if n == null { fail 404 "no such node"; } app.nodes.remove(n); return ok({}); }
@get("/walk")
fn get_walk() -> Response<{ names: any, steps: i64 }> {
    var cur = app.top.head;
    var names = "";
    var steps = 0;
    each n in app.nodes {
        if exists(cur) { names = names + cur.name + ","; cur = cur.next; steps = steps + 1; }
    }
    return ok({ "names": names, "steps": steps });
}
@get("/find/{name}")
fn get_find_name() -> Response<{ found: bool, name: string }> { let n = find(param("name")); return ok({ "found": exists(n), "name": or(n.name, "-") }); }
@get("/describe/{k}")
fn get_describe_k() -> Response<{ d: any }> { return ok({ "d": describe(int(param("k"))) }); }
@get("/mixed/{k}")
fn get_mixed_k() -> Response<{ v: any }> {
    var v = 1;
    if int(param("k")) > 5 { v = "big"; }
    if int(param("k")) > 9 { v = null; }
    return ok({ "v": v });
}
--- requests
GET /walk
POST /nodes {"name": "a"}
POST /nodes {"name": "b"}
POST /nodes {"name": "c"}
GET /walk
GET /find/b
GET /find/z
DELETE /nodes/b
GET /walk
GET /find/b
DELETE /nodes/zz
GET /describe/0
GET /describe/-4
GET /describe/12
GET /mixed/1
GET /mixed/7
GET /mixed/11
