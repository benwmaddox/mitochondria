// LangArena Maze::Generator (kostya/LangArena, MIT): generate a perfect maze by digging, 10 times (each run resets the maze and digs it again).
// The reference's maze: a w x h grid (1400 x 1400 for the run parameters) of cell objects, each with its kind (wall, space, start, finish, border), its coordinates
// and its own array of four neighbours in an order shuffled by the reference's random generator when the maze is built. A pool of cells, cell (x, y) is slot
// y * w + x, built and linked in prepare with the reference's random sequence (the reference builds the maze in its constructor, with the generator at its
// starting value, which is what a fresh program has). Kinds: 0 wall, 1 space, 2 start, 3 finish, 4 border; walkable is space, start or finish.
// The checksum is the sum of the kind of the middle cell after each run plus the FNV-1a hash of the x * y of every space cell, taken after the last run (GET /checksum, outside the timed runs, as the reference's checksum() is).
struct Cell { kind: u8; x: i32; y: i32; ny: i32[4]; nx: i32[4]; }
struct M { cells: pool<Cell, 1960000>; w: i64 in 0..1400; h: i64 in 0..1400; last: i64 in 0..139967; result: i64 in 0..4294967295; sy: i32[262144]; sx: i32[262144]; }
state m: M;

fn next_int(max) {
    m.last = (m.last * 3877 + 29573) % 139968;
    return int(m.last / 139968.0 * max);
}

// the reference's Maze::new and link_neighbors
fn build(width, height) {
    m.cells.clear();
    m.w = max(width, 5);
    m.h = max(height, 5);
    m.last = 42;
    let w = m.w;
    let h = m.h;
    each y in 0..h { each x in 0..w { let c = m.cells.add(); c.kind = 0; c.x = x; c.y = y; } }
    each y in 0..h {
        each x in 0..w {
            let c = m.cells[y * w + x];
            if x == 0 || y == 0 || x == w - 1 || y == h - 1 {
                c.kind = 4;
            } else {
                c.ny[0] = y - 1; c.nx[0] = x;
                c.ny[1] = y + 1; c.nx[1] = x;
                c.ny[2] = y;     c.nx[2] = x + 1;
                c.ny[3] = y;     c.nx[3] = x - 1;
                each t in 0..4 {
                    let i = next_int(4);
                    let j = next_int(4);
                    if i != j {
                        let ty = c.ny[i]; c.ny[i] = c.ny[j]; c.ny[j] = ty;
                        let tx = c.nx[i]; c.nx[i] = c.nx[j]; c.nx[j] = tx;
                    }
                }
            }
        }
    }
    m.cells[1 * w + 1].kind = 2;
    m.cells[(h - 2) * w + (w - 2)].kind = 3;
}
// the reference's dig: an explicit stack of cells to look at
fn dig(y0, x0) {
    let w = m.w;
    var sp = 1;
    m.sy[0] = y0;
    m.sx[0] = x0;
    each step in 0..1000000000 while sp > 0 {
        sp = sp - 1;
        let y = m.sy[sp];
        let x = m.sx[sp];
        let c = m.cells[y * w + x];
        var walkable = 0;
        each k in 0..4 {
            let kind = m.cells[c.ny[k] * w + c.nx[k]].kind;
            if kind == 1 || kind == 2 || kind == 3 { walkable = walkable + 1; }
        }
        if walkable == 1 {
            c.kind = 1;
            each k in 0..4 {
                let ny = c.ny[k];
                let nx = c.nx[k];
                if m.cells[ny * w + nx].kind == 0 {
                    m.sy[sp] = ny;
                    m.sx[sp] = nx;
                    sp = sp + 1;
                }
            }
        }
    }
}
// the reference's ensure_open_finish, recursive: which neighbours are walls is decided before any recursion, as the reference collects them first
fn ensure_open_finish(y, x) {
    let w = m.w;
    let c = m.cells[y * w + x];
    c.kind = 1;
    let y0 = c.ny[0]; let x0 = c.nx[0]; let k0 = m.cells[y0 * w + x0].kind;
    let y1 = c.ny[1]; let x1 = c.nx[1]; let k1 = m.cells[y1 * w + x1].kind;
    let y2 = c.ny[2]; let x2 = c.nx[2]; let k2 = m.cells[y2 * w + x2].kind;
    let y3 = c.ny[3]; let x3 = c.nx[3]; let k3 = m.cells[y3 * w + x3].kind;
    var walkable = 0;
    if k0 == 1 || k0 == 2 || k0 == 3 { walkable = walkable + 1; }
    if k1 == 1 || k1 == 2 || k1 == 3 { walkable = walkable + 1; }
    if k2 == 1 || k2 == 2 || k2 == 3 { walkable = walkable + 1; }
    if k3 == 1 || k3 == 2 || k3 == 3 { walkable = walkable + 1; }
    if walkable <= 1 {
        if k0 == 0 { ensure_open_finish(y0, x0); }
        if k1 == 0 { ensure_open_finish(y1, x1); }
        if k2 == 0 { ensure_open_finish(y2, x2); }
        if k3 == 0 { ensure_open_finish(y3, x3); }
    }
}
fn generate() {
    let w = m.w;
    let h = m.h;
    let start = m.cells[1 * w + 1];
    each k in 0..4 {
        let ny = start.ny[k];
        let nx = start.nx[k];
        if m.cells[ny * w + nx].kind == 0 { dig(ny, nx); }
    }
    let finish = m.cells[(h - 2) * w + (w - 2)];
    each k in 0..4 {
        let ny = finish.ny[k];
        let nx = finish.nx[k];
        if m.cells[ny * w + nx].kind == 0 { ensure_open_finish(ny, nx); }
    }
}

fn reset() {
    let w = m.w;
    let h = m.h;
    each i in 0..w * h { let c = m.cells[i]; if c.kind == 1 { c.kind = 0; } }
    m.cells[1 * w + 1].kind = 2;
    m.cells[(h - 2) * w + (w - 2)].kind = 3;
}
fn one_run() {
    reset();
    generate();
    m.result = (m.result + m.cells[(m.h / 2) * m.w + m.w / 2].kind) % 4294967296;
}

@post("/prepare/{w}/{h}")
fn prepare(w: i64 in 5..1400, h: i64 in 5..1400) -> Response<{}> { m.result = 0; build(w, h); return ok({}); }
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { each i in 0..n { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { each i in 0..n { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> {
    var hasher = 2166136261;
    each i in 0..m.w * m.h {
        let c = m.cells[i];
        if c.kind == 1 { hasher = ((hasher ^ (c.x * c.y)) * 16777619) % 4294967296; }
    }
    return ok({ "checksum": (m.result + hasher) % 4294967296 });
}
