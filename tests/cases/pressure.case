// memory pressure: writes refused above the hard mark, reads still served, a full trim run
--- state
struct Meta { next_seq: i64; rate: i64; typing_ttl: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Msg { seq: i64; at: i64; author: ref<sessions>; body: string<2000>; }
struct Typing { who: ref<sessions>; until: i64; }
struct Room { name: string<8>; created: i64; messages: list<Msg, 5> drop_oldest; typing: pool<Typing, 4>; }
global meta: Meta; global sessions: pool<Session, 3> checked; global rooms: pool<Room, 2>;
--- api
include examples/chat/chat.api
--- requests
POST /sessions {"name":"ann"} => ann
@X-Session: $ann
POST /rooms {"name":"r"}
marks 0 0
stats
@X-Session: $ann
POST /rooms/0/messages {"body":"x"}
stats
@X-Session: $ann
POST /rooms/0/messages {"body":"y"}
@X-Session: $ann
GET /rooms/0/messages
stats
marks 100000000 200000000
@X-Session: $ann
POST /rooms/0/messages {"body":"z"}
stats
