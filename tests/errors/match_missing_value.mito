// expect: this `match` on `Op` does not handle `Op.Out`: add it or an `else` arm
enum Op { Plus, Minus, Out } struct App { op: Op; total: i64; } state app: App;
@get("/a") fn a() -> Response<{ n: i64 }> { var n = 0; match app.op { Op.Plus => { n = 1; } Op.Minus => { n = 2; } } return ok({ n: n }); }
