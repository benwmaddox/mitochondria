// jx: a small jq, as a command-line program in three files.
//   jx.mito      this file: the state and `@main`, the command line
//   json.mito    reading JSON where it lies (positions in the input text) and writing it, compact or indented
//   filter.mito  the filter language: paths, `|`, `.[]`, `select(...)`, `length`, `keys`, `type`
// Nothing is parsed into a tree and nothing is allocated: a value is a position in the input text, and results are written
// straight to the output. See README.md.
//
//   echo '{"a":[1,2,{"b":"x"}]}' | mito run examples/jx/jx.mito -- '.a[2].b'

struct J {
    out: utf8<33554432>;   // everything written, at most 32 MB
    fp: i64;               // where a path ended in the filter (set by `path`)
    pretty: bool;          // indent the output (off with -c)
    raw: bool;             // a string result is written without its quotes (-r)
    sep: bool;             // a result was written already: a newline comes first
    err: utf8<200>;        // what went wrong, if something did
}
state j: J;

@main
fn main(filter: utf8<1..1000> from arg(0), doc: utf8<33554432> from stdin, c: bool = false, r: bool = false) -> Response<text> {
    j.pretty = !c;
    j.raw = r;
    let start = skip_ws(doc, 0);
    if start >= len(doc) { return status(400, "jx: no JSON on stdin"); }
    if skip_value(doc, start) < 0 { return status(400, "jx: the input is not valid JSON"); }
    let rc = eval(doc, start, filter, 0);
    if rc != 0 { return status(400, j.err); }
    if len(j.out) > 0 { j.out += "\n"; }
    return ok(j.out);
}

use "json.mito";
use "filter.mito";
