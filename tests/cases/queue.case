// lib/queue.mito: FIFO of struct items, full is 507, empty is 404, wraparound, clear
--- program
struct Job { id: i64; name: string<8>; }
struct App { q: queue<Job, 4>; }
state app: App;

@post("/push/{id}")
fn post_push_id(id: i64) -> Response<{ count: i64 }> { let job = app.q.push(); job.id = id; job.name = "n" + id; return ok({ "count": app.q.count() }); }
@post("/pop")
fn post_pop() -> Response<{ id: i64, name: string }> { let job = app.q.pop(); return ok({ "id": job.id, "name": job.name }); }
@get("/peek")
fn get_peek() -> Response<{ id: i64, name: string }> { let job = app.q.peek(); return ok({ "id": job.id, "name": job.name }); }
@get("/count")
fn get_count() -> Response<{ count: i64, room: i64, empty: bool }> { return ok({ "count": app.q.count(), "room": app.q.room(), "empty": app.q.is_empty() }); }
@post("/clear")
fn post_clear() -> Response<{ count: i64 }> { app.q.clear(); return ok({ "count": app.q.count() }); }
