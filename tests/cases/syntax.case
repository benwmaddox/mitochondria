// collection functions, initializers, compound assignment and unquoted keys (the syntax of docs/proposals/syntax.md)
--- program
struct Item { name: string<8>; n: i64; entry: i64; } // entry: its slot in app.board
struct Entry { who: i64; n: i64; } // who: the item's slot
struct Log { what: string<16>; }
struct App {
    total: i64;
    items: pool<Item, 3> checked;
    board: sorted<Entry, 3, n>;
    log: list<Log, 2> drop_oldest;
}
state app: App;

fn items() { return app.items; }

@post("/items")
fn post_items(n: i64, name: string<4096>?) -> Response<{ id: i64, entry: i64, total: i64 }> {
    let it = app.items.add { name: name, n: n };
    let e = app.board.add(it.n) { who: slot(it) };
    it.entry = slot(e);
    app.log.add { what: "added" };
    app.total += it.n;
    return created({ id: slot(it), entry: slot(e), total: app.total });
}
@post("/maybe")
fn post_maybe() -> Response<{ got: bool, count: i64, of: i64, via_value: i64 }> {
    let it = app.items.try_add();
    return ok({ got: exists(it), count: app.items.count(), of: app.items.capacity(), via_value: items().count() });
}
@post("/sub/{k}")
fn post_sub_k(k: i64) -> Response<{ total: i64 }> {
    app.total -= k;
    app.total *= 2;
    app.total /= 3;
    return ok({ total: app.total });
}
@delete("/items/{k}")
fn delete_items_k(k: i64) -> Response<{ left: i64 }> {
    let it = app.items[k];
    app.board.remove(app.board.get(it.entry));
    app.items.remove(it);
    app.log.add { what: "removed" };
    return ok({ left: app.items.count() });
}
@get("/all")
fn get_all() -> Response<{ items: [{ name: string, n: i64 }], board: [{ name: string, n: i64 }], log: [{ what: string }], "quoted key": i64 }> {
    return ok({
        items: [each it in app.items { name: it.name, n: it.n }],
        board: [each e in app.board reverse { name: or(app.items[e.who].name, "[gone]"), n: e.n }],
        log: [each l in app.log { what: l.what }],
        "quoted key": app.total
    });
}
--- requests
POST /items {"name": "a", "n": 5}
POST /items {"name": "b", "n": 9}
POST /maybe
POST /maybe
GET /all
POST /sub/2
DELETE /items/1
GET /all