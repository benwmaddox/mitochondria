fn me() -> ref<chat.sessions> { return auth(chat.sessions); }
fn room_param() -> ref<chat.rooms> { return chat.rooms.get(int(param("room"))); }
fn typing_until(t: i64) -> i64 { return t + max(chat.meta.typing_ttl, 5000); }

endpoint POST /sessions {
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let s = alloc chat.sessions;
    s.name = name;
    s.secret = random();
    s.window = now();
    respond 201 { "token": token(s), "slot": slot(s) };
}

endpoint DELETE /session {
    free me();
    respond 200 { "ok": true };
}

endpoint POST /rooms {
    let who = me();
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let r = chat.rooms.add(now());
    r.name = name;
    respond 201 { "id": slot(r), "name": r.name };
}

endpoint GET /rooms {
    let who = me();
    respond 200 { "rooms": [each r in chat.rooms { "id": slot(r), "name": r.name }] };
}

endpoint POST /rooms/{room}/messages {
    let who = me();
    let room = room_param();
    let text = body("body");
    if len(text) == 0 { fail 400 "body is required"; }
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(chat.meta.rate, 30) { fail 429 "slow down"; }
    who.sent = who.sent + 1;
    chat.meta.next_seq = chat.meta.next_seq + 1;
    let m = alloc room.messages;
    m.seq = chat.meta.next_seq;
    m.at = t;
    m.author = who;
    m.body = text;
    respond 201 { "seq": m.seq };
}

endpoint GET /rooms/{room}/messages {
    let who = me();
    let room = room_param();
    let n = min(int(or(query("limit"), "50")), 100);
    respond 200 {
        "room": room.name,
        "messages": [each m in room.messages reverse limit n {
            "seq": m.seq, "author": or(m.author.name, "[deleted]"), "at": m.at, "body": m.body
        }]
    };
}

endpoint POST /rooms/{room}/typing {
    let who = me();
    let room = room_param();
    let t = now();
    var found = false;
    each ty in room.typing {
        if or(ty.who == who, false) { ty.until = typing_until(t); found = true; }
        else if ty.until < t { free ty; }
    }
    if !found {
        let ty = alloc room.typing;
        ty.who = who;
        ty.until = typing_until(t);
    }
    respond 200 { "ok": true };
}

endpoint GET /rooms/{room}/typing {
    let who = me();
    let room = room_param();
    let t = now();
    respond 200 { "typing": [each ty in room.typing where ty.until >= t { "name": or(ty.who.name, "[gone]") }] };
}

endpoint GET /stats {
    var messages = 0;
    each r in chat.rooms { messages = messages + count(r.messages); }
    respond 200 {
        "sessions": count(chat.sessions), "rooms": chat.rooms.size(), "messages": messages, "next_seq": chat.meta.next_seq,
        "committed_kb": stat("committed_kb"), "live_kb": stat("live_kb"), "reserved_kb": stat("reserved_kb")
    };
}
