// strings: building, comparing, length limits, plain and item string fields, headers and query values
--- program
struct Meta { motd: string<16>; }
struct Note { text: string<12>; }
struct App {
    meta: Meta;
    notes: list<Note, 4> drop_oldest;
}
state app: App;

@post("/motd")
fn post_motd(m: string<4096>?) -> Response<{ motd: string, len: i64, max: i64 }> { app.meta.motd = m; return ok({ "motd": app.meta.motd, "len": len(app.meta.motd), "max": maxlen(app.meta.motd) }); }
@post("/notes")
fn post_notes(t: string<4096>?) -> Response<{ text: string }> {
    
    let n = app.notes.add();
    if len(t) + 2 > maxlen(n.text) { fail 413 "too long"; }
    n.text = "[" + t + "]";
    return created({ "text": n.text });
}
@get("/notes")
fn get_notes(q: string<4096>?, x_name: string<4096>? from header("X-Name")) -> Response<{ all: string, first: string, eq: bool, lt: bool, hdr: string, q: string }> {
    var all = "";
    each n in app.notes { all = all + n.text; }
    return ok({ "all": all, "first": app.notes[0].text, "eq": app.notes[0].text == "[a]", "lt": "abc" < "abd", "hdr": or(x_name, "none"), "q": q });
}
@get("/concat")
fn get_concat() -> Response<{ a: string, b: string, c: string, d: string }> { return ok({ "a": "n=" + 5, "b": "t=" + true, "c": "x" + null, "d": str(12) + str(false) }); }
--- requests
POST /motd {"m": "hello"}
POST /motd {"m": "this is far too long"}
GET /notes
POST /notes {"t": "a"}
POST /notes {"t": "quote\"d"}
POST /notes {"t": "0123456789"}
GET /notes
@X-Name: zed
GET /notes?q=hi
GET /concat
