// frees happen only when the request succeeds; a slot freed in a request is not reused by it; forward needs a system
--- program
struct T { n: i32; }
struct C { n: i64; }
struct App {
    ts: pool<T, 2>;
    c: C;
}
state app: App;

endpoint POST /t { let t = app.ts.add(); t.n = 7; respond 201 { "slot": slot(t) }; }
endpoint DELETE /t/{k} { let t = app.ts[int(param("k"))]; app.ts.remove(t); if param("k") == "0" { fail 409 "changed my mind"; } respond 200 { "n": t.n }; }
endpoint POST /swap { each t in app.ts { app.ts.remove(t); } let u = app.ts.try_add(); respond 200 { "got": exists(u) }; }
endpoint GET /count { respond 200 { "n": app.ts.count(), "c": app.c.n }; }
endpoint POST /f { app.c.n = 5; forward other[1] { "x": 1 }; }
--- requests
POST /t
POST /t
DELETE /t/0
GET /count
DELETE /t/1
GET /count
POST /t
POST /swap
GET /count
POST /f
GET /count
