// `use "std/intmap.mito";` gives `IntMap<N>`: a hash map from i64 keys to i64 values, up to N entries, one value per key. Separate chaining over plain arrays: a table of N bucket heads and, per entry, its key, value and chain
// link. Removing an entry is an unlink onto a free list that the next put reuses at once (a pool would hold the slot back until the end of the request). Entries are numbered by
// slot + 1; 0 is none. Putting a new key into a full map is an ordinary error (507). (Local names are never a single letter: see lib/btree.mito.)
struct IntMapHead { size: i64; used: i64; free: u32; }
// what an instance holds
struct IntMap<N: count> {
    keys: i64[N];
    values: i64[N];
    links: u32[N];
    heads: u32[N];
    head: IntMapHead;
}

pub fn size(self: IntMap<N>) -> i64 { return self.head.size; }
pub fn room(self: IntMap<N>) -> i64 { return N - self.head.size; }

// the bucket of a key: its bits mixed a little so that keys differing in high bytes only still spread
fn bucket_of(self: IntMap<N>, key: i64) -> i64 {
    let mixed = (key % 4294967296 + 4294967296) % 4294967296;
    return ((mixed ^ (mixed >> 15)) * 40503 + (mixed >> 7)) % N;
}
// the entry for key, 0 if there is none
fn find(self: IntMap<N>, key: i64) -> i64 {
    var cur = self.heads[self.bucket_of(key)];
    var found = 0;
    foreach step in 0..N while cur != 0 && found == 0 {
        if self.keys[cur - 1] == key { found = cur; } else { cur = self.links[cur - 1]; }
    }
    return found;
}
pub fn has(self: IntMap<N>, key: i64) -> bool { return self.find(key) != 0; }
// The value of key, or dflt when there is none.
pub fn get_or(self: IntMap<N>, key: i64, dflt: i64) -> i64 {
    let found = self.find(key);
    var value = dflt;
    if found != 0 { value = self.values[found - 1]; }
    return value;
}
// A new entry for key at the front of its chain; the caller knows the key is not there.
fn insert(self: write IntMap<N>, key: i64, value: i64) {
    var entry = self.head.free;
    if entry != 0 {
        self.head.free = self.links[entry - 1];
    } else {
        if self.head.used >= N { fail 507 "intmap: full"; }
        self.head.used = self.head.used + 1;
        entry = self.head.used;
    }
    let bucket = self.bucket_of(key);
    self.keys[entry - 1] = key;
    self.values[entry - 1] = value;
    self.links[entry - 1] = self.heads[bucket];
    self.heads[bucket] = entry;
    self.head.size = self.head.size + 1;
}
// Set the value of key (adding the key if it is new); true if it was new.
pub fn put(self: write IntMap<N>, key: i64, value: i64) -> bool {
    let found = self.find(key);
    var added = false;
    if found != 0 {
        self.values[found - 1] = value;
    } else {
        self.insert(key, value);
        added = true;
    }
    return added;
}
// Add delta to the value of key, starting from 0 when the key is new; the new value.
pub fn add_to(self: write IntMap<N>, key: i64, delta: i64) -> i64 {
    let found = self.find(key);
    var value = delta;
    if found != 0 {
        value = self.values[found - 1] + delta;
        self.values[found - 1] = value;
    } else {
        self.insert(key, delta);
    }
    return value;
}
// Remove key; true if it was there.
pub fn remove(self: write IntMap<N>, key: i64) -> bool {
    let bucket = self.bucket_of(key);
    var cur = self.heads[bucket];
    var prev = 0;
    var done = false;
    foreach step in 0..N while cur != 0 && !done {
        if self.keys[cur - 1] == key {
            if prev == 0 { self.heads[bucket] = self.links[cur - 1]; } else { self.links[prev - 1] = self.links[cur - 1]; }
            self.links[cur - 1] = self.head.free;
            self.head.free = cur;
            self.head.size = self.head.size - 1;
            done = true;
        } else {
            prev = cur;
            cur = self.links[cur - 1];
        }
    }
    return done;
}
// Remove every entry.
pub fn clear(self: write IntMap<N>) {
    self.heads.fill(0, N, 0);
    self.head.size = 0;
    self.head.used = 0;
    self.head.free = 0;
}
