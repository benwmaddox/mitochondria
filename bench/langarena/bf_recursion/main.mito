// LangArena BF::Recursion (kostya/LangArena, MIT): a BF interpreter that parses the program into nested operation lists and executes them by recursion
// (a loop runs its own list while the current cell is not zero). The reference's Vec<Op> with Loop(Vec<Op>) is a list of nodes linked by `next` with a loop's body as
// the head of another list (nodes in arrays: the language has no variable-length nested vectors); parse and execute recurse as in the reference. The tape starts with one cell and grows
// by one when the pointer passes the end. `.` folds the cell into a 64-bit result (result = result * 4 + cell); the checksum adds each run's result as u32. The program text and
// the warmup program (run 1000 times before the timed run) are given to prepare.
struct BF { prog: u8[4096]; proglen: i64; warm: u8[4096]; warmlen: i64; src: u8[4096] unlogged; srclen: i64; pos: i64; op: u8[4096] unlogged; nxt: i32[4096] unlogged; body: i32[4096] unlogged; nops: i64; tape: u8[100000] unlogged; tlen: i64; tpos: i64; result: i64; total: i64; }
state g: BF;

// the reference's parse: the list of operations up to the matching `]` (or the end of the text); returns its first node, -1 for an empty list
fn parse() {
    if g.pos >= g.srclen { return -1; }
    var head = -1;
    var tail = -1;
    var done = 0;
    each step in 0..g.srclen + 1 while done == 0 && g.pos < g.srclen {
        let byte = g.src[g.pos];
        g.pos = g.pos + 1;
        var kind = -1;
        if byte == 45 { kind = 0; } else if byte == 43 { kind = 1; } else if byte == 60 { kind = 2; } else if byte == 62 { kind = 3; }
        else if byte == 46 { kind = 4; } else if byte == 91 { kind = 5; } else if byte == 93 { done = 1; }
        if kind >= 0 {
            let node = g.nops;
            g.nops = g.nops + 1;
            g.op[node] = kind;
            g.nxt[node] = -1;
            g.body[node] = -1;
            if kind == 5 {
                let inner = parse();
                g.body[node] = inner;
            }
            if tail < 0 { head = node; } else { g.nxt[tail] = node; }
            tail = node;
        }
    }
    return head;
}
// the reference's execute: run a list; a loop runs its body while the current cell is not zero
fn execute(head) {
    var node = head;
    each step in 0..g.nops + 1 while node >= 0 {
        let kind = g.op[node];
        if kind == 0 {
            g.tape[g.tpos] = (g.tape[g.tpos] + 255) & 255;
        } else if kind == 1 {
            g.tape[g.tpos] = (g.tape[g.tpos] + 1) & 255;
        } else if kind == 2 {
            if g.tpos > 0 { g.tpos = g.tpos - 1; }
        } else if kind == 3 {
            g.tpos = g.tpos + 1;
            if g.tpos >= g.tlen { g.tape[g.tpos] = 0; g.tlen = g.tpos + 1; }
        } else if kind == 4 {
            g.result = (g.result << 2) + g.tape[g.tpos];
        } else {
            each w in 0..9000000000000 while g.tape[g.tpos] != 0 { execute(g.body[node]); }
        }
        node = g.nxt[node];
    }
}
fn run_program() {
    g.nops = 0;
    g.pos = 0;
    let head = parse();
    g.tape[0] = 0;
    g.tlen = 1;
    g.tpos = 0;
    g.result = 0;
    execute(head);
}

@post("/prepare")
fn prepare(program: string<4096>, warmup: string<4096>) -> Response<{}> {
    g.proglen = len(program);
    each i in 0..g.proglen { g.prog[i] = program[i]; }
    g.warmlen = len(warmup);
    each i in 0..g.warmlen { g.warm[i] = warmup[i]; }
    g.total = 0;
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> {
    g.srclen = g.warmlen;
    each i in 0..g.warmlen { g.src[i] = g.warm[i]; }
    each i in 0..n { run_program(); }
    return ok({});
}
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> {
    g.srclen = g.proglen;
    each i in 0..g.proglen { g.src[i] = g.prog[i]; }
    each i in 0..n {
        run_program();
        g.total = (g.total + (g.result % 4294967296 + 4294967296) % 4294967296) % 4294967296;
    }
    return ok({});
}
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": g.total }); }
