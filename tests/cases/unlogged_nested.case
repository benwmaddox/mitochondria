// `unlogged` on a module instance (`m: intmap<16> unlogged;`) and on a plain struct field holding a collection: everything inside is kept out of
// the undo log, so a request that fails after writing there leaves what it wrote; the logged twins beside them are rolled back
--- program
struct Node { value: i64; }
struct Inner { items: pool<Node, 4>; total: i64; }
struct App { m: intmap<16> unlogged; n: intmap<16>; inner: Inner unlogged; logged: Inner; }
state app: App;

@post("/put/{k}/{fail_after}")
fn put(k: i64, fail_after: bool) -> Response<{}> {
    app.m.put(k, k * 10);
    app.n.put(k, k * 10);
    let a = app.inner.items.add(); a.value = k; app.inner.total += k;
    let b = app.logged.items.add(); b.value = k; app.logged.total += k;
    if fail_after { fail 409 "failed after writing"; }
    return ok({});
}
@get("/look/{k}")
fn look(k: i64) -> Response<{ m: i64, n: i64, inner: i64, inner_total: i64, logged: i64, logged_total: i64 }> {
    return ok({ m: app.m.get_or(k, -1), n: app.n.get_or(k, -1), inner: app.inner.items.count(), inner_total: app.inner.total,
                logged: app.logged.items.count(), logged_total: app.logged.total });
}
--- requests
POST /put/3/false
POST /put/4/true
GET /look/4
GET /look/3
