// expect: `last n` with `by lower(name)`: only an order by one of the row's own fields is compiled
struct Room { name: utf8<16>; } struct App { rooms: table<Room>; } state app: App;
@get("/a") fn a() -> Response<{ ids: [i64] }> { return ok({ ids: [foreach r in app.rooms by lower(name) where r.id > 0 last 2 r.id] }); }
