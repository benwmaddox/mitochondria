// recursive functions, and the limit on how deep calls nest
// (the state is `logged`: this case records what a failed request leaves, so it tests the undo log; state is unlogged by default)
--- program
struct C { n: i64; }
state c: C logged;

fn sum_to(n: i64) -> i64? { var t = 0; if n > 0 { t = n + sum_to(n - 1); } return t; }
fn fib(n: i64) -> i64 { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }
fn even(n: i64) -> bool { if n == 0 { return true; } return odd(n - 1); }
fn odd(n: i64) -> bool { if n == 0 { return false; } return even(n - 1); }
fn count_down(n: i64) { if n > 0 { c.n = c.n + 1; count_down(n - 1); } }
@get("/sum/{n}")
fn get_sum_n(n: i64) -> Response<{ s: i64 }> { return ok({ "s": sum_to(n) }); }
@get("/sum2/{n}")
fn get_sum2_n(n: i64) -> Response<{ s: i64 }> { return ok({ "s": sum_to(n) + fib(5) }); }
@get("/fib/{n}")
fn get_fib_n(n: i64) -> Response<{ f: i64 }> { return ok({ "f": fib(n) }); }
@get("/even/{n}")
fn get_even_n(n: i64) -> Response<{ e: bool }> { return ok({ "e": even(n) }); }
@post("/down/{n}")
fn post_down_n(n: i64) -> Response<{ n: i64 }> { count_down(n); return ok({ "n": c.n }); }
--- requests
GET /sum/0
GET /sum/10
GET /sum/63
GET /sum/64
GET /sum/1000
GET /fib/15
GET /sum2/4
GET /even/7
GET /even/30
POST /down/5
POST /down/100
POST /down/3
