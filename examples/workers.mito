// Eight workers, each with a private region. Mailbox is small and always in use; scratch is the bursty part.
struct Msg { kind: u8; from: u32; body: string<64>; }

struct Worker {
    inbox: list<Msg, 64>;
    scratch: pool<Msg, 20000>;
}

global w0: Worker;
global w1: Worker;
global w2: Worker;
global w3: Worker;
global w4: Worker;
global w5: Worker;
global w6: Worker;
global w7: Worker;
