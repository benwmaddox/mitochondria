// A Campfire-like chat server's hot state. Message history here is a bounded window per room;
// durable history would live in a database.
struct Meta { next_seq: i64; rate: i64; typing_ttl: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Msg { seq: i64; at: i64; author: ref<chat.sessions>; body: string<2000>; }
struct Typing { who: ref<chat.sessions>; until: i64; }
struct Room {
    name: string<48>;
    created: i64;
    messages: list<Msg, 1000> drop_oldest;   // the newest 1000 per room
    typing: pool<Typing, 32>;
}

struct Chat {
    meta: Meta;
    sessions: pool<Session, 2000> checked;
    rooms: sorted<Room, 64, created>;   // kept in order of creation (lib/sorted.mito)
}
state chat: Chat;

fn me() -> ref<chat.sessions> { return auth(chat.sessions); }
fn room_param() -> ref<chat.rooms> { return chat.rooms.get(int(param("room"))); }
fn typing_until(t: i64) -> i64 { return t + max(chat.meta.typing_ttl, 5000); }

@post("/sessions")
fn post_sessions() -> Response<{ token: string, slot: i64 }> {
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let s = chat.sessions.add();
    s.name = name;
    s.secret = random();
    s.window = now();
    return created({ "token": token(s), "slot": slot(s) });
}

@delete("/session")
fn delete_session() -> Response<{ ok: bool }> {
    chat.sessions.remove(me());
    return ok({ "ok": true });
}

@post("/rooms")
fn post_rooms() -> Response<{ id: i64, name: string }> {
    let who = me();
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let r = chat.rooms.add(now());
    r.name = name;
    return created({ "id": slot(r), "name": r.name });
}

@get("/rooms")
fn get_rooms() -> Response<{ rooms: [{ id: i64, name: string }] }> {
    let who = me();
    return ok({ "rooms": [each r in chat.rooms { "id": slot(r), "name": r.name }] });
}

@post("/rooms/{room}/messages")
fn post_rooms_room_messages() -> Response<{ seq: i64 }> {
    let who = me();
    let room = room_param();
    let text = body("body");
    if len(text) == 0 { fail 400 "body is required"; }
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(chat.meta.rate, 30) { fail 429 "slow down"; }
    who.sent = who.sent + 1;
    chat.meta.next_seq = chat.meta.next_seq + 1;
    let m = room.messages.add();
    m.seq = chat.meta.next_seq;
    m.at = t;
    m.author = who;
    m.body = text;
    return created({ "seq": m.seq });
}

@get("/rooms/{room}/messages")
fn get_rooms_room_messages() -> Response<{ room: string, messages: [{ seq: i64, author: string, at: i64, body: string }] }> {
    let who = me();
    let room = room_param();
    let n = min(int(or(query("limit"), "50")), 100);
    return ok({
        "room": room.name,
        "messages": [each m in room.messages reverse limit n {
            "seq": m.seq, "author": or(m.author.name, "[deleted]"), "at": m.at, "body": m.body
        }]
    });
}

@post("/rooms/{room}/typing")
fn post_rooms_room_typing() -> Response<{ ok: bool }> {
    let who = me();
    let room = room_param();
    let t = now();
    var found = false;
    each ty in room.typing {
        if or(ty.who == who, false) { ty.until = typing_until(t); found = true; }
        else if ty.until < t { room.typing.remove(ty); }
    }
    if !found {
        let ty = room.typing.add();
        ty.who = who;
        ty.until = typing_until(t);
    }
    return ok({ "ok": true });
}

@get("/rooms/{room}/typing")
fn get_rooms_room_typing() -> Response<{ typing: [{ name: string }] }> {
    let who = me();
    let room = room_param();
    let t = now();
    return ok({ "typing": [each ty in room.typing where ty.until >= t { "name": or(ty.who.name, "[gone]") }] });
}

@get("/stats")
fn get_stats() -> Response<{ sessions: i64, rooms: i64, messages: i64, next_seq: i64, committed_kb: i64, live_kb: i64, reserved_kb: i64 }> {
    var messages = 0;
    each r in chat.rooms { messages = messages + r.messages.count(); }
    return ok({
        "sessions": chat.sessions.count(), "rooms": chat.rooms.size(), "messages": messages, "next_seq": chat.meta.next_seq,
        "committed_kb": stat("committed_kb"), "live_kb": stat("live_kb"), "reserved_kb": stat("reserved_kb")
    });
}
