// frees happen only when the request succeeds; a slot freed in a request is not reused by it; forward needs a system
--- program
struct T { n: i32; }
struct C { n: i64; }
struct App {
    ts: pool<T, 2>;
    c: C;
}
state app: App;

@post("/t")
fn post_t() -> Response<{ slot: i64 }> { let t = app.ts.add(); t.n = 7; return created({ "slot": slot(t) }); }
@delete("/t/{k}")
fn delete_t_k(k: i64) -> Response<{ n: i64 }> { let t = app.ts[k]; app.ts.remove(t); if k == 0 { fail 409 "changed my mind"; } return ok({ "n": t.n }); }
@post("/swap")
fn post_swap() -> Response<{ got: bool }> { each t in app.ts { app.ts.remove(t); } let u = app.ts.try_add(); return ok({ "got": exists(u) }); }
@get("/count")
fn get_count() -> Response<{ n: i64, c: i64 }> { return ok({ "n": app.ts.count(), "c": app.c.n }); }
@post("/f")
fn post_f() -> Response<none> { app.c.n = 5; forward other[1] { "x": 1 }; }
--- requests
POST /t
POST /t
DELETE /t/0
GET /count
DELETE /t/1
GET /count
POST /t
POST /swap
GET /count
POST /f
GET /count
