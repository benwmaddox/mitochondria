// LangArena Compress::BWTEncode (kostya/LangArena, MIT): Burrows-Wheeler transform of a repeating text, `iterations` times.
// The input is `size` bytes of the repeating pattern "ABRACADABRA". The Burrows-Wheeler transform is the reference's prefix-doubling suffix sort: counting-sort the suffixes by
// first byte, rank them, then for k = 1, 2, 4, ... sort the suffixes by the pair (rank[i], rank[(i + k) % n]) and re-rank. The reference's `sort_by`
// The reference's `sort_by` is a library stable sort that detects runs already in order; here the language's `sort` (a library merge sort that skips the merge of halves already in order) puts
// one 64-bit key per suffix in order (the pair of ranks above the suffix's position in the last round's order, so ties keep the last round's order, as the reference's stable sort keeps them). The keys and the scratch array the sort works in live in state arrays, and the new ranks are written over the old ones. The checksum adds the
// length of the result of every run, warmup included. main_merge.mito keeps the earlier version with a merge sort written in the language (closest-possible, 0.54 s).
struct BW { data: u8[131072]; trans: u8[131072]; sa: i32[131072]; sa2: i32[131072]; rank: i32[131072]; keys: i64[131072]; scratch: i64[131072]; counts: i32[256]; positions: i32[256]; fill: i32[256]; size: i64; orig: i64; result: i64; }
state bw: BW;

fn bwt_transform() {
    let n = bw.size;
    bw.counts.fill(0, 256, 0);
    foreach i in 0..n - 1 { bw.counts[bw.data[i]] = bw.counts[bw.data[i]] + 1; }
    var total = 0;
    foreach i in 0..255 { bw.positions[i] = total; total = total + bw.counts[i]; }
    bw.fill.fill(0, 256, 0);
    foreach i in 0..n - 1 {
        let byte = bw.data[i];
        bw.sa[bw.positions[byte] + bw.fill[byte]] = i;
        bw.fill[byte] = bw.fill[byte] + 1;
    }
    var current_rank = 0;
    var prev_char = bw.data[bw.sa[0]];
    foreach i in 0..n - 1 {
        let index = bw.sa[i];
        if bw.data[index] != prev_char { current_rank = current_rank + 1; prev_char = bw.data[index]; }
        bw.rank[index] = current_rank;
    }
    var k = 1;
    foreach round in 0..63 while k < n {
        // each suffix, taken in the order the last round left them, as one key: its pair of ranks above its position in that order (17 bits each: ranks and positions are below 131072), so
        // sorting the keys sorts by the pair and keeps the last round's order among equal pairs, as the reference's stable sort does
        foreach j in 0..n - 1 {
            let suffix = bw.sa[j];
            bw.keys[j] = (bw.rank[suffix] << 34) | (bw.rank[(suffix + k) % n] << 17) | j;
        }
        bw.keys.sort(0, n, bw.scratch);
        foreach i in 0..n - 1 { bw.sa2[i] = bw.sa[bw.keys[i] & 131071]; }
        bw.rank[bw.sa2[0]] = 0;
        foreach i in 1..n - 1 {
            var step = 1;
            if (bw.keys[i - 1] >> 17) == (bw.keys[i] >> 17) { step = 0; }
            bw.rank[bw.sa2[i]] = bw.rank[bw.sa2[i - 1]] + step;
        }
        bw.sa.copy_from(bw.sa2, 0, 0, n);
        k = k * 2;
    }
    foreach i in 0..n - 1 {
        let suffix = bw.sa[i];
        if suffix == 0 {
            bw.trans[i] = bw.data[n - 1];
            bw.orig = i;
        } else {
            bw.trans[i] = bw.data[suffix - 1];
        }
    }
}
fn make_data(size: i64) {
    foreach i in 0..size - 1 {
        let slot = i % 11;
        var byte = 65;
        if slot == 1 { byte = 66; } else if slot == 2 { byte = 82; } else if slot == 3 { byte = 65; } else if slot == 4 { byte = 67; }
        else if slot == 5 { byte = 65; } else if slot == 6 { byte = 68; } else if slot == 7 { byte = 65; } else if slot == 8 { byte = 66; }
        else if slot == 9 { byte = 82; } else if slot == 10 { byte = 65; }
        bw.data[i] = byte;
    }
}

fn one_run() {
    bwt_transform();
    bw.result = (bw.result + bw.size) % 4294967296;
}
@post("/prepare/{size}")
fn prepare(size: i64 in 2..131072) -> Response<{}> {
    bw.size = size;
    bw.result = 0;
    make_data(size);
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": bw.result }); }
