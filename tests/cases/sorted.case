// lib/sorted.mito: order by key kept as items change, ties in the order added, walks from a key either way,
// string keys, capacity, rollback of a failed request, and many adds and removes in one request
// (the state is `logged`: this case records what a failed request leaves, so it tests the undo log; state is unlogged by default)
--- program
struct Score { name: string<8>; points: i64; }
struct Word { w: string<12>; n: i64; }
struct Fav { s: i64; } // the favourite's slot + 1; 0 for none
struct App {
    board: sorted<Score, 6, points>;
    words: sorted<Word, 8, w>;
    fav: Fav;
}
state app: App logged;

@post("/add")
fn post_add(points: i64, name: string<4096>?) -> Response<{ slot: i64, size: i64 }> { let s = app.board.add(points); s.name = name; return created({ "slot": slot(s), "size": app.board.size() }); }
@post("/set/{k}")
fn post_set_k(k: i64, points: i64) -> Response<{}> { app.board.set_key(app.board.get(k), points); return ok({}); }
@delete("/x/{k}")
fn delete_x_k(k: i64) -> Response<{ size: i64 }> { app.board.remove(app.board.get(k)); return ok({ "size": app.board.size() }); }
@get("/asc")
fn get_asc() -> Response<{ x: [string] }> { return ok({ "x": [foreach s in app.board s.name + ":" + s.points] }); }
@get("/top")
fn get_top(n: i64 = 3) -> Response<{ x: [string] }> { return ok({ "x": [foreach s in app.board reverse limit n s.name] }); }
@get("/from/{k}")
fn get_from_k(k: i64) -> Response<{ up: [string], down: [string] }> { return ok({ "up": [foreach s in app.board from k s.name], "down": [foreach s in app.board from k reverse s.name] }); }
@get("/ends")
fn get_ends() -> Response<{ first: string, last: string, room: i64 }> { return ok({ "first": or(app.board.first().name, "-"), "last": or(app.board.last().name, "-"), "room": app.board.room() }); }
@get("/sum")
fn get_sum() -> Response<{ t: i64 }> { var t = 0; foreach s in app.board where s.points > 0 { t = t + s.points; } return ok({ "t": t }); }
@post("/fav/{k}")
fn post_fav_k(k: i64) -> Response<{}> { app.fav.s = slot(app.board.get(k)) + 1; return ok({}); }
@get("/fav")
fn get_fav() -> Response<{ fav: string }> { return ok({ "fav": or(app.board.get(app.fav.s - 1).name, "-") }); }
@post("/churn/{n}")
fn post_churn_n(n: i64) -> Response<{ size: i64 }> {
    foreach i in 0..n - 1 { let s = app.board.add(i % 4 - 1); s.name = "c"; app.board.remove(s); }
    return ok({ "size": app.board.size() });
}
@post("/words")
fn post_words(w: string<4096>?) -> Response<{}> { let x = app.words.add(w); x.n = len(w); return created({}); }
@get("/words/{from}")
fn get_words_from(from: string<4096>) -> Response<{ all: [string], from: [string], back: [string] }> { return ok({ "all": [foreach x in app.words x.w], "from": [foreach x in app.words from from x.w], "back": [foreach x in app.words from from reverse x.w] }); }
--- requests
GET /asc
GET /ends
GET /from/5
POST /add {"name": "ann", "points": 30}
POST /add {"name": "bob", "points": 10}
POST /add {"name": "cy", "points": 20}
POST /add {"name": "dee", "points": 20}
POST /add {"name": "eve", "points": 10}
GET /asc
GET /top
GET /top?n=10
GET /from/15
GET /from/20
GET /from/0
GET /from/99
GET /ends
GET /sum
POST /add {"name": "much too long a name", "points": 5}
GET /asc
POST /fav/2
POST /set/2 {"points": 5}
GET /asc
GET /fav
POST /set/0 {"points": 20}
GET /asc
DELETE /x/3
GET /asc
POST /add {"name": "fay", "points": 15}
POST /add {"name": "gus", "points": 40}
POST /add {"name": "hal", "points": 1}
