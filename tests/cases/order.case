// each ... order by: ascending and descending, with where and limit, float keys, ties kept in arrival order
--- state
struct Item { score: i64; weight: f64; tag: string<8>; }
struct Box { items: pool<Item, 8>; }
global items: pool<Item, 16>;
global boxes: pool<Box, 2>;
--- api
endpoint POST /items {
    let it = alloc items;
    it.score = int(body("score"));
    it.weight = body("weight");
    it.tag = body("tag");
    respond 201 { "slot": slot(it) };
}
endpoint DELETE /items/{k} { free items[int(param("k"))]; respond 200 {}; }
endpoint GET /asc { respond 200 { "x": [each i in items order by i.score { "s": i.score, "t": i.tag }] }; }
endpoint GET /desc { respond 200 { "x": [each i in items order by i.score desc { "s": i.score, "t": i.tag }] }; }
endpoint GET /top { let n = int(or(query("n"), "3")); respond 200 { "x": [each i in items where i.score > 0 order by i.score desc limit n i.tag] }; }
endpoint GET /weight { respond 200 { "x": [each i in items reverse order by i.weight i.tag] }; }
endpoint GET /sum {
    var total = 0;
    var seen = "";
    each i in items where i.score >= 2 order by i.score desc limit 3 { total = total + i.score; seen = seen + i.tag; }
    respond 200 { "total": total, "seen": seen };
}
endpoint GET /bykey { respond 200 { "x": [each i in items order by i.tag i.score] }; }
endpoint POST /boxes {
    let b = alloc boxes;
    each i in items order by i.score { let c = alloc b.items; c.score = i.score * 10; c.tag = i.tag; }
    respond 201 { "n": count(b.items) };
}
endpoint GET /boxes { respond 200 { "x": [each b in boxes { "items": [each i in b.items order by i.score desc i.score] }] }; }
--- requests
GET /asc
POST /items {"score": 5, "weight": 0.5, "tag": "e"}
POST /items {"score": 2, "weight": 2.25, "tag": "b"}
POST /items {"score": 9, "weight": 1, "tag": "i"}
POST /items {"score": 2, "weight": -1.5, "tag": "b2"}
POST /items {"score": -3, "weight": 0.5, "tag": "neg"}
POST /items {"score": 7, "weight": 0.5, "tag": "g"}
GET /asc
GET /desc
GET /top
GET /top?n=1
GET /top?n=0
GET /top?n=-1
GET /top?n=99
GET /weight
GET /sum
GET /bykey
DELETE /items/2
GET /asc
POST /items {"score": 2, "weight": 3, "tag": "b3"}
GET /asc
GET /desc
POST /boxes
GET /boxes
