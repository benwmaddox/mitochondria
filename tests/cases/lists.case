// list indexing (oldest first, after drop_oldest wraps), lists and pools of plain values, loops whose body allocates
--- program
struct Ev { n: i64; who: string<8>; }
struct Bag { nums: list<i32, 4> drop_oldest; flags: pool<bool, 4>; }
struct App {
    evs: list<Ev, 3> drop_oldest;
    strict: list<Ev, 2>;
    bags: pool<Bag, 2>;
}
state app: App;

endpoint POST /evs { let e = app.evs.add(); e.n = int(body("n")); e.who = body("who"); respond 201 { "count": app.evs.count() }; }
endpoint GET /evs/{k} { let e = app.evs[int(param("k"))]; respond 200 { "n": e.n, "who": e.who }; }
endpoint GET /evs { respond 200 { "x": [each e in app.evs e.n], "r": [each e in app.evs reverse e.n], "first": app.evs[0].n }; }
endpoint POST /strict { let e = app.strict.add(); e.n = app.strict.count(); respond 201 { "n": e.n }; }
endpoint POST /strict/try { let e = app.strict.try_add(); respond 200 { "got": exists(e) }; }
endpoint POST /copy {
    // the loop sees the items there were when it started, not the ones it adds
    each e in app.evs { let f = app.evs.add(); f.n = e.n + 100; f.who = e.who; }
    respond 200 { "x": [each e in app.evs e.n] };
}
endpoint POST /bags { let b = app.bags.add(); let x = b.nums.add(); let y = b.nums.add(); let f = b.flags.add(); respond 201 { "n": b.nums.count(), "f": b.flags.count() }; }
endpoint GET /bags/{k} {
    let b = app.bags[int(param("k"))];
    var sum = 0;
    each v in b.nums { sum = sum + v; }
    respond 200 { "sum": sum, "all": [each v in b.nums v], "rev": [each v in b.nums reverse v], "at1": b.nums[1], "flags": [each f in b.flags f] };
}
endpoint POST /bags/{k}/set { let b = app.bags[int(param("k"))]; b.nums[int(body("i"))] = body("v"); respond 200 { "at": b.nums[int(body("i"))] }; }
endpoint POST /bags/{k}/flag { let b = app.bags[int(param("k"))]; b.flags[0] = body("on"); respond 200 { "flags": [each f in b.flags f] }; }
endpoint POST /evs/{k} { app.evs[int(param("k"))] = 5; respond 200 {}; }
endpoint POST /bags/{k}/grow {
    let b = app.bags[int(param("k"))];
    each v in b.nums { let w = b.nums.add(); }
    respond 200 { "n": b.nums.count() };
}
--- requests
GET /evs
GET /evs/0
POST /evs {"n": 1, "who": "a"}
POST /evs {"n": 2, "who": "b"}
GET /evs/0
GET /evs/1
GET /evs/2
GET /evs/-1
GET /evs/x
POST /evs {"n": 3, "who": "c"}
POST /evs {"n": 4, "who": "d"}
GET /evs
GET /evs/0
GET /evs/2
POST /copy
GET /evs
POST /strict
POST /strict
POST /strict
POST /strict/try
POST /bags
POST /bags/0/set {"i": 0, "v": 5}
POST /bags/0/set {"i": 1, "v": -6}
POST /bags/0/set {"i": 2, "v": 1}
POST /bags/0/set {"i": 1, "v": 3000000000}
POST /bags/0/set {"i": -1, "v": 1}
POST /bags/0/flag {"on": true}
POST /bags/0/flag {"on": 1}
POST /evs/0
GET /bags/0
GET /bags/1
POST /bags/0/grow
GET /bags/0
POST /bags/0/grow
GET /bags/0
