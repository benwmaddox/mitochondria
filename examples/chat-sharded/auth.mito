struct Meta { rate: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Gate {
    meta: Meta;
    sessions: pool<Session, 4000> checked;
}
state gate: Gate;

fn me() -> ref<gate.sessions> { return auth(gate.sessions); }
// "shard.slot": a user id that is unique across auth shards (references do not cross workers)
fn user_id(who) { return str(worker_index()) + "." + str(slot(who)); }
fn rate_limited(who) {
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(gate.meta.rate, 30) { fail 429 "slow down"; }
    who.sent = who.sent + 1;
}

@post("/sessions")
fn post_sessions() -> Response<{ token: string }> {
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let s = gate.sessions.add();
    s.name = name;
    s.secret = random();
    s.window = now();
    return created({ "token": token(s) });
}

@delete("/session")
fn delete_session() -> Response<{ ok: bool }> {
    gate.sessions.remove(me());
    return ok({ "ok": true });
}

// the directory of rooms lives on rooms[0]
@post("/rooms")
fn post_rooms() -> Response<{ id: i64, name: string, shard: i64 }> { let who = me(); forward rooms[0] { "user": user_id(who), "name": who.name }; }
@get("/rooms")
fn get_rooms() -> Response<{ rooms: [{ id: i64, name: string }] }> { let who = me(); forward rooms[0] { "user": user_id(who), "name": who.name }; }

@post("/rooms/{room}/messages")
fn post_rooms_room_messages() -> Response<{ seq: i64 }> {
    let who = me();
    rate_limited(who);
    forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name };
}
@get("/rooms/{room}/messages")
fn get_rooms_room_messages() -> Response<{ room: string, messages: [{ seq: i64, author: string, at: i64, body: string }] }> { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }
@post("/rooms/{room}/typing")
fn post_rooms_room_typing() -> Response<{ ok: bool }> { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }
@get("/rooms/{room}/typing")
fn get_rooms_room_typing() -> Response<{ typing: [{ name: string }] }> { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }

// this shard only: one-way forwarding has no fan-out to total the other workers
@get("/stats")
fn get_stats() -> Response<{ shard: i64, sessions: i64, committed_kb: i64, live_kb: i64 }> {
    return ok({ "shard": worker_index(), "sessions": gate.sessions.count(), "committed_kb": stat("committed_kb"), "live_kb": stat("live_kb") });
}
