@post("/set/{x}/{y}")
fn set(x: i64 in 0..100, y: i64 in 0..100) -> Response<{ x: f64 }> {
    world.pos.x = x;
    world.pos.y = y;
    world.b.z = 1.0;
    return ok({ x: world.pos.x });
}
@post("/big")
fn bigf() -> Response<{ a: f64, b: f64, c: f64, lx: f64, ly: f64, px: f64, py: f64, bx: f64 }> {
    var l = Vec3 { ..world.pos };
    let local = Vec3 { x: 5.0, y: 6.0, z: 7.0 };
    let a = big(l, 1.0);
    let b = big(world.b, 2.0);
    let c = big2(l);
    world.calls += 1;
    return ok({ a: a, b: b, c: c, lx: l.x, ly: l.y, px: world.pos.x, py: world.pos.y, bx: world.b.x + local.z });
}
