struct Vec2 { x: f32; y: f32; }

struct Item {
    id: i32;
    hp: f32;
    pos: Vec2;
    name: string<16>;
    tags: list<i32, 8>;
}

// Same struct, two layouts. Only the type changed.
struct World {
    rows: list<Item, 1000000>;     // one record after another
    cols: table<Item, 1000000>;    // one column per field
}

global world: World;
