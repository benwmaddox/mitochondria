// expect: `G { ... }` is missing `h`: a struct literal gives every field (an array field cannot be given in a literal: start from `Name {}` or `Name { ..base }` and set its elements)
struct G { n: i64; h: i64[2]; } struct W { g: G; } state w: W;
@get("/a") fn a() -> Response<{ n: i64 }> { let c = G { n: 1 }; return ok({ n: c.n }); }
