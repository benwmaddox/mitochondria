fill world.units 1000000
set world.units[0].hp 2.5
sum world.units hp
# free a lot of slots in the middle, the live bit hides them, others do not move
set world.units[999999].name "last"
remove world.units 5
remove world.units 6
get world.units[5].hp
get world.units
push world.units
push world.units
push world.units
get world.units[999999].name
# the accepted hazard: index 7 is reused by a new unit
set world.units[7].hp 11
remove world.units 7
push world.units
get world.units[7].hp
# checked pool: the same mistake is caught
push world.sessions
remove world.sessions 0@0
push world.sessions
get world.sessions[0@0].hp
get world.sessions[0@1].hp
remove world.sessions 0@0
# per-column view: live bits, and sessions' generation column
inspect
