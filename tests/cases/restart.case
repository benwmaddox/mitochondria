// a program with a table: its database opened at start (here a fresh folder per backend), every request one transaction; `restart`
// stops the program and starts it again on the same data: working state starts empty, the tables are kept
--- program
struct Note { text: utf8<100>; }
struct App { notes: table<Note>; hits: i64; }
state app: App;
@post("/hit")
fn hit() -> Response<{ hits: i64 }> { app.hits += 1; return ok({ hits: app.hits }); }
@post("/fail")
fn fail_after() -> Response<{}> { app.hits += 100; fail 409 "rolled back"; }
--- requests
POST /hit
POST /hit
POST /fail
POST /hit
restart
POST /hit
