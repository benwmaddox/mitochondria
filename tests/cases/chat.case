@X-Session: $bob
GET /rooms/1/messages
@X-Session: $ann
POST /rooms/0/typing
@X-Session: $bob
POST /rooms/0/typing
@X-Session: $ann
POST /rooms/0/typing
@X-Session: $bob
GET /rooms/0/typing
clock 7000
@X-Session: $bob
GET /rooms/0/typing
@X-Session: $bob
POST /rooms/0/typing
@X-Session: $ann
GET /rooms/0/typing
@X-Session: $ann
