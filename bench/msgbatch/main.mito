// Message batch filter (a benchmark from a screenshot; the byte format is this repo's own, see README.md): one thread checks, filters and copies a batch of 256
// messages that are already in memory. Each message is an 8-byte header (magic u16 = 0x4D53, version u8 = 1, category u8, frame u16 = whole message size, len u16 = payload size)
// and a payload. Per batch: reject messages whose magic, version or len (len + 8 must equal frame, len <= 120) is wrong, skip valid messages of category 3 or 5, copy the
// rest (header and payload) into the output area, read the copy back for a checksum (the sum of byte ^ (position & 255), plus the copied size << 16), then reset the output length for the next batch.
// The input and the output are separate arrays; state is unlogged by default, so neither is saved for a rollback (the output is scratch the program rebuilds every batch).
struct Batch { input: u8[32800]; output: u8[32768]; in_len: i64 in 0..32768; seed: i64; result: i64; rejected: i64; skipped: i64; copied: i64; }
state b: Batch;

fn rnd(max: i64) -> i64 {
    b.seed = (b.seed * 3877 + 29573) % 139968;
    return b.seed * max / 139968;
}
// build the 256-message batch: slot r = (i * 37 + 11) % 256 decides the kind (r < 24 invalid, r < 88 category 3 or 5, else the other six categories)
fn build() {
    b.seed = 42;
    var off = 0;
    foreach i in 0..255 {
        let r = (i * 37 + 11) % 256;
        let len = 16 + rnd(105);
        var cat = 0;
        var magic = 0x4D53;
        var ver = 1;
        var flen = len;
        if r < 24 {
            cat = rnd(8);
            if r % 3 == 0 { magic = 0x4D54; } else if r % 3 == 1 { ver = 2; } else { flen = len + 1; }
        } else if r < 88 {
            cat = 3 + (r & 1) * 2;
        } else {
            cat = rnd(6);
            if cat >= 3 { cat = cat + 1; }
            if cat >= 5 { cat = cat + 1; }
        }
        b.input[off] = magic & 255;
        b.input[off + 1] = magic >> 8;
        b.input[off + 2] = ver;
        b.input[off + 3] = cat;
        b.input[off + 4] = (len + 8) & 255;
        b.input[off + 5] = (len + 8) >> 8;
        b.input[off + 6] = flen & 255;
        b.input[off + 7] = flen >> 8;
        foreach j in 0..len - 1 { b.input[off + 8 + j] = rnd(256); }
        off = off + 8 + len;
    }
    b.in_len = off;
}
// one batch: filter and copy, then read the copy back
fn process() -> i64 {
    var off = 0;
    var out = 0;
    var rejected = 0;
    var skipped = 0;
    var copied = 0;
    while off < b.in_len {
        let magic = b.input[off] | (b.input[off + 1] << 8);
        let ver = b.input[off + 2];
        let cat = b.input[off + 3];
        let frame = b.input[off + 4] | (b.input[off + 5] << 8);
        let len = b.input[off + 6] | (b.input[off + 7] << 8);
        if magic != 0x4D53 || ver != 1 || len + 8 != frame || len > 120 {
            rejected = rejected + 1;
        } else if cat == 3 || cat == 5 {
            skipped = skipped + 1;
        } else {
            b.output.copy_from(b.input, off, out, frame);
            out = out + frame;
            copied = copied + 1;
        }
        off = off + frame;
    }
    var h = 0;
    foreach i in 0..out - 1 { h = (h + (b.output[i] ^ (i & 255))) & 0xFFFFFFFF; }
    h = (h + (out << 16)) & 0xFFFFFFFF;
    b.rejected = rejected;
    b.skipped = skipped;
    b.copied = copied;
    return h;
}
fn one_run() { b.result = (b.result * 31 + process()) & 0xFFFFFFFF; }

@post("/prepare")
fn prepare() -> Response<{}> { build(); b.result = 0; return ok({}); }
@post("/warmup/{n}")
fn warmup(n: i64 in 0..10000000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..10000000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64, rejected: i64, skipped: i64, copied: i64 }> { return ok({ "checksum": b.result, "rejected": b.rejected, "skipped": b.skipped, "copied": b.copied }); }
