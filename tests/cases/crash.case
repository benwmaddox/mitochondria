// a worker that crashes is rebuilt from its declarations (its state is lost) and keeps answering
--- system
system {
    worker w { program "w.mito"; count 1; mailbox 64; slot 4096; }
    entry w;
    inflight 4;
    budget 1024;
}

--- file w.mito
struct C { n: i64; }
state c: C;

endpoint POST /inc { c.n = c.n + 1; respond 200 { "n": c.n }; }
endpoint POST /crash { c.n = 99; __crash(); }
--- requests
POST /inc
POST /inc
stats
POST /crash
POST /inc
stats
