    var r0_0 = -1;
    var r0_1 = -1;
    var r0_2 = -1;
    var r0_3 = -1;
    var r1_0 = -1;
    var r1_1 = -1;
    var r1_2 = -1;
    var r1_3 = -1;
    var r2_0 = -1;
    var r2_1 = -1;
    var r2_2 = -1;
    var r2_3 = -1;
    r0_0 = p;
    while i < len(s) {
        let c = byte_at(s, i);
        match st {
            0 => {
                match c {
                    65..90, 95, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r1_1 = i + 1;
                        st = 1;
                    }
                    else => { break; }
                }
            }
            1 => {
                match c {
                    48..57, 65..90, 95, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r1_1 = i + 1;
                        st = 1;
                    }
                    61 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_3 = r1_3;
                        let n2_0 = r1_0;
                        let n2_1 = r1_1;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_3 = n0_3;
                        r2_0 = n2_0;
                        r2_1 = n2_1;
                        r0_2 = i + 1;
                        r1_2 = i + 1;
                        r2_2 = i + 1;
                        r2_3 = i + 1;
                        st = 2;
                    }
                    else => { break; }
                }
            }
            2 => {
                match c {
                    34 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        st = 3;
                    }
                    48..57, 65..90, 95, 97..122 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_2 = r1_2;
                        let n0_3 = r1_3;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_2 = n0_2;
                        r0_3 = n0_3;
                        r1_3 = i + 1;
                        st = 4;
                    }
                    else => { break; }
                }
            }
            3 => {
                match c {
                    0..33, 35..255 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        st = 3;
                    }
                    34 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_2 = r1_2;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_2 = n0_2;
                        r0_3 = i + 1;
                        st = 5;
                    }
                    else => { break; }
                }
            }
            4 => {
                match c {
                    48..57, 65..90, 95, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = i + 1;
                        st = 4;
                    }
                    else => { break; }
                }
            }
            else => { break; }
        }
        i += 1;
        if st == 2 {
            xend = i;
            x0 = r2_0;
            x1 = r2_1;
            x2 = r2_2;
            x3 = r2_3;
        }
        if st == 4 {
            xend = i;
            x0 = r1_0;
            x1 = r1_1;
            x2 = r1_2;
            x3 = r1_3;
        }
        if st == 5 {
            xend = i;
            x0 = r0_0;
            x1 = r0_1;
            x2 = r0_2;
            x3 = r0_3;
        }
    }
    if xend < 0 { return false; }
    m.lo[0] = p;
    m.hi[0] = xend;
    m.lo[1] = x0;
    m.hi[1] = x1;
    m.lo[2] = x2;
    m.hi[2] = x3;
    return true;
}
// pair_search(s, from, m): the first match at or after byte `from`, with its groups in m; false if there is none
fn pair_search(s: text, from: i64, m: write pair_m) -> bool {
    var p = from;
    while p <= len(s) {
        if pair_match(s, p, m) { return true; }
        p += 1;
    }
    return false;
}

// ---- mail: ([a-z0-9._-]+)@([a-z0-9-]+(?:\.[a-z0-9-]+)+)
// mail_at(s, p): where the match starting at byte p ends (the pattern's first choice, greedy), or -1   (6 states)
fn mail_at(s: text, p: i64) -> i64 {
    var st = 0;
    var i = p;
    var last = -1;
    while i < len(s) {
        let c = byte_at(s, i);
        match st {
            0 => {
                match c {
                    45..46, 48..57, 95, 97..122 => { st = 1; }
                    else => { break; }
                }
            }
            1 => {
                match c {
                    45..46, 48..57, 95, 97..122 => { st = 1; }
                    64 => { st = 2; }
                    else => { break; }
                }
            }
            2 => {
                match c {
                    45, 48..57, 97..122 => { st = 3; }
                    else => { break; }
                }
            }
            3 => {
                match c {
                    45, 48..57, 97..122 => { st = 3; }
                    46 => { st = 4; }
                    else => { break; }
                }
            }
            4 => {
                match c {
                    45, 48..57, 97..122 => { st = 5; }
                    else => { break; }
                }
            }
            5 => {
                match c {
                    46 => { st = 4; }
                    45, 48..57, 97..122 => { st = 5; }
                    else => { break; }
                }
            }
            else => { break; }
        }
        i += 1;
        if st == 5 { last = i; }
    }
    return last;
}
// mail_full(s): the whole text is one match   (6 states)
fn mail_full(s: text) -> bool {
    var st = 0;
    var i = 0;
    while i < len(s) {
        let c = byte_at(s, i);
        match st {
            0 => {
                match c {
                    45..46, 48..57, 95, 97..122 => { st = 1; }
                    else => { return false; }
                }
            }
            1 => {
                match c {
                    45..46, 48..57, 95, 97..122 => { st = 1; }
                    64 => { st = 2; }
                    else => { return false; }
                }
            }
            2 => {
                match c {
                    45, 48..57, 97..122 => { st = 3; }
                    else => { return false; }
                }
            }
            3 => {
                match c {
                    45, 48..57, 97..122 => { st = 3; }
                    46 => { st = 4; }
                    else => { return false; }
                }
            }
            4 => {
                match c {
                    45, 48..57, 97..122 => { st = 5; }
                    else => { return false; }
                }
            }
            5 => {
                match c {
                    46 => { st = 4; }
                    45, 48..57, 97..122 => { st = 5; }
                    else => { return false; }
                }
            }
            else => { return false; }
        }
        i += 1;
    }
    return st == 5;
}
// mail_find(s, from): where the first match at or after byte `from` starts, or -1; its end is mail_at(s, start)
fn mail_find(s: text, from: i64) -> i64 {
    var p = from;
    while p <= len(s) {
        if mail_at(s, p) >= 0 { return p; }
        p += 1;
    }
    return -1;
}
struct mail_m { lo: i64[3]; hi: i64[3]; }
// mail_match(s, p, m): the match starting at byte p, as mail_at, with its groups: m.lo[g]..m.hi[g] for group g (0 is the whole match, -1 a group that took no part). True when there is a match.   (6 states, 12 registers)
fn mail_match(s: text, p: i64, m: write mail_m) -> bool {
    var st = 0;
    var i = p;
    var xend = -1;
    var x0 = -1;
    var x1 = -1;
    var x2 = -1;
    var x3 = -1;
    var r0_0 = -1;
    var r0_1 = -1;
    var r0_2 = -1;
    var r0_3 = -1;
    var r1_0 = -1;
    var r1_1 = -1;
    var r1_2 = -1;
    var r1_3 = -1;
    var r2_0 = -1;
    var r2_1 = -1;
    var r2_2 = -1;
    var r2_3 = -1;
    r0_0 = p;
    while i < len(s) {
        let c = byte_at(s, i);
        match st {
            0 => {
                match c {
                    45..46, 48..57, 95, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r1_1 = i + 1;
                        st = 1;
                    }
                    else => { break; }
                }
            }
            1 => {
                match c {
                    45..46, 48..57, 95, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r1_1 = i + 1;
                        st = 1;
                    }
                    64 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_3 = r1_3;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_3 = n0_3;
                        r0_2 = i + 1;
                        st = 2;
                    }
                    else => { break; }
                }
            }
            2 => {
                match c {
                    45, 48..57, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        st = 3;
                    }
                    else => { break; }
                }
            }
            3 => {
                match c {
                    45, 48..57, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        st = 3;
                    }
                    46 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_2 = r1_2;
                        let n0_3 = r1_3;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_2 = n0_2;
                        r0_3 = n0_3;
                        st = 4;
                    }
                    else => { break; }
                }
            }
            4 => {
                match c {
                    45, 48..57, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        let n2_0 = r0_0;
                        let n2_1 = r0_1;
                        let n2_2 = r0_2;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r2_0 = n2_0;
                        r2_1 = n2_1;
                        r2_2 = n2_2;
                        r2_3 = i + 1;
                        st = 5;
                    }
                    else => { break; }
                }
            }
            5 => {
                match c {
                    46 => {
                        let n0_0 = r1_0;
                        let n0_1 = r1_1;
                        let n0_2 = r1_2;
                        let n0_3 = r1_3;
                        r0_0 = n0_0;
                        r0_1 = n0_1;
                        r0_2 = n0_2;
                        r0_3 = n0_3;
                        st = 4;
                    }
                    45, 48..57, 97..122 => {
                        let n1_0 = r0_0;
                        let n1_1 = r0_1;
                        let n1_2 = r0_2;
                        let n1_3 = r0_3;
                        let n2_0 = r0_0;
                        let n2_1 = r0_1;
                        let n2_2 = r0_2;
                        r1_0 = n1_0;
                        r1_1 = n1_1;
                        r1_2 = n1_2;
                        r1_3 = n1_3;
                        r2_0 = n2_0;
                        r2_1 = n2_1;
                        r2_2 = n2_2;
                        r2_3 = i + 1;
                        st = 5;
                    }
                    else => { break; }
                }
            }
            else => { break; }
        }
        i += 1;
        if st == 5 {
            xend = i;
            x0 = r2_0;
            x1 = r2_1;
            x2 = r2_2;
            x3 = r2_3;
        }
    }
    if xend < 0 { return false; }
    m.lo[0] = p;
    m.hi[0] = xend;
    m.lo[1] = x0;
    m.hi[1] = x1;
    m.lo[2] = x2;
    m.hi[2] = x3;
    return true;
}
// mail_search(s, from, m): the first match at or after byte `from`, with its groups in m; false if there is none
fn mail_search(s: text, from: i64, m: write mail_m) -> bool {
    var p = from;
    while p <= len(s) {
        if mail_match(s, p, m) { return true; }
        p += 1;
    }
    return false;
}
