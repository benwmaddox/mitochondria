// A Campfire-like chat server's hot state. Message history here is a bounded recent-message cache;
// durable history would live in a database.
struct Meta { next_seq: i64; rate: i64; typing_ttl: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Room { name: string<48>; created: i64; }
struct Msg { room: i32; author: i32; seq: i64; at: i64; author_name: string<32>; body: string<2000>; }
struct Typing { room: i32; who: i32; until: i64; name: string<32>; }

global meta: Meta;
global sessions: pool<Session, 2000> checked;
global rooms: pool<Room, 64>;
global messages: pool<Msg, 20000>;
global typing: pool<Typing, 2000>;
