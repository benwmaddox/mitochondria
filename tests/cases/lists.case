GET /evs
POST /strict
POST /strict
POST /strict
POST /strict/try
POST /bags
POST /bags/0/set {"i": 0, "v": 5}
POST /bags/0/set {"i": 1, "v": -6}
POST /bags/0/set {"i": 2, "v": 1}
POST /bags/0/set {"i": 1, "v": 3000000000}
POST /bags/0/set {"i": -1, "v": 1}
POST /bags/0/flag {"on": true}
POST /bags/0/flag {"on": 1}
