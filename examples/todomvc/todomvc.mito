// TodoMVC (todomvc.com/app-spec) in Mitochondria, rendered on the server: every page is HTML from here, every change a form post
// answered with a redirect back to the page it came from. Each browser has its own list, as the reference apps do with local
// storage: its first todo makes the list, and a cookie names it. The lists are tables, kept in SQLite (`--data dir`) across restarts.
// Pages and forms work without script; assets/app.js adds what the spec asks of a browser (a ticked checkbox submits, double-click
// edits, Escape cancels). See docs/todomvc.md.

struct Todo { title: utf8<1000>; done: bool; }
// a browser's list, and its todos (a table of the rows each list owns, in the order they were added)
struct Board { secret: i64; todos: table<Todo>; }
struct App { boards: table<Board>; }
state app: App;

// ---- pages: all todos, the active ones, the completed ones (show 0, 1, 2); `?edit=<id>` shows one as a text field

@get("/")
fn all(board: Board? from cookie("todos"), edit: i64 = -1) -> Response<html> {
    return ok(<!doctype html><html lang="en">{document(board, 0, edit);}</html>);
}
@get("/active")
fn active(board: Board? from cookie("todos"), edit: i64 = -1) -> Response<html> {
    return ok(<!doctype html><html lang="en">{document(board, 1, edit);}</html>);
}
@get("/completed")
fn completed(board: Board? from cookie("todos"), edit: i64 = -1) -> Response<html> {
    return ok(<!doctype html><html lang="en">{document(board, 2, edit);}</html>);
}

fn document(b: Board?, show: i64, edit: i64) -> html {
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Mitochondria • TodoMVC</title>
        <link rel="stylesheet" href="/todomvc.css">
        <script src="/app.js" defer></script>
    </head>
    <body>
        <section class="todoapp">
            <header class="header">
                <h1>todos</h1>
                <form method="post" action="/todos">
                    {back(show);}
                    <input class="new-todo" name="title" placeholder="What needs to be done?" autofocus autocomplete="off">
                </form>
            </header>
            {if exists(b) { lists(b, show, edit); }}
        </section>
        <footer class="info">
            <p>Double-click to edit a todo</p>
            <p>Written in Mitochondria</p>
            <p>Part of <a href="https://todomvc.com">TodoMVC</a></p>
        </footer>
    </body>
}

// the list and its footer, when there are todos
fn lists(b: Board, show: i64, edit: i64) -> html {
    let total = b.todos.count();
    var left = 0;
    foreach t in b.todos where !t.done { left += 1; }
    if total > 0 {
        <section class="main">
            <form method="post" action="/toggle-all">
                {back(show);}
                <input id="toggle-all" class="toggle-all" type="checkbox" checked={left == 0}>
                <label for="toggle-all">Mark all as complete</label>
                <noscript><button>Mark all</button></noscript>
            </form>
            <ul class="todo-list">
                {foreach t in b.todos {
                    if show == 0 || (show == 1 && !t.done) || (show == 2 && t.done) { item(t, slot(t), show, slot(t) == edit); }
                }}
            </ul>
        </section>
        <footer class="footer">
            <span class="todo-count"><strong>{left}</strong> {if left == 1 { "item" } else { "items" }} left</span>
            <ul class="filters">
                <li><a class="{if show == 0 { "selected" }}" href="/">All</a></li>
                <li><a class="{if show == 1 { "selected" }}" href="/active">Active</a></li>
                <li><a class="{if show == 2 { "selected" }}" href="/completed">Completed</a></li>
            </ul>
            {if total > left {
                <form method="post" action="/clear-completed">{back(show);}<button class="clear-completed">Clear completed</button></form>
            }}
        </footer>
    }
}

fn item(t: Todo, id: i64, show: i64, editing: bool) -> html {
    <li class="{if t.done { "completed" }}{if editing { " editing" }}">
        <div class="view">
            <form id="toggle-{id}" method="post" action="/todos/{id}/toggle">
                {back(show);}
                <noscript><button>Done</button></noscript>
            </form>
            <!-- the stylesheet draws the circle on the label right after the checkbox, so the checkbox joins its form by id -->
            <input class="toggle" type="checkbox" form="toggle-{id}" checked={t.done}>
            <label>{t.title}</label>
            <noscript><a href="?edit={id}">Edit</a></noscript>
            <form method="post" action="/todos/{id}/delete">{back(show);}<button class="destroy" aria-label="Delete"></button></form>
        </div>
        <form method="post" action="/todos/{id}/edit">
            {back(show);}
            <input class="edit" name="title" value="{t.title}" autofocus={editing}>
        </form>
    </li>
}

// where a form's redirect goes: the page it is on
fn back(show: i64) -> html {
    <input type="hidden" name="back" value="{if show == 1 { "/active" } else if show == 2 { "/completed" } else { "/" }}">
}

// ---- changes: each answers 303 back to the page (`back`, a path on this server, checked)

// a new todo; a browser's first makes its list (and the cookie that names it)
@post("/todos")
fn add(board: Board? from cookie("todos"), title: utf8<1000>, back: ascii<16> = "/") -> Response<html> {
    let text = trim(title);
    if len(text) == 0 { return see_other(back); }
    if exists(board) { let t = board.todos.add(); t.title = text; return see_other(back); }
    let made = app.boards.add();
    made.secret = random();
    set_cookie("todos", token(made), 31536000);
    let t = made.todos.add();
    t.title = text;
    return see_other(back);
}
@post("/todos/{id}/toggle")
fn toggle(board: Board from cookie("todos"), id: i64, back: ascii<16> = "/") -> Response<html> {
    let t = board.todos[id];
    t.done = !t.done;
    return see_other(back);
}
// an edit that leaves the title empty removes the todo
@post("/todos/{id}/edit")
fn rename(board: Board from cookie("todos"), id: i64, title: utf8<1000>, back: ascii<16> = "/") -> Response<html> {
    let t = board.todos[id];
    let text = trim(title);
    if len(text) == 0 { board.todos.remove(t); } else { t.title = text; }
    return see_other(back);
}
@post("/todos/{id}/delete")
fn destroy(board: Board from cookie("todos"), id: i64, back: ascii<16> = "/") -> Response<html> {
    board.todos.remove(board.todos[id]);
    return see_other(back);
}
// all complete, or, when all already are, all active again
@post("/toggle-all")
fn toggle_all(board: Board from cookie("todos"), back: ascii<16> = "/") -> Response<html> {
    var all_done = true;
    foreach t in board.todos { if !t.done { all_done = false; } }
    foreach t in board.todos { t.done = !all_done; }
    return see_other(back);
}
@post("/clear-completed")
fn clear_completed(board: Board from cookie("todos"), back: ascii<16> = "/") -> Response<html> {
    foreach t in board.todos where t.done { board.todos.remove(t); }
    return see_other(back);
}

// ---- the stylesheet (todomvc-app-css 2.4.3, CC-BY-4.0, Sindre Sorhus) and the script

@get("/todomvc.css")
fn css() -> Response<css> { return ok(file("assets/todomvc.css")); }
@get("/app.js")
fn js() -> Response<js> { return ok(file("assets/app.js")); }
