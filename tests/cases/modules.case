// a module instance (lib/bag.mito): its functions, its state read from outside, and references to its items
--- state
struct Score { name: string<16>; points: i64; }
struct Fav { s: ref<scores>; }
global scores: bag<Score, 3>;
global others: bag<Score, 2>;
global fav: Fav;
--- api
endpoint POST /scores {
    let s = scores.add();
    s.name = body("name");
    s.points = int(body("points"));
    respond 201 { "slot": slot(s), "size": scores.size(), "room": scores.room() };
}
endpoint GET /scores/{k} { let s = scores.get(int(param("k"))); respond 200 { "name": s.name, "points": s.points }; }
endpoint DELETE /scores/{k} { scores.remove(scores.get(int(param("k")))); respond 200 { "size": scores.size() }; }
endpoint POST /fav/{k} { fav.s = scores.get(int(param("k"))); respond 200 {}; }
endpoint GET /fav { respond 200 { "fav": or(fav.s.name, "-") }; }
endpoint GET /stats {
    respond 200 {
        "added": scores.added(), "removed": scores.removed(), "count": count(scores.items),
        "others": others.size(), "names": [each s in scores.items s.name]
    };
}
endpoint GET /walk {
    var total = 0;
    each s in scores where s.points > 15 { total = total + s.points; }
    respond 200 {
        "all": [each s in scores s.name], "back": [each s in scores reverse s.name], "from1": [each s in scores from 1 s.name],
        "back_from1": [each s in scores from 1 reverse s.name], "first": [each s in scores limit 1 s.name], "total": total
    };
}
endpoint POST /others { let o = others.add(); o.points = 1; respond 201 { "size": others.size() }; }
--- requests
GET /walk
GET /stats
POST /scores {"name": "ann", "points": 10}
POST /scores {"name": "bob", "points": 20}
POST /scores {"name": "cy", "points": 30}
POST /scores {"name": "dee", "points": 40}
POST /scores {"name": "a name that is too long", "points": 1}
GET /scores/1
GET /scores/7
POST /fav/1
GET /fav
DELETE /scores/1
GET /fav
GET /scores/1
POST /scores {"name": "eve", "points": 50}
GET /fav
GET /stats
GET /walk
POST /others
POST /others
POST /others
GET /stats
