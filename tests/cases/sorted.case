// lib/sorted.mito: order by key kept as items change, ties in the order added, walks from a key either way,
// string keys, capacity, rollback of a failed request, and many adds and removes in one request
--- state
struct Score { name: string<8>; points: i64; }
struct Word { w: string<12>; n: i64; }
struct Fav { s: ref<board>; }
global board: sorted<Score, 6, points>;
global words: sorted<Word, 8, w>;
global fav: Fav;
--- api
endpoint POST /add { let s = board.add(int(body("points"))); s.name = body("name"); respond 201 { "slot": slot(s), "size": board.size() }; }
endpoint POST /set/{k} { board.set_key(board.get(int(param("k"))), int(body("points"))); respond 200 {}; }
endpoint DELETE /x/{k} { board.remove(board.get(int(param("k")))); respond 200 { "size": board.size() }; }
endpoint GET /asc { respond 200 { "x": [each s in board s.name + ":" + s.points] }; }
endpoint GET /top { let n = int(or(query("n"), "3")); respond 200 { "x": [each s in board reverse limit n s.name] }; }
endpoint GET /from/{k} { let k = int(param("k")); respond 200 { "up": [each s in board from k s.name], "down": [each s in board from k reverse s.name] }; }
endpoint GET /ends { respond 200 { "first": or(board.first().name, "-"), "last": or(board.last().name, "-"), "room": board.room() }; }
endpoint GET /sum { var t = 0; each s in board where s.points > 0 { t = t + s.points; } respond 200 { "t": t }; }
endpoint POST /fav/{k} { fav.s = board.get(int(param("k"))); respond 200 {}; }
endpoint GET /fav { respond 200 { "fav": or(fav.s.name, "-") }; }
endpoint POST /churn/{n} {
    each i in 0..int(param("n")) { let s = board.add(i % 4 - 1); s.name = "c"; board.remove(s); }
    respond 200 { "size": board.size() };
}
endpoint POST /words { let x = words.add(body("w")); x.n = len(body("w")); respond 201 {}; }
endpoint GET /words/{from} { respond 200 { "all": [each x in words x.w], "from": [each x in words from param("from") x.w], "back": [each x in words from param("from") reverse x.w] }; }
--- requests
GET /asc
GET /ends
GET /from/5
