// A bag of up to N items of struct T: added and removed only through its functions, which count what they did.
// The smallest module: it exists to exercise the module mechanism (parameters, instance state, `self`, refs).
module bag<T: struct, N: count>
struct Counts { added: i64; removed: i64; }
// what an instance holds
state {
    items: pool<T, N> checked;
    counts: Counts;
}

pub fn add() {
    let it = self.items.add();
    self.counts.added = self.counts.added + 1;
    return it;
}
pub fn remove(it) {
    self.items.remove(it);
    self.counts.removed = self.counts.removed + 1;
}
pub fn size() { return self.items.count(); }
pub fn room() { return N - self.items.count(); }
pub fn get(k) { return self.items[k]; }
pub fn added() { return self.counts.added; }
pub fn removed() { return self.counts.removed; }
// iteration (each s in bag [from slot] [reverse] ...): slot order; a cursor is a slot number
fn iter_first(from) { each i in or(from, 0)..N where exists(self.items[i]) limit 1 { return i; } return null; }
fn iter_next(cur) { each i in cur + 1..N where exists(self.items[i]) limit 1 { return i; } return null; }
fn iter_last(from) { each i in 0..or(from, N - 1) + 1 reverse where exists(self.items[i]) limit 1 { return i; } return null; }
fn iter_prev(cur) { each i in 0..cur reverse where exists(self.items[i]) limit 1 { return i; } return null; }
fn iter_item(cur) { return self.items[cur]; }
