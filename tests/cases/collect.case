// loops that collect their items before running the body: a body that allocates does not see what it adds, and a
// where whose body changes what it tests sees the items as they were; also a function that returns from inside
// such a loop, called many times
--- program
struct Item { score: i64; tag: string<8>; }
struct Box { items: pool<Item, 8>; }
struct App {
    items: pool<Item, 16>;
    boxes: pool<Box, 2>;
}
state app: App;

fn first_positive() { each i in app.items where i.score > 0 { i.score = i.score; return i.tag; } return "-"; }
endpoint POST /items { let it = app.items.add(); it.score = int(body("score")); it.tag = body("tag"); respond 201 { "slot": slot(it) }; }
endpoint POST /double { each i in app.items { let c = app.items.add(); c.score = i.score * 2; c.tag = i.tag + "2"; } respond 200 { "n": app.items.count() }; }
endpoint POST /zero { var n = 0; each i in app.items where i.score > 0 { each j in app.items { j.score = 0; } n = n + 1; } respond 200 { "visited": n }; }
endpoint POST /boxes {
    let b = app.boxes.add();
    each i in app.items where i.score != 0 limit 3 { let c = b.items.add(); c.score = i.score * 10; c.tag = i.tag; }
    respond 201 { "n": b.items.count(), "scores": [each c in b.items c.score] };
}
endpoint GET /firsts {
    var n = 0;
    each a in app.items { each b in app.items { if first_positive() != "-" { n = n + 1; } } }
    respond 200 { "calls": n, "first": first_positive() };
}
endpoint GET /list { respond 200 { "x": [each i in app.items i.tag + ":" + i.score] }; }
--- requests
POST /items {"score": 3, "tag": "a"}
POST /items {"score": 0, "tag": "b"}
POST /items {"score": 5, "tag": "c"}
GET /firsts
POST /double
GET /list
POST /boxes
POST /double
POST /zero
GET /list
GET /firsts
