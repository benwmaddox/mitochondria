// forwards reach the shard for their key, in order, each answered once; a failing forward target answers for itself
--- system
system {
    worker front { program "front.mito"; count 2; mailbox 64; slot 4096; }
    worker count { program "count.mito"; count 3; mailbox 64; slot 4096; }
    entry front;
    inflight 16;
    budget 1024;
}

--- file front.mito
struct M { n: i64; }
state m: M;

@post("/inc/{k}")
fn post_inc_k() -> Response<{ shard: i64, n: i64, from: i64, seen: i64 }> { m.n = m.n + 1; forward count[int(param("k"))] { "from": worker_index(), "seen": m.n }; }
@post("/bad")
fn post_bad() -> Response<none> { forward nowhere[0] { "x": 1 }; }
@post("/odd/{k}")
fn post_odd_k() -> Response<none> { forward count[int(param("k"))] {}; }
@get("/front")
fn get_front() -> Response<{ n: i64, me: i64, of: i64 }> { return ok({ "n": m.n, "me": worker_index(), "of": worker_count() }); }
--- file count.mito
struct C { n: i64; }
state c: C;

@post("/inc/{k}")
fn post_inc_k_2() -> Response<{ shard: i64, n: i64, from: i64, seen: i64 }> { c.n = c.n + 1; return ok({ "shard": worker_index(), "n": c.n, "from": int(fwd("from")), "seen": int(fwd("seen")) }); }
@post("/odd/{k}")
fn post_odd_k_2() -> Response<none> { fail 409 "the shard said no"; }
--- requests
*4 POST /inc/0
*2 POST /inc/1
POST /inc/2
POST /inc/3
POST /inc/4
POST /inc/5
POST /inc/-1
POST /inc/x
POST /bad
POST /odd/1
GET /front
GET /front
stats
