// behaviours first checked by the Rust runtime's own tests, kept here when it was removed: structs holding only
// collections stay distinct; a failed request rolls back every write; a freed slot is reused lowest first; a pool of
// 100000 items with nested lists commits only the headers of items in use (see the memory line)
// (the state is `logged`: this case records what a failed request leaves, so it tests the undo log; state is unlogged by default)
--- program
struct M { n: i32; }
struct W { s: pool<M, 4>; }
struct T { a: i64; b: i64; name: string<16>; }
struct R { m: list<M, 8>; }
struct App {
    w0: W;
    w1: W;
    t: T;
    ms: pool<M, 4>;
    rs: pool<R, 100000>;
}
state app: App logged;

@post("/w1")
fn post_w1() -> Response<{ slot: i64 }> { let m = app.w1.s.add(); m.n = 1; return created({ "slot": slot(m) }); }
@get("/w")
fn get_w() -> Response<{ w0: i64, w1: i64 }> { return ok({ "w0": app.w0.s.count(), "w1": app.w1.s.count() }); }
@post("/t")
fn post_t(fail: string<4096>?) -> Response<{ a: i64 }> { app.t.a = 1; app.t.b = 2; app.t.name = "changed"; let m = app.ms.add(); m.n = 9; if fail == "yes" { fail 409 "rolled back"; } return ok({ "a": app.t.a }); }
@get("/t")
fn get_t() -> Response<{ a: i64, b: i64, name: string, ms: i64 }> { return ok({ "a": app.t.a, "b": app.t.b, "name": app.t.name, "ms": app.ms.count() }); }
@post("/ms")
fn post_ms(n: i64) -> Response<{ slot: i64 }> { let m = app.ms.add(); m.n = n; return created({ "slot": slot(m) }); }
@delete("/ms/{k}")
fn delete_ms_k(k: i64) -> Response<{}> { app.ms.remove(app.ms[k]); return ok({}); }
@get("/scope")
fn get_scope() -> Response<{ x: i64, t: i64 }> { let x = 1; var sum = 0; if true { let x = 10; sum = sum + x; } return ok({ "x": x, "t": sum }); }
@post("/rs")
fn post_rs() -> Response<{ slot: i64, m: i64 }> { let r = app.rs.add(); let m = r.m.add(); m.n = 1; return created({ "slot": slot(r), "m": r.m.count() }); }
--- requests
POST /w1
GET /w
POST /t {"fail": "yes"}
GET /t
POST /t {"fail": "no"}
GET /t
POST /ms {"n": 1}
POST /ms {"n": 2}
POST /ms {"n": 3}
DELETE /ms/1
DELETE /ms/0
POST /ms {"n": 4}
POST /ms {"n": 5}
POST /rs
GET /scope
