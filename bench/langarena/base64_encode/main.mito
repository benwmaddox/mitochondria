// LangArena Base64::Encode (kostya/LangArena, MIT): encode `size` bytes of "a" to standard Base64 (with padding), `iterations` times; the checksum adds the encoded length
// of every run (warmup included) and the benchmark's final message names the first four characters of the data and of the encoded text. This port builds that message
// in a request field and answers its hash (GET /checksum), as the reference does. The reference calls the base64-simd library (SIMD); this calls the language's `base64`
// builtin, which uses AVX2 where the CPU has it (runtime/mito.c). main_loop.mito keeps the earlier version that is a plain scalar loop written in the language.
struct B64 { data: u8[500000]; size: i64 in 0..500000; encoded_len: i64; result: i64; head: ascii<8>; }
state b: B64;
struct Work { message: ascii<128>; }
request work: Work; // the final message, built to be hashed

fn encode() {
    let encoded = base64(text_from(b.data, 0, b.size));
    b.encoded_len = len(encoded);
    b.head = substr(encoded, 0, 4);
}
fn one_run() {
    encode();
    b.result = (b.result + b.encoded_len) % 4294967296;
}

@post("/prepare/{size}")
fn prepare(size: i64 in 4..500000) -> Response<{}> {
    b.size = size;
    b.result = 0;
    b.data.fill(0, size, 97);
    encode();
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
// the reference's message, "encode aaaa... to YWFh...: <sum>", and its hash
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> {
    work.message = "encode " + text_from(b.data, 0, 4) + "... to " + b.head + "...: " + b.result;
    var hash = 5381;
    foreach i in 0..len(work.message) - 1 { hash = (hash * 33 + work.message[i]) % 4294967296; }
    return ok({ checksum: hash });
}
