// values whose kind is only known at run time, used where an integer (or a number) is required
--- program
struct T { n: i64; }
struct App {
    ts: pool<T, 4>;
    top: Top;
}
state app: App;
struct Top { r: ref<app.ts>; }

@post("/t")
fn post_t() -> Response<{}> { let t = app.ts.add(); t.n = slot(t) * 10; return created({}); }
@get("/index")
fn get_index() -> Response<{ n: i64 }> { return ok({ "n": app.ts[body("k")].n }); }
@get("/limit")
fn get_limit() -> Response<{ x: [i64] }> { return ok({ "x": [each t in app.ts limit body("n") t.n] }); }
@get("/minmax")
fn get_minmax() -> Response<{ min: i64, max: i64 }> { return ok({ "min": min(body("a"), 5), "max": max(3, body("a")) }); }
@get("/neg")
fn get_neg() -> Response<{ neg: any }> { return ok({ "neg": -body("x") }); }
@get("/arith")
fn get_arith() -> Response<{ sum: any, lt: any }> { return ok({ "sum": body("x") + 1, "lt": body("x") < 2 }); }
@post("/set")
fn post_set() -> Response<{ n: i64 }> { let t = app.ts[0]; t.n = body("x"); return ok({ "n": t.n }); }
@get("/ornotlive")
fn get_ornotlive() -> Response<{ a: i64, b: bool, c: i64 }> { return ok({ "a": or(app.ts[3].n, -1), "b": exists(app.ts[9]), "c": or(app.ts[int(body("k"))].n, 0) }); }
fn pool_of() { return app.ts; }
fn find(k) { if k < 0 { return app.ts[99]; } if k == 0 { return app.ts[0]; } return find(k - 1); }
@get("/anyitem")
fn get_anyitem() -> Response<{ n: any, slot: i64 }> {
    var x = 5;
    if body("k") != null { x = app.ts[int(body("k"))]; }
    return ok({ "n": x.n, "slot": slot(x) });
}
@post("/anyitem")
fn post_anyitem() -> Response<{ n: any }> { var x = 5; x = app.ts[int(body("k"))]; x.n = 77; return ok({ "n": x.n }); }
@delete("/anyitem")
fn delete_anyitem() -> Response<{ count: i64 }> { var x = "s"; x = app.ts[int(body("k"))]; app.ts.remove(x); return ok({ "count": app.ts.count() }); }
@get("/coll")
fn get_coll() -> Response<{ n: i64, x: [i64] }> { return ok({ "n": pool_of().count(), "x": [each t in pool_of() t.n] }); }
@get("/recor")
fn get_recor() -> Response<{ a: i64 }> { return ok({ "a": or(find(int(body("k"))).n, -1) }); }
@get("/slotnull")
fn get_slotnull() -> Response<{ s: i64 }> { return ok({ "s": slot(app.top.r) }); }
@get("/divmin")
fn get_divmin() -> Response<{ d: i64 }> { return ok({ "d": (0 - 9223372036854775807 - 1) / int(body("d")) }); }
@get("/modmin")
fn get_modmin() -> Response<{ m: i64 }> { return ok({ "m": (0 - 9223372036854775807 - 1) % int(body("d")) }); }
@post("/setstr")
fn post_setstr() -> Response<{}> { let t = app.ts[0]; t.n = "text"; return ok({}); }
@get("/min_int")
fn get_min_int() -> Response<{ neg: i64 }> { return ok({ "neg": -(0 - 9223372036854775807 - 1) }); }
--- requests
// the Rust runtime builds the text of a "not live" error before or() discards it
*3 POST /t
GET /index {"k": 1}
GET /index {"k": "1"}
GET /index {"k": 1.5}
GET /index {}
GET /limit {"n": 2}
GET /limit {"n": -1}
GET /limit {"n": "2"}
GET /minmax {"a": 1}
GET /minmax {"a": 9}
GET /minmax {"a": "x"}
GET /neg {"x": 4}
GET /neg {"x": 2.5}
GET /neg {"x": "s"}
GET /neg {}
GET /arith {"x": 1}
GET /arith {"x": 1.5}
GET /arith {"x": "a"}
POST /set {"x": 7}
POST /set {"x": 7.5}
POST /set {"x": true}
GET /min_int
GET /divmin {"d": -1}
GET /divmin {"d": 2}
GET /modmin {"d": -1}
POST /setstr
GET /ornotlive {"k": 9}
GET /ornotlive {"k": 1}
GET /anyitem {"k": 1}
GET /anyitem {}
GET /anyitem {"k": 3}
POST /anyitem {"k": 2}
DELETE /anyitem {"k": 2}
GET /coll
GET /recor {"k": 3}
GET /recor {"k": -1}
GET /slotnull
