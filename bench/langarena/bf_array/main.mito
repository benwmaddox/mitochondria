// LangArena BF::Array (kostya/LangArena, MIT): a BF interpreter. Each run compiles the program text (keeps the eight command bytes, matches the brackets into a
// jump table) and interprets it on a tape of 30,000 cells that grows if the pointer passes the end; `.` folds the cell into a 32-bit result (result = result * 4 + cell). The
// program text and the warmup program (a small program run 1000 times before the timed run) are given to prepare; the checksum adds each run's result. The reference's
// commands are an enum of their bytes, and its match on them a `match`. The reference's u32 and u8 wrapping is masking.
enum Cmd: u8 { Inc = 43, Dec = 45, Right = 62, Left = 60, Open = 91, Close = 93, Out = 46, In = 44 }
struct BF { prog: u8[4096]; proglen: i64; warm: u8[4096]; warmlen: i64; src: u8[4096] unlogged; srclen: i64; cmds: Cmd[4096] unlogged; ncmds: i64; jumps: i32[4096] unlogged; stack: i32[4096] unlogged; tape: u8[100000] unlogged; tlen: i64; out: i64; bad: i64; ok: i64; result: i64; }
state g: BF;

fn compile() {
    g.ncmds = 0;
    foreach i in 0..g.srclen - 1 {
        let c = g.src[i];
        match c { Cmd.Inc, Cmd.Dec, Cmd.Right, Cmd.Left, Cmd.Open, Cmd.Close, Cmd.Out, Cmd.In => { g.cmds[g.ncmds] = c; g.ncmds = g.ncmds + 1; } else => { } }
    }
    var ok = 1;
    if g.ncmds == 0 { ok = 0; }
    var sp = 0;
    foreach i in 0..g.ncmds - 1 {
        let cmd = g.cmds[i];
        if cmd == Cmd.Open {
            g.stack[sp] = i;
            sp = sp + 1;
        } else if cmd == Cmd.Close {
            if sp == 0 {
                ok = 0;
            } else {
                sp = sp - 1;
                let start = g.stack[sp];
                g.jumps[start] = i;
                g.jumps[i] = start;
            }
        }
    }
    if sp != 0 { ok = 0; }
    g.ok = ok;
}
fn execute() {
    g.tape.fill(0, 30000, 0);
    g.tlen = 30000;
    var pos = 0;
    var pc = 0;
    var result = 0;
    var bad = 0;
    while pc < g.ncmds {
        match g.cmds[pc] {
            Cmd.Inc => { g.tape[pos] = (g.tape[pos] + 1) & 255; }
            Cmd.Dec => { g.tape[pos] = (g.tape[pos] + 255) & 255; }
            Cmd.Right => {
                pos = pos + 1;
                if pos >= g.tlen { g.tape[pos] = 0; g.tlen = g.tlen + 1; }
            }
            Cmd.Left => { if pos > 0 { pos = pos - 1; } }
            Cmd.Open => { if g.tape[pos] == 0 { pc = g.jumps[pc]; } }
            Cmd.Close => { if g.tape[pos] != 0 { pc = g.jumps[pc]; } }
            Cmd.Out => { result = (((result << 2) & 0xFFFFFFFF) + g.tape[pos]) & 0xFFFFFFFF; }
            Cmd.In => { bad = 1; break; }
        }
        pc = pc + 1;
    }
    g.out = result;
    g.bad = bad;
}
// the reference's run_program: compile, and run if it compiled
fn run_program() {
    g.bad = 1;
    compile();
    if g.ok == 1 { execute(); }
}

@post("/prepare")
fn prepare(program: string<4096>, warmup: string<4096>) -> Response<{}> {
    g.proglen = len(program);
    foreach i in 0..g.proglen - 1 { g.prog[i] = program[i]; }
    g.warmlen = len(warmup);
    foreach i in 0..g.warmlen - 1 { g.warm[i] = warmup[i]; }
    g.result = 0;
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> {
    g.srclen = g.warmlen;
    foreach i in 0..g.warmlen - 1 { g.src[i] = g.warm[i]; }
    foreach i in 0..n - 1 { run_program(); }
    return ok({});
}
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> {
    g.srclen = g.proglen;
    foreach i in 0..g.proglen - 1 { g.src[i] = g.prog[i]; }
    foreach i in 0..n - 1 {
        run_program();
        if g.bad == 0 { g.result = (g.result + g.out) % 4294967296; }
    }
    return ok({});
}
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": g.result }); }
