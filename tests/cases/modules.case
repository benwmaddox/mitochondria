// a module instance (lib/bag.mito): its functions, its state read from outside, and references to its items
--- program
struct Score { name: string<16>; points: i64; }
struct Fav { s: ref<app.scores>; }
struct App {
    scores: bag<Score, 3>;
    others: bag<Score, 2>;
    fav: Fav;
}
state app: App;

@post("/scores")
fn post_scores(points: i64, name: string<4096>?) -> Response<{ slot: i64, size: i64, room: i64 }> {
    let s = app.scores.add();
    s.name = name;
    s.points = points;
    return created({ "slot": slot(s), "size": app.scores.size(), "room": app.scores.room() });
}
@get("/scores/{k}")
fn get_scores_k(k: i64) -> Response<{ name: string, points: i64 }> { let s = app.scores.get(k); return ok({ "name": s.name, "points": s.points }); }
@delete("/scores/{k}")
fn delete_scores_k(k: i64) -> Response<{ size: i64 }> { app.scores.remove(app.scores.get(k)); return ok({ "size": app.scores.size() }); }
@post("/fav/{k}")
fn post_fav_k(k: i64) -> Response<{}> { app.fav.s = app.scores.get(k); return ok({}); }
@get("/fav")
fn get_fav() -> Response<{ fav: string }> { return ok({ "fav": or(app.fav.s.name, "-") }); }
@get("/stats")
fn get_stats() -> Response<{ added: i64, removed: i64, count: i64, others: i64, names: [string] }> {
    return ok({
        "added": app.scores.added(), "removed": app.scores.removed(), "count": app.scores.items.count(),
        "others": app.others.size(), "names": [each s in app.scores.items s.name]
    });
}
@get("/walk")
fn get_walk() -> Response<{ all: [string], back: [string], from1: [string], back_from1: [string], first: [string], total: i64 }> {
    var total = 0;
    each s in app.scores where s.points > 15 { total = total + s.points; }
    return ok({
        "all": [each s in app.scores s.name], "back": [each s in app.scores reverse s.name], "from1": [each s in app.scores from 1 s.name],
        "back_from1": [each s in app.scores from 1 reverse s.name], "first": [each s in app.scores limit 1 s.name], "total": total
    });
}
@post("/others")
fn post_others() -> Response<{ size: i64 }> { let o = app.others.add(); o.points = 1; return created({ "size": app.others.size() }); }
--- requests
GET /walk
GET /stats
POST /scores {"name": "ann", "points": 10}
POST /scores {"name": "bob", "points": 20}
POST /scores {"name": "cy", "points": 30}
POST /scores {"name": "dee", "points": 40}
POST /scores {"name": "a name that is too long", "points": 1}
GET /scores/1
GET /scores/7
POST /fav/1
GET /fav
DELETE /scores/1
GET /fav
GET /scores/1
POST /scores {"name": "eve", "points": 50}
GET /fav
GET /stats
GET /walk
POST /others
POST /others
POST /others
GET /stats
