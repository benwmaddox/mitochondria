// LangArena Etc::Words (kostya/LangArena, MIT): count the words of a text (split on whitespace) in a hash map, then take the most frequent word; the checksum adds, per run, its count,
// the hash of the word (hash = hash * 33 + byte from 5381) and the number of distinct words, warmup runs included. The text (50,000 random lowercase words of 3 to 8 letters,
// from the reference's generator and random sequence, 325 KB) is generated by the benchmark harness and given to prepare, which keeps it in a string; each run copies it into the request's
// text area and cuts words out of it with substr (no copy). The reference's HashMap<&str, u32> is lib/strmap.mito. The most frequent word is tracked as the counts rise (a word becomes the
// leader when its count passes the leader's): the reference takes the maximum over the finished map, and for the run parameters the maximum is unique, so both choose the same word.
struct Words { text: string<400000>; map: strmap<32768>; result: i64; }
state w: Words;

fn one_run() {
    w.map.clear();
    let text = w.text;
    let size = len(text);
    var at = 0;
    var best_count = 0;
    var best_start = 0;
    var best_len = 0;
    foreach step in 0..size while at < size {
        // skip whitespace, then take the run of non-whitespace
        var code = text[at];
        if code == 32 || code == 10 || code == 9 || code == 13 {
            at = at + 1;
        } else {
            let start = at;
            foreach scan in 0..size while at < size && text[at] != 32 && text[at] != 10 && text[at] != 9 && text[at] != 13 { at = at + 1; }
            let seen = w.map.add_to(substr(text, start, at - start), 1);
            if seen > best_count { best_count = seen; best_start = start; best_len = at - start; }
        }
    }
    var hash = 5381;
    foreach index in 0..best_len - 1 { hash = (hash * 33 + text[best_start + index]) % 4294967296; }
    w.result = (w.result + best_count + hash + w.map.size()) % 4294967296;
}

@post("/prepare")
fn prepare(text: string<400000>) -> Response<{}> {
    w.text = text;
    w.result = 0;
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": w.result }); }
