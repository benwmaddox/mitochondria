// values whose kind changes: a var holding a reference, a var given another kind, functions returning different kinds
--- program
struct Node { name: string<8>; next: ref<app.nodes>; }
struct App {
    nodes: pool<Node, 4> checked;
    top: Top;
}
state app: App;
struct Top { head: ref<app.nodes>; }

fn find(name) { each n in app.nodes { if n.name == name { return n; } } return null; }
fn describe(k) { if k == 0 { return "zero"; } if k < 0 { return null; } return k; }
endpoint POST /nodes {
    let n = app.nodes.add();
    n.name = body("name");
    n.next = app.top.head;
    app.top.head = n;
    respond 201 { "slot": slot(n) };
}
endpoint DELETE /nodes/{name} { let n = find(param("name")); if n == null { fail 404 "no such node"; } app.nodes.remove(n); respond 200 {}; }
endpoint GET /walk {
    var cur = app.top.head;
    var names = "";
    var steps = 0;
    each n in app.nodes {
        if exists(cur) { names = names + cur.name + ","; cur = cur.next; steps = steps + 1; }
    }
    respond 200 { "names": names, "steps": steps };
}
endpoint GET /find/{name} { let n = find(param("name")); respond 200 { "found": exists(n), "name": or(n.name, "-") }; }
endpoint GET /describe/{k} { respond 200 { "d": describe(int(param("k"))) }; }
endpoint GET /mixed/{k} {
    var v = 1;
    if int(param("k")) > 5 { v = "big"; }
    if int(param("k")) > 9 { v = null; }
    respond 200 { "v": v };
}
--- requests
GET /walk
POST /nodes {"name": "a"}
POST /nodes {"name": "b"}
POST /nodes {"name": "c"}
GET /walk
GET /find/b
GET /find/z
DELETE /nodes/b
GET /walk
GET /find/b
DELETE /nodes/zz
GET /describe/0
GET /describe/-4
GET /describe/12
GET /mixed/1
GET /mixed/7
GET /mixed/11
