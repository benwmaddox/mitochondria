// LangArena Graph::AStar (kostya/LangArena, MIT): A* search from vertex 0 to the last vertex with the heuristic target - v, using a binary min-heap ordered by (f score, vertex), as the reference's BinaryHeap<Reverse<Node>>.
// The reference's graph: 500,000 vertices, each an object with its own list of neighbours (a pool of vertices, each with a list; capacity 48 per
// vertex, the largest degree the reference's generator makes for the run parameters is 47), built by the reference's generator (a path through all
// vertices, then a random number of random jumps from each, undirected). The graph is built once, in prepare. The checksum adds the path length
// of every run, warmup runs included, modulo 2^32.
struct Edge { to: i32; }
struct Vertex { adj: list<Edge, 48>; }
struct G { vs: pool<Vertex, 500000>; gs: i32[500000]; bf: i32[500000]; hf: i32[65536]; hv: i32[65536]; hn: i64; cur_f: i64; cur_v: i64; vertices: i64; last: i64; result: i64; }
state g: G;

fn next_int(max: i64) -> i64 {
    g.last = (g.last * 3877 + 29573) % 139968;
    return int(g.last / 139968.0 * max);
}
// the reference's add_edge: both directions, only inside the graph
fn add_edge(u: i64, v: i64) {
    if u >= 0 && u < g.vertices && v >= 0 && v < g.vertices {
        let a = g.vs[u];
        a.adj.add { to: v };
        let b = g.vs[v];
        b.adj.add { to: u };
    }
}

// the heap holds (f, vertex); smaller f first, then smaller vertex (the reference's Node ordering). Any correct heap pops the same sequence: every
// (f, vertex) pair is pushed at most once (a vertex is pushed again only with a smaller f).
fn heap_push(f: i64, v: i64) {
    var i = g.hn;
    g.hn = g.hn + 1;
    var going = 1;
    foreach w in 0..63 while going == 1 && i > 0 {
        let p = (i - 1) / 2;
        if f < g.hf[p] || (f == g.hf[p] && v < g.hv[p]) {
            g.hf[i] = g.hf[p];
            g.hv[i] = g.hv[p];
            i = p;
        } else {
            going = 0;
        }
    }
    g.hf[i] = f;
    g.hv[i] = v;
}
fn heap_pop() {
    g.cur_f = g.hf[0];
    g.cur_v = g.hv[0];
    g.hn = g.hn - 1;
    let n = g.hn;
    if n > 0 {
        let f = g.hf[n];
        let v = g.hv[n];
        var i = 0;
        var going = 1;
        foreach w in 0..63 while going == 1 {
            var c = 2 * i + 1;
            if c >= n {
                going = 0;
            } else {
                if c + 1 < n && (g.hf[c + 1] < g.hf[c] || (g.hf[c + 1] == g.hf[c] && g.hv[c + 1] < g.hv[c])) { c = c + 1; }
                if g.hf[c] < f || (g.hf[c] == f && g.hv[c] < v) {
                    g.hf[i] = g.hf[c];
                    g.hv[i] = g.hv[c];
                    i = c;
                } else {
                    going = 0;
                }
            }
        }
        g.hf[i] = f;
        g.hv[i] = v;
    }
}
fn one_run() {
    let target = g.vertices - 1;
    g.gs.fill(0, g.vertices, 2147483647);
    g.bf.fill(0, g.vertices, 2147483647);
    g.gs[0] = 0;
    g.bf[0] = target;
    g.hn = 0;
    heap_push(target, 0);
    var found = -1;
    while g.hn > 0 && found < 0 {
        heap_pop();
        let current = g.cur_v;
        if current == target {
            found = g.gs[current];
        } else {
            let vertex = g.vs[current];
            foreach nb in vertex.adj {
                let tentative = g.gs[current] + 1;
                if tentative < g.gs[nb.to] {
                    g.gs[nb.to] = tentative;
                    let f_new = tentative + (target - nb.to);
                    if f_new < g.bf[nb.to] {
                        g.bf[nb.to] = f_new;
                        heap_push(f_new, nb.to);
                    }
                }
            }
        }
    }
    g.result = (g.result + (found + 4294967296) % 4294967296) % 4294967296;
}

@post("/prepare/{vertices}/{jumps}/{jump_len}")
fn prepare(vertices: i64 in 2..500000, jumps: i64 in 1..1000, jump_len: i64 in 1..100000) -> Response<{}> {
    g.vs.clear();
    g.vertices = vertices;
    g.last = 42;
    g.result = 0;
    foreach i in 0..vertices - 1 { g.vs.add(); }
    // generate_random: a path, then random jumps, in the reference's order and with its random generator
    foreach i in 1..vertices - 1 { add_edge(i, i - 1); }
    foreach v in 0..vertices - 1 {
        let num_jumps = next_int(jumps);
        foreach j in 0..num_jumps - 1 {
            let offset = next_int(jump_len) - jump_len / 2;
            let u = v + offset;
            if u >= 0 && u < vertices && u != v { add_edge(v, u); }
        }
    }
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": g.result }); }
