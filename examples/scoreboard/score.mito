// A game scoreboard: players, each player's best score kept in order, and the last 20 games played.
// (The tutorial, docs/tutorial.md, builds this program step by step.)
struct Player { name: string<24>; best: i64; entry: i64; } // entry: its slot in game.board
struct Entry  { who: i64; points: i64; }                 // who: the player's slot
struct Played { who: i64; points: i64; at: i64; }
struct Row    { name: string<24>; points: i64; }

struct Game {
    games: i64;
    players: pool<Player, 1000> checked;
    board: sorted<Entry, 1000, points>;   // one entry per player, in order of points (lib/sorted.mito)
    recent: list<Played, 20> drop_oldest; // the last 20 games; the 21st overwrites the oldest
}
state game: Game logged; // logged: `record` below fails after writing, and the failure undoes it (see the tutorial)

@post("/players")
fn add_player(name: string<1..24>) -> Response<{ id: Player }> {
    let p = game.players.add { name: name };
    let e = game.board.add(0) { who: slot(p) };
    p.entry = slot(e);
    return created({ id: p });
}

@post("/players/{p}/games")
fn record(p: Player, points: i64) -> Response<{ best: i64 }> {
    game.games += 1;
    game.recent.add { who: slot(p), points: points, at: now() };
    if points > p.best { p.best = points; game.board.set_key(game.board.get(p.entry), points); }
    // checked last on purpose: everything above is undone when this fails
    if points > 1000000 { fail 422 "not a believable score"; }
    return ok({ best: p.best });
}

@get("/board")
fn board(top: i64 in 1..100 = 10) -> Response<{ top: [Row] }> {
    return ok({ top: [foreach e in game.board reverse limit top { name: game.players[e.who].name, points: e.points }] });
}

@get("/recent")
fn recent() -> Response<{ games: [Row] }> {
    return ok({ games: [foreach g in game.recent reverse { name: or(game.players[g.who].name, "[left]"), points: g.points }] });
}

@delete("/players/{p}")
fn remove_player(p: Player) -> Response<null> {
    game.board.remove(game.board.get(p.entry));
    game.players.remove(p);
    return no_content();
}

@get("/stats")
fn stats() -> Response<{ players: i64, games: i64, reserved_kb: i64, committed_kb: i64, live_kb: i64 }> {
    return ok({
        players: game.players.count(), games: game.games,
        reserved_kb: stat("reserved_kb"), committed_kb: stat("committed_kb"), live_kb: stat("live_kb")
    });
}

// ---- tests (`mito test score.mito`): each starts from an empty game
test "a player's best score is the highest they played" {
    let r = post("/players", { name: "ann" });
    if r.status != 201 { return "adding a player: " + str(r.status) + " " + r.body; }
    let games = "/players/" + field(r.body, "id") + "/games";
    post(games, { points: 40 });
    post(games, { points: 25 });
    let g = post(games, { points: 70 });
    if field(g.body, "best") != "70" { return "best after 40, 25, 70: " + g.body; }
    return game.games == 3;
}
test "the board lists the best first" {
    let a = post("/players", { name: "ann" });
    let b = post("/players", { name: "bo" });
    post("/players/" + field(a.body, "id") + "/games", { points: 10 });
    post("/players/" + field(b.body, "id") + "/games", { points: 90 });
    let board = get("/board?top=2");
    if board.body != "{\"top\":[{\"name\":\"bo\",\"points\":90},{\"name\":\"ann\",\"points\":10}]}" { return "board: " + board.body; }
    return true;
}
test "an unbelievable score changes nothing" {
    let r = post("/players", { name: "ann" });
    let g = post("/players/" + field(r.body, "id") + "/games", { points: 2000000 });
    if g.status != 422 { return "expected 422, got " + str(g.status); }
    return game.games == 0 && game.recent.count() == 0;
}
test "a full pool answers 503" {
    foreach i in 1..game.players.capacity() { post("/players", { name: "p" + str(i) }); }
    let r = post("/players", { name: "one more" });
    if r.status != 503 { return "expected 503, got " + str(r.status); }
    return game.players.count() == game.players.capacity();
}
test "a removed player's games show as [left]" {
    let r = post("/players", { name: "ann" });
    let id = field(r.body, "id");
    post("/players/" + id + "/games", { points: 5 });
    let d = delete("/players/" + id);
    if d.status != 204 { return "remove: " + str(d.status); }
    return get("/recent").body == "{\"games\":[{\"name\":\"[left]\",\"points\":5}]}";
}
