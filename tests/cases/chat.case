@X-Session: $ann
POST /rooms/0/messages {"body":"m6 é"}
@X-Session: $bob
POST /rooms/0/messages {"body":"m7 é"}
@X-Session: $ann
POST /rooms/0/messages {}
@X-Session: $ann
POST /rooms/0/messages {"body":""}
@X-Session: $ann
POST /rooms/9/messages {"body":"x"}
@X-Session: $bob
GET /rooms/0/messages
