// struct fields inside items: read, written, nested two deep, and in plain state
--- program
struct Pos { x: i64; y: i64; }
struct Box { lo: Pos; hi: Pos; }
struct Unit { name: string<8>; at: Pos; area: Box; }
struct World { origin: Pos; size: i64; }
struct App {
    world: World;
    units: pool<Unit, 3>;
}
state app: App;

fn width(u: Unit) -> i64 { return u.area.hi.x - u.area.lo.x; }
@post("/units")
fn post_units(x: i64, y: i64, name: string<4096>?) -> Response<{ slot: i64, w: i64 }> {
    let u = app.units.add();
    u.name = name;
    u.at.x = x;
    u.at.y = y;
    u.area.lo.x = u.at.x - 1;
    u.area.hi.x = u.at.x + 1;
    return created({ "slot": slot(u), "w": width(u) });
}
@post("/units/{k}/move")
fn post_units_k_move(k: i64, dx: i64, dy: i64) -> Response<{ x: i64, y: i64 }> {
    let u = app.units[k];
    u.at.x = u.at.x + dx;
    u.at.y = u.at.y + dy;
    return ok({ "x": u.at.x, "y": u.at.y });
}
@post("/world")
fn post_world(x: i64, y: i64) -> Response<{ x: i64 }> { app.world.origin.x = x; app.world.origin.y = y; app.world.size = 3; return ok({ "x": app.world.origin.x }); }
@get("/units")
fn get_units() -> Response<{ o: i64, x: [{ name: string, x: i64, y: i64, w: i64 }] }> {
    return ok({ "o": app.world.origin.x + app.world.origin.y, "x": [foreach u in app.units where u.at.x >= app.world.origin.x { "name": u.name, "x": u.at.x, "y": u.at.y, "w": width(u) }] });
}
--- requests
GET /units
POST /units {"name": "a", "x": 1, "y": 2}
POST /units {"name": "b", "x": 10, "y": -4}
POST /units/1/move {"dx": -3, "dy": 1}
POST /units/7/move {"dx": 1, "dy": 1}
POST /world {"x": 5, "y": 1}
GET /units
