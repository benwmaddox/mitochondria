fn me() -> ref<sessions> { return auth(sessions); }
// "shard.slot": a user id that is unique across auth shards (references do not cross workers)
fn user_id(who) { return str(worker_index()) + "." + str(slot(who)); }
fn rate_limited(who) {
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(meta.rate, 30) { fail 429 "slow down"; }
    who.sent = who.sent + 1;
}

endpoint POST /sessions {
    let name = body("name");
    if len(name) == 0 { fail 400 "name is required"; }
    let s = alloc sessions;
    s.name = name;
    s.secret = random();
    s.window = now();
    respond 201 { "token": token(s) };
}

endpoint DELETE /session {
    free me();
    respond 200 { "ok": true };
}

// the directory of rooms lives on rooms[0]
endpoint POST /rooms { let who = me(); forward rooms[0] { "user": user_id(who), "name": who.name }; }
endpoint GET /rooms { let who = me(); forward rooms[0] { "user": user_id(who), "name": who.name }; }

endpoint POST /rooms/{room}/messages {
    let who = me();
    rate_limited(who);
    forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name };
}
endpoint GET /rooms/{room}/messages { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }
endpoint POST /rooms/{room}/typing { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }
endpoint GET /rooms/{room}/typing { let who = me(); forward rooms[int(param("room"))] { "user": user_id(who), "name": who.name }; }

// this shard only: one-way forwarding has no fan-out to total the other workers
endpoint GET /stats {
    respond 200 { "shard": worker_index(), "sessions": count(sessions), "committed_kb": stat("committed_kb"), "live_kb": stat("live_kb") };
}
