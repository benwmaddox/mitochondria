struct Meta { next_room: i64; next_seq: i64; typing_ttl: i64; }
struct Dir { id: i64; name: string<48>; }
// authors are kept by value: a reference cannot point into another worker
struct Msg { seq: i64; at: i64; user: string<16>; author: string<32>; body: string<2000>; }
struct Typing { user: string<16>; name: string<32>; until: i64; }
struct Room {
    id: i64;
    name: string<48>;
    created: i64;
    messages: list<Msg, 1000> drop_oldest;
    typing: pool<Typing, 256>;
}
struct Shard {
    meta: Meta;
    directory: sorted<Dir, 256, id>;   // in order of id; used on rooms[0] only
    rooms: pool<Room, 32>;   // the rooms this shard owns
}
state shard: Shard;

fn find_room(id: i64) -> Room {
    foreach r in shard.rooms where r.id == id limit 1 { return r; }
    fail 404 "no such room";
}
fn typing_until(t: i64) -> i64 { return t + max(shard.meta.typing_ttl, 5000); }

// Every request arrives from an auth shard, which checked the session and forwarded who sent it.
// rooms[0] assigns the id and records the room in the directory, then forwards to the owning shard (id % count).
@post("/rooms")
fn add_room(name: string<1..48>, forwarded user: string<16>, forwarded author: string<32>, forwarded id: i64 = 0) -> Response<{ id: i64, name: string, shard: i64 }> {
    if id == 0 {
        shard.meta.next_room += 1;
        let d = shard.directory.add(shard.meta.next_room) { name: name };
        forward rooms[d.id] { user: user, author: author, id: d.id };
    }
    let r = shard.rooms.add { id: id, name: name, created: now() };
    return created({ id: r.id, name: r.name, shard: worker_index() });
}

@get("/rooms")
fn rooms(forwarded user: string<16>, forwarded author: string<32>) -> Response<{ rooms: [{ id: i64, name: string }] }> {
    return ok({ rooms: [foreach d in shard.directory { id: d.id, name: d.name }] });
}

@post("/rooms/{room}/messages")
fn post_message(room: i64, body: string<1..2000>, forwarded user: string<16>, forwarded author: string<32>) -> Response<{ seq: i64 }> {
    let r = find_room(room);
    shard.meta.next_seq += 1;
    let m = r.messages.add { seq: shard.meta.next_seq, at: now(), user: user, author: author, body: body };
    return created({ seq: m.seq });
}

@get("/rooms/{room}/messages")
fn messages(room: i64, limit: i64 = 50, forwarded user: string<16>, forwarded author: string<32>) -> Response<{ room: string, messages: [{ seq: i64, author: string, at: i64, body: string }] }> {
    let r = find_room(room);
    return ok({
        room: r.name,
        messages: [foreach m in r.messages reverse limit min(limit, 100) { seq: m.seq, author: m.author, at: m.at, body: m.body }]
    });
}

@post("/rooms/{room}/typing")
fn typing(room: i64, forwarded user: string<16>, forwarded author: string<32>) -> Response<{ ok: bool }> {
    let r = find_room(room);
    let t = now();
    var found = false;
    foreach ty in r.typing {
        if ty.user == user { ty.until = typing_until(t); found = true; }
        else if ty.until < t { r.typing.remove(ty); }
    }
    if !found { r.typing.add { user: user, name: author, until: typing_until(t) }; }
    return ok({ ok: true });
}

@get("/rooms/{room}/typing")
fn who_is_typing(room: i64, forwarded user: string<16>, forwarded author: string<32>) -> Response<{ typing: [{ name: string }] }> {
    let r = find_room(room);
    let t = now();
    return ok({ typing: [foreach ty in r.typing where ty.until >= t { name: ty.name }] });
}
