// bit operators on 64-bit integers: & | ^ << >>, hex literals, Rust's precedence (comparisons bind looser than the bit operators), shift counts
// checked, and two real uses: a CRC-32 and a 32-bit rotate
--- program
struct T { table: i64[4]; digits: u8[9]; }
state t: T;

@post("/setup")
fn post_setup() -> Response<{}> {
    each i in 0..4 { t.table[i] = 100 + i; }
    each i in 0..9 { t.digits[i] = 49 + i; }
    return ok({});
}
@get("/ops/{a}/{b}")
fn get_ops(a: i64, b: i64) -> Response<{ and: i64, or: i64, xor: i64 }> { return ok({ "and": a & b, "or": a | b, "xor": a ^ b }); }
@get("/shift/{x}/{n}")
fn get_shift(x: i64, n: i64) -> Response<{ left: i64, right: i64 }> { return ok({ "left": x << n, "right": x >> n }); }
@get("/hex")
fn get_hex() -> Response<{ a: i64, b: i64, c: i64 }> { return ok({ "a": 0xFF, "b": 0xEDB88320, "c": 0x7FFFFFFFFFFFFFFF }); }
@get("/prec")
fn get_prec() -> Response<{ shift: i64, mixed: i64, chain: i64, cmp: bool, sum: i64 }> {
    return ok({ "shift": 1 + 2 << 3, "mixed": 6 & 3 | 8, "chain": 1 | 2 ^ 3, "cmp": 5 & 3 == 1, "sum": 2 + 3 & 6 });
}
@get("/table/{x}")
fn get_table(x: i64) -> Response<{ v: i64 }> { return ok({ "v": t.table[x & 3] }); }
@get("/rotr/{x}/{n}")
fn get_rotr(x: i64 in 0..4294967295, n: i64 in 1..31) -> Response<{ v: i64 }> { return ok({ "v": ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF }); }
@get("/crc")
fn get_crc() -> Response<{ crc: i64 }> {
    var crc = 0xFFFFFFFF;
    each i in 0..9 {
        crc = crc ^ t.digits[i];
        each bit in 0..8 {
            if (crc & 1) == 1 { crc = (crc >> 1) ^ 0xEDB88320; } else { crc = crc >> 1; }
        }
    }
    return ok({ "crc": crc ^ 0xFFFFFFFF });
}
--- requests
POST /setup
GET /ops/12/10
GET /ops/-1/255
GET /ops/-8/3
GET /shift/1/62
GET /shift/1/63
GET /shift/-16/2
GET /shift/5/0
GET /shift/1/64
GET /shift/1/-1
GET /hex
GET /prec
GET /table/5
GET /table/-1
GET /rotr/305419896/8
GET /rotr/1/1
GET /crc
