// LangArena Base64::Decode (kostya/LangArena, MIT): decode the standard Base64 text of `size` bytes of "a" (with padding), `iterations` times, checking the text is valid; the
// checksum adds the decoded length of every run (warmup included) and the benchmark's final message names the first four characters of the encoded and of the decoded text. This
// port builds that message in a request field and answers its hash (GET /checksum), as the reference does. The reference calls the base64-simd library (SIMD); this calls the
// language's `unbase64` builtin, which uses AVX2 where the CPU has it (runtime/mito.c; it answers null for text that is not Base64). main_loop.mito keeps the earlier version that
// is a plain scalar loop with a lookup table, written in the language.
struct B64 { data: u8[500000]; encoded: ascii<666672>; size: i64 in 0..500000; decoded_len: i64; result: i64; bad: i64; head: ascii<8>; }
state b: B64;
struct Work { message: ascii<128>; }
request work: Work; // the final message, built to be hashed

fn decode() {
    let decoded = unbase64(b.encoded);
    b.bad = 0;
    if decoded == null {
        b.bad = 1;
    } else {
        b.decoded_len = len(decoded);
        b.head = substr(decoded, 0, 4);
    }
}
fn one_run() {
    decode();
    if b.bad == 0 { b.result = (b.result + b.decoded_len) % 4294967296; }
}

@post("/prepare/{size}")
fn prepare(size: i64 in 4..500000) -> Response<{}> {
    b.size = size;
    b.result = 0;
    b.data.fill(0, size, 97);
    b.encoded = base64(text_from(b.data, 0, size));
    decode();
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
// the reference's message, "decode YWFh... to aaaa...: <sum>", and its hash
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> {
    work.message = "decode " + substr(b.encoded, 0, 4) + "... to " + b.head + "...: " + b.result;
    var hash = 5381;
    foreach i in 0..len(work.message) - 1 { hash = (hash * 33 + work.message[i]) % 4294967296; }
    return ok({ checksum: hash });
}
