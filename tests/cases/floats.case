// floats: literals, fields, mixed arithmetic, comparisons, conversions, and how they are written
--- state
struct Acc { total: f64; small: f32; n: i64; }
global acc: Acc;
--- api
endpoint POST /add { acc.total = acc.total + body("x"); acc.n = acc.n + 1; respond 200 { "total": acc.total }; }
endpoint POST /small { acc.small = body("x"); respond 200 { "small": acc.small }; }
endpoint GET /mean { if acc.n == 0 { fail 409 "no values"; } respond 200 { "mean": acc.total / acc.n }; }
endpoint GET /math {
    let a = 1.5;
    let b = 2;
    respond 200 {
        "sum": a + b, "diff": b - a, "prod": a * b, "quot": b / 4.0, "neg": -a, "tenth": 0.1 + 0.2,
        "lt": a < b, "eq": 2.0 == b, "ne": a != 1.5, "int": int(7.9), "nint": int(-7.9), "str": str(2.5) + "!", "whole": 3.0,
        "big": 1000000000000000000000.0 + 1.0, "tiny": 0.000001, "inf": 1.0 / 0.0
    };
}
endpoint GET /cmp/{x} { let x = int(param("x")) + 0.5; respond 200 { "gt": x > 2, "max": x >= 10.5 }; }
--- requests
GET /mean
POST /add {"x": 1.25}
POST /add {"x": 2}
POST /add {"x": -0.75}
POST /add {"x": 1e2}
POST /add {"x": -2.5E-1}
POST /add {"x": 99999999999999999999}
POST /add {"x": 0}
POST /add {"x": -0}
POST /add {"x": 01}
POST /add {"x": 1.}
POST /add {"x": .5}
POST /add {"x": 1e}
GET /mean
POST /small {"x": 0.1}
GET /math
GET /cmp/2
GET /cmp/10
GET /cmp/1
