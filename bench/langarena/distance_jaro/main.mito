// LangArena Distance::Jaro (kostya/LangArena, MIT): the Jaro similarity of `count` pairs of random strings (4 to 53 letters from "abcdefghij", from the reference's generator and random
// sequence), all pairs per run, `iterations` runs; the checksum adds int(similarity * 1000) of every pair, warmup runs included, modulo 2^32. The reference's Vec<(String, String)> is one byte
// array with an offset and length per string; jaro() is the reference's, line by line (the match window, the two match flags, the transposition count).
struct Pairs { text: u8[200000]; off1: i32[1024]; len1: i32[1024]; off2: i32[1024]; len2: i32[1024]; flags1: u8[64] unlogged; flags2: u8[64] unlogged; count: i64; last: i64; result: i64; }
state p: Pairs;

fn next_int(max) {
    p.last = (p.last * 3877 + 29573) % 139968;
    return int(p.last / 139968.0 * max);
}
fn jaro(off1, len1, off2, len2) {
    if len1 == 0 || len2 == 0 { return 0.0; }
    let longest = max(len1, len2);
    var window = longest / 2;
    if window > 0 { window = window - 1; }
    p.flags1.fill(0, len1, 0);
    p.flags2.fill(0, len2, 0);
    var matches = 0;
    foreach i in 0..len1 - 1 {
        var start = 0;
        if i > window { start = i - window; }
        let end = min(len2 - 1, i + window);
        var found = 0;
        foreach j in start..end while found == 0 {
            if p.flags2[j] == 0 && p.text[off1 + i] == p.text[off2 + j] {
                p.flags1[i] = 1;
                p.flags2[j] = 1;
                matches = matches + 1;
                found = 1;
            }
        }
    }
    if matches == 0 { return 0.0; }
    var transpositions = 0;
    var k = 0;
    foreach i in 0..len1 - 1 {
        if p.flags1[i] == 1 {
            foreach w in 0..len2 while k < len2 && p.flags2[k] == 0 { k = k + 1; }
            if k < len2 {
                if p.text[off1 + i] != p.text[off2 + k] { transpositions = transpositions + 1; }
                k = k + 1;
            }
        }
    }
    transpositions = transpositions / 2;
    let m = matches * 1.0;
    return (m / len1 + m / len2 + (m - transpositions) / m) / 3.0;
}
fn one_run() {
    var total = p.result;
    foreach pair in 0..p.count - 1 {
        total = total + int(jaro(p.off1[pair], p.len1[pair], p.off2[pair], p.len2[pair]) * 1000.0);
    }
    p.result = total % 4294967296;
}

@post("/prepare/{count}/{size}")
fn prepare(count: i64 in 1..1024, size: i64 in 1..56) -> Response<{}> {
    p.count = count;
    p.last = 42;
    var at = 0;
    foreach pair in 0..count - 1 {
        let first_len = next_int(size) + 4;
        let second_len = next_int(size) + 4;
        p.off1[pair] = at;
        p.len1[pair] = first_len;
        foreach i in 0..first_len - 1 { p.text[at + i] = 97 + next_int(10); }
        at = at + first_len;
        p.off2[pair] = at;
        p.len2[pair] = second_len;
        foreach i in 0..second_len - 1 { p.text[at + i] = 97 + next_int(10); }
        at = at + second_len;
    }
    p.result = 0;
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": p.result }); }
