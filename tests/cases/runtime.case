// behaviours first checked by the Rust runtime's own tests, kept here when it was removed: structs holding only
// collections stay distinct; a failed request rolls back every write; a freed slot is reused lowest first; a pool of
// 100000 items with nested lists commits only the headers of items in use (see the memory line)
--- state
struct M { n: i32; }
struct W { s: pool<M, 4>; }
struct T { a: i64; b: i64; name: string<16>; }
struct R { m: list<M, 8>; }
global w0: W;
global w1: W;
global t: T;
global ms: pool<M, 4>;
global rs: pool<R, 100000>;
--- api
endpoint POST /w1 { let m = alloc w1.s; m.n = 1; respond 201 { "slot": slot(m) }; }
endpoint GET /w { respond 200 { "w0": count(w0.s), "w1": count(w1.s) }; }
endpoint POST /t { t.a = 1; t.b = 2; t.name = "changed"; let m = alloc ms; m.n = 9; if body("fail") == "yes" { fail 409 "rolled back"; } respond 200 { "a": t.a }; }
endpoint GET /t { respond 200 { "a": t.a, "b": t.b, "name": t.name, "ms": count(ms) }; }
endpoint POST /ms { let m = alloc ms; m.n = int(body("n")); respond 201 { "slot": slot(m) }; }
endpoint DELETE /ms/{k} { free ms[int(param("k"))]; respond 200 {}; }
endpoint GET /scope { let x = 1; var t = 0; if true { let x = 10; t = t + x; } respond 200 { "x": x, "t": t }; }
endpoint POST /rs { let r = alloc rs; let m = alloc r.m; m.n = 1; respond 201 { "slot": slot(r), "m": count(r.m) }; }
--- requests
POST /w1
GET /w
POST /t {"fail": "yes"}
GET /t
POST /t {"fail": "no"}
GET /t
POST /ms {"n": 1}
POST /ms {"n": 2}
POST /ms {"n": 3}
DELETE /ms/1
DELETE /ms/0
POST /ms {"n": 4}
POST /ms {"n": 5}
POST /rs
GET /scope
