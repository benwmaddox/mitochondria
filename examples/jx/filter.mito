// The filter language, read as it is evaluated: a filter is text, and `eval` walks it with a position, so there is no tree
// of the filter either. A value is a position in the input (-1 for null). A filter is steps joined by `|`; a step is
//   .            the value itself              .name  ."odd key"  .[2]    a field or an element (null when absent)
//   .[]          each element (or field value) of an array (or object): the rest of the filter runs once for each
//   select(P)    keep the value when P holds: a path alone (not null or false) or `path OP literal`,
//                OP is == != < > <= >=, a literal is a number, a "string", true, false or null
//   length       the number of elements, fields or characters (of a string); type  the value's type
// `length` and `type` make a new value, so they must be the last step.

fn is_name_char(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

fn name_end(f: text, p: i64) -> i64 {
    var e = p;
    while e < len(f) && is_name_char(at(f, e)) { e += 1; }
    return e;
}

fn lookup(doc: text, v: i64, name: text) -> i64 {
    if v < 0 { return -1; }
    return field_pos(doc, v, name);
}

// follow `.name`, `."name"` and `[N]` steps from the value at v; the filter's position after them is left in j.fp
fn path(doc: text, v0: i64, f: text, fp0: i64) -> i64 {
    var v = v0;
    var fp = fp0;
    while fp < len(f) {
        let c = at(f, fp);
        if c == 46 {
            let d = at(f, fp + 1);
            if d == 91 { fp += 1; continue; }              // `.[`: the bracket is read next
            if d == 34 {
                let e = skip_string(f, fp + 1);
                if e < 0 { j.err = "jx: a quoted name does not end"; j.fp = -1; return -1; }
                v = lookup(doc, v, substr(f, fp + 2, e - fp - 3));
                fp = e;
                continue;
            }
            let e = name_end(f, fp + 1);
            if e > fp + 1 { v = lookup(doc, v, substr(f, fp + 1, e - fp - 1)); }
            fp = e;
            continue;
        }
        if c == 91 {
            if at(f, fp + 1) == 93 { break; }              // `[]` is the loop in `eval`
            var e = fp + 1;
            var n = 0;
            while at(f, e) >= 48 && at(f, e) <= 57 { n = n * 10 + at(f, e) - 48; e += 1; }
            if e == fp + 1 || at(f, e) != 93 { j.err = "jx: [N] takes a number"; j.fp = -1; return -1; }
            if v >= 0 { v = index_pos(doc, v, n); }
            fp = e + 1;
            continue;
        }
        break;
    }
    j.fp = fp;
    return v;
}

// the text of the value at w, "null" for none
fn value_text(doc: text, w: i64) -> text {
    if w < 0 { return "null"; }
    return substr(doc, w, skip_value(doc, w) - w);
}

fn truthy(doc: text, v: i64) -> bool {
    if v < 0 { return false; }
    let end = skip_value(doc, v);
    let t = substr(doc, v, end - v);
    return t != "null" && t != "false";
}

// the filter's position after the literal at p (a string, or a run up to a space or `)`)
fn literal_end(f: text, p: i64) -> i64 {
    if at(f, p) == 34 { return skip_string(f, p); }
    var e = p;
    while e < len(f) && at(f, e) != 32 && at(f, e) != 41 { e += 1; }
    return e;
}

// does `select(...)`'s condition hold? The filter is at p just after `select(`; leaves j.fp after the `)`.
fn condition(doc: text, v: i64, f: text, p: i64) -> bool {
    let w = path(doc, v, f, p);
    var fp = skip_ws(f, j.fp);
    if j.fp < 0 { return false; }
    if at(f, fp) == 41 { j.fp = fp + 1; return truthy(doc, w); }
    var op = 0;                                            // 1 ==, 2 !=, 3 <, 4 >, 5 <=, 6 >=
    let a = at(f, fp);
    let b = at(f, fp + 1);
    if a == 61 && b == 61 { op = 1; fp += 2; }
    else if a == 33 && b == 61 { op = 2; fp += 2; }
    else if a == 60 && b == 61 { op = 5; fp += 2; }
    else if a == 62 && b == 61 { op = 6; fp += 2; }
    else if a == 60 { op = 3; fp += 1; }
    else if a == 62 { op = 4; fp += 1; }
    else { j.err = "jx: select(...) takes a path, or a path, == != < > <= >= and a literal"; j.fp = -1; return false; }
    fp = skip_ws(f, fp);
    let le = literal_end(f, fp);
    if le < 0 { j.err = "jx: a string in the filter does not end"; j.fp = -1; return false; }
    let lit = substr(f, fp, le - fp);
    var close = skip_ws(f, le);
    if at(f, close) != 41 { j.err = "jx: select( is not closed with )"; j.fp = -1; return false; }
    j.fp = close + 1;
    let val = value_text(doc, w);
    if op == 1 { return val == lit; }
    if op == 2 { return val != lit; }
    if w < 0 { return false; }
    let x = int(val);
    let y = int(lit);
    if op == 3 { return x < y; }
    if op == 4 { return x > y; }
    if op == 5 { return x <= y; }
    return x >= y;
}

// the characters of a string value, not its bytes
fn chars_in(s: text) -> i64 {
    var n = 0;
    var i = 0;
    while i < len(s) {
        if (at(s, i) & 192) != 128 { n += 1; }
        i += 1;
    }
    return n;
}

fn value_type(doc: text, v: i64) -> text {
    if v < 0 { return "\"null\""; }
    let c = at(doc, v);
    if c == 123 { return "\"object\""; }
    if c == 91 { return "\"array\""; }
    if c == 34 { return "\"string\""; }
    let t = substr(doc, v, skip_value(doc, v) - v);
    if t == "true" || t == "false" { return "\"boolean\""; }
    if t == "null" { return "\"null\""; }
    return "\"number\"";
}

// run the rest of the filter (from the position fp) on each element of the array, or each field's value of the object, at v
fn each(doc: text, v: i64, f: text, fp: i64) -> i64 {
    if v < 0 || (at(doc, v) != 91 && at(doc, v) != 123) { j.err = "jx: cannot iterate over this value"; return 1; }
    let object = at(doc, v) == 123;
    var i = skip_ws(doc, v + 1);
    while i < len(doc) && at(doc, i) != 93 && at(doc, i) != 125 {
        if object {
            i = skip_string(doc, i);
            i = skip_ws(doc, i);
            i = skip_ws(doc, i + 1);
        }
        let rc = eval(doc, i, f, fp);
        if rc != 0 { return rc; }
        i = skip_ws(doc, skip_value(doc, i));
        if at(doc, i) == 44 { i = skip_ws(doc, i + 1); }
    }
    return 0;
}

// apply the filter from position fp to the value at v, writing each result; 0, or 1 with the reason in j.err
fn eval(doc: text, v0: i64, f: text, fp0: i64) -> i64 {
    var v = v0;
    var fp = fp0;
    while true {
        fp = skip_ws(f, fp);
        v = path(doc, v, f, fp);
        if j.fp < 0 { return 1; }
        fp = skip_ws(f, j.fp);
        if fp >= len(f) { write_value(doc, v); return 0; }
        let c = at(f, fp);
        if c == 124 { fp += 1; continue; }                 // |
        if c == 91 && at(f, fp + 1) == 93 { return each(doc, v, f, fp + 2); }
        if c == 46 && at(f, fp + 1) == 91 && at(f, fp + 2) == 93 { return each(doc, v, f, fp + 3); }
        if is_name_char(c) {
            let e = name_end(f, fp);
            let word = substr(f, fp, e - fp);
            if word == "select" {
                if at(f, e) != 40 { j.err = "jx: select needs (...)"; return 1; }
                let keep = condition(doc, v, f, e + 1);
                if j.fp < 0 { return 1; }
                if !keep { return 0; }
                fp = j.fp;
                continue;
            }
            if word == "length" || word == "type" {
                if skip_ws(f, e) < len(f) { j.err = "jx: length and type make a new value: they must be the last step"; return 1; }
                if word == "type" { write_item(value_type(doc, v)); return 0; }
                if v < 0 { write_item("0"); return 0; }
                let ch = at(doc, v);
                if ch == 123 || ch == 91 { write_item(str(count_in(doc, v))); return 0; }
                if ch == 34 { write_item(str(chars_in(json_unquote(substr(doc, v, skip_value(doc, v) - v))))); return 0; }
                write_value(doc, v);
                return 0;
            }
            j.err = "jx: unknown step `" + word + "`";
            return 1;
        }
        j.err = "jx: unexpected `" + substr(f, fp, 1) + "` in the filter";
        return 1;
    }
    return 0;
}
