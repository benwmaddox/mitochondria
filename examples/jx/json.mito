// JSON where it lies. A value is a position in the text; these functions find where values end, look inside them,
// and write them out. Nothing is copied except the output.
// Characters are compared as bytes: space 32, tab 9, newline 10, carriage return 13, quote 34, comma 44, colon 58,
// [ 91, ] 93, { 123, } 125, backslash 92.

// the byte at i, 0 beyond the ends
fn at(t: text, i: i64) -> i64 {
    if i < 0 || i >= len(t) { return 0; }
    return byte_at(t, i);
}

fn skip_ws(t: text, p: i64) -> i64 {
    var i = p;
    while i < len(t) {
        let c = at(t, i);
        if c != 32 && c != 10 && c != 13 && c != 9 { break; }
        i += 1;
    }
    return i;
}

// the position after the string that starts at p (its opening quote), or -1 when it does not end
fn skip_string(t: text, p: i64) -> i64 {
    var i = p + 1;
    while i < len(t) {
        let c = at(t, i);
        if c == 92 { i += 2; continue; }
        if c == 34 { return i + 1; }
        i += 1;
    }
    return -1;
}

// the position after the value that starts at p (after spaces), or -1 when it is not complete
fn skip_value(t: text, p0: i64) -> i64 {
    var p = skip_ws(t, p0);
    if p >= len(t) { return -1; }
    let c = at(t, p);
    if c == 34 { return skip_string(t, p); }
    if c == 123 || c == 91 {
        var depth = 0;
        while p < len(t) {
            let d = at(t, p);
            if d == 34 {
                p = skip_string(t, p);
                if p < 0 { return -1; }
                continue;
            }
            if d == 123 || d == 91 { depth += 1; }
            if d == 125 || d == 93 {
                depth -= 1;
                if depth == 0 { return p + 1; }
            }
            p += 1;
        }
        return -1;
    }
    // a number, true, false or null: up to a delimiter
    while p < len(t) {
        let d = at(t, p);
        if d == 44 || d == 125 || d == 93 || d == 32 || d == 10 || d == 13 || d == 9 { break; }
        p += 1;
    }
    return p;
}

// the value of field `name` in the object at p, as the position it starts at; -1 when there is none
fn field_pos(t: text, p: i64, name: text) -> i64 {
    if at(t, p) != 123 { return -1; }
    var i = skip_ws(t, p + 1);
    while i < len(t) && at(t, i) == 34 {
        let key_end = skip_string(t, i);
        if key_end < 0 { return -1; }
        let key = substr(t, i + 1, key_end - i - 2);
        var v = skip_ws(t, key_end);
        if at(t, v) != 58 { return -1; }
        v = skip_ws(t, v + 1);
        if key == name { return v; }
        let after = skip_value(t, v);
        if after < 0 { return -1; }
        i = skip_ws(t, after);
        if at(t, i) != 44 { return -1; }
        i = skip_ws(t, i + 1);
    }
    return -1;
}

// the nth element of the array at p, as the position it starts at; -1 when there is none
fn index_pos(t: text, p: i64, n: i64) -> i64 {
    if at(t, p) != 91 { return -1; }
    var i = skip_ws(t, p + 1);
    var k = 0;
    while i < len(t) && at(t, i) != 93 {
        if k == n { return i; }
        let after = skip_value(t, i);
        if after < 0 { return -1; }
        i = skip_ws(t, after);
        if at(t, i) != 44 { return -1; }
        i = skip_ws(t, i + 1);
        k += 1;
    }
    return -1;
}

// how many elements or fields the array or object at p has
fn count_in(t: text, p: i64) -> i64 {
    var close = 125;
    if at(t, p) == 91 { close = 93; }
    var i = skip_ws(t, p + 1);
    var k = 0;
    while i < len(t) && at(t, i) != close {
        if close == 125 {
            i = skip_string(t, i);
            if i < 0 { return -1; }
            i = skip_ws(t, i);
            i = skip_ws(t, i + 1);
        }
        let after = skip_value(t, i);
        if after < 0 { return -1; }
        k += 1;
        i = skip_ws(t, after);
        if at(t, i) == 44 { i = skip_ws(t, i + 1); }
    }
    return k;
}

// ---- writing

fn newline_indent(depth: i64) {
    j.out += "\n";
    var k = 0;
    while k < depth { j.out += "  "; k += 1; }
}

// write the value at p, compact or indented; p < 0 writes null. A string is written bare when `raw` and the value is one.
fn write_value(t: text, p0: i64) {
    if p0 < 0 { write_item("null"); return; }
    var p = skip_ws(t, p0);
    let end = skip_value(t, p);
    if j.sep { j.out += "\n"; }
    j.sep = true;
    if j.raw && at(t, p) == 34 {
        j.out += json_unquote(substr(t, p, end - p));
        return;
    }
    var depth = 0;
    while p < end {
        let c = at(t, p);
        if c == 34 {
            let e = skip_string(t, p);
            j.out += substr(t, p, e - p);
            p = e;
        } else if c == 123 || c == 91 {
            let next = skip_ws(t, p + 1);
            let d = at(t, next);
            if d == 125 || d == 93 {
                j.out += substr(t, p, 1);
                j.out += substr(t, next, 1);
                p = next + 1;
            } else {
                j.out += substr(t, p, 1);
                depth += 1;
                if j.pretty { newline_indent(depth); }
                p = next;
            }
        } else if c == 125 || c == 93 {
            depth -= 1;
            if j.pretty { newline_indent(depth); }
            j.out += substr(t, p, 1);
            p += 1;
        } else if c == 44 {
            j.out += ",";
            if j.pretty { newline_indent(depth); }
            p = skip_ws(t, p + 1);
        } else if c == 58 {
            j.out += ":";
            if j.pretty { j.out += " "; }
            p = skip_ws(t, p + 1);
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            p += 1;
        } else {
            var e = p;
            while e < end {
                let d = at(t, e);
                if d == 44 || d == 125 || d == 93 || d == 58 || d == 32 || d == 10 || d == 13 || d == 9 { break; }
                e += 1;
            }
            j.out += substr(t, p, e - p);
            p = e;
        }
    }
}

// write a ready-made value (a number, a string) as a result
fn write_item(s: text) {
    if j.sep { j.out += "\n"; }
    j.sep = true;
    if j.raw && at(s, 0) == 34 { j.out += json_unquote(s); } else { j.out += s; }
}
