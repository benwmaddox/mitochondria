// JSON request bodies: escapes, surrogate pairs, numbers, wrong kinds, broken JSON; query values; rate limits over time
--- state
struct Meta { next_seq: i64; rate: i64; typing_ttl: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Msg { seq: i64; at: i64; author: ref<sessions>; body: string<2000>; }
struct Typing { who: ref<sessions>; until: i64; }
struct Room { name: string<8>; created: i64; messages: list<Msg, 5> drop_oldest; typing: pool<Typing, 4>; }
global meta: Meta; global sessions: pool<Session, 3> checked; global rooms: sorted<Room, 2, created>;
--- api
include examples/chat/chat.api
--- requests
POST /sessions {"name":"ann"} => ann
@X-Session: $ann
POST /rooms {"name":"r"}
@X-Session: $ann
POST /rooms/0/messages {"body":"caf\u00e9 \ud83d\ude00 tab\t \"q\" back\\slash"}
@X-Session: $ann
POST /rooms/0/messages {"body":"line\nbreak \/ \b\f\r"}
@X-Session: $ann
POST /rooms/0/messages {"body": "spaced" , "extra": [1, {"x": null}], "n": -1.5e2}
@X-Session: $ann
POST /rooms/0/messages {"body":"dup","body":"second"}
@X-Session: $ann
POST /rooms/0/messages {"body":12}
@X-Session: $ann
POST /rooms/0/messages {"body":"unterminated
@X-Session: $ann
POST /rooms/0/messages not json
@X-Session: $ann
POST /rooms/0/messages ["body"]
@X-Session: $ann
GET /rooms/0/messages?limit=10
@X-Session: $ann
GET /rooms/0/messages?limit=%32
@X-Session: $ann
GET /rooms/0/messages?x=1&limit=1&limit=2
@X-Session: $ann
GET /rooms/00/messages?limit=1
@X-Session: $ann
*25 POST /rooms/0/messages {"body":"x"}
@X-Session: $ann
POST /rooms/0/messages {"body":"x"}
clock 62000
@X-Session: $ann
POST /rooms/0/messages {"body":"after a minute"}
GET /nope
PUT /rooms
GET /rooms/0/messages/extra
