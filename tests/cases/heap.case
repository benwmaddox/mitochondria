// lib/heap.mito: binary min-heap of (priority, payload): distinct and duplicate priorities, full is 507, empty is 404
--- program
struct App { h: heap<8>; }
state app: App;

@post("/push/{priority}/{payload}")
fn post_push_priority_payload(priority: i64, payload: i64) -> Response<{ count: i64 }> { app.h.push(priority, payload); return ok({ "count": app.h.count() }); }
@post("/pop")
fn post_pop() -> Response<{ priority: i64, payload: i64 }> { let priority = app.h.peek_priority(); let payload = app.h.pop_min(); return ok({ "priority": priority, "payload": payload }); }
@get("/peek")
fn get_peek() -> Response<{ priority: i64, payload: i64 }> { return ok({ "priority": app.h.peek_priority(), "payload": app.h.peek() }); }
@get("/count")
fn get_count() -> Response<{ count: i64, room: i64 }> { return ok({ "count": app.h.count(), "room": app.h.room() }); }
@post("/clear")
fn post_clear() -> Response<{ count: i64 }> { app.h.clear(); return ok({ "count": app.h.count() }); }
