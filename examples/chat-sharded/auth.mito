struct Meta { rate: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Gate {
    meta: Meta;
    sessions: pool<Session, 4000> checked;
}
state gate: Gate;

// "shard.slot": a user id that is unique across auth shards (references do not cross workers)
fn user_id(who: Session) -> string { return str(worker_index()) + "." + str(slot(who)); }
fn rate_limited(who: Session) {
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(gate.meta.rate, 30) { fail 429 "slow down"; }
    who.sent += 1;
}

@post("/sessions")
fn sign_in(name: string<1..32>) -> Response<{ token: string }> {
    let s = gate.sessions.add { name: name, secret: random(), window: now() };
    return created({ token: token(s) });
}

@delete("/session")
fn sign_out(who: Session from header("X-Session")) -> Response<{ ok: bool }> {
    gate.sessions.remove(who);
    return ok({ ok: true });
}

// Every other request is checked here (the session, the rate, the body's fields) and handed to a rooms shard with
// who sent it. The directory of rooms lives on rooms[0].
@post("/rooms")
fn add_room(who: Session from header("X-Session"), name: string<1..48>) -> Response<{ id: i64, name: string, shard: i64 }> {
    forward rooms[0] { user: user_id(who), author: who.name };
}
@get("/rooms")
fn rooms(who: Session from header("X-Session")) -> Response<{ rooms: [{ id: i64, name: string }] }> {
    forward rooms[0] { user: user_id(who), author: who.name };
}

@post("/rooms/{room}/messages")
fn post_message(who: Session from header("X-Session"), room: i64, body: string<1..2000>) -> Response<{ seq: i64 }> {
    rate_limited(who);
    forward rooms[room] { user: user_id(who), author: who.name };
}
@get("/rooms/{room}/messages")
fn messages(who: Session from header("X-Session"), room: i64, limit: i64 = 50) -> Response<{ room: string, messages: [{ seq: i64, author: string, at: i64, body: string }] }> {
    forward rooms[room] { user: user_id(who), author: who.name };
}
@post("/rooms/{room}/typing")
fn typing(who: Session from header("X-Session"), room: i64) -> Response<{ ok: bool }> {
    forward rooms[room] { user: user_id(who), author: who.name };
}
@get("/rooms/{room}/typing")
fn who_is_typing(who: Session from header("X-Session"), room: i64) -> Response<{ typing: [{ name: string }] }> {
    forward rooms[room] { user: user_id(who), author: who.name };
}

// this shard only: one-way forwarding has no fan-out to total the other workers
@get("/stats")
fn stats() -> Response<{ shard: i64, sessions: i64, committed_kb: i64, live_kb: i64 }> {
    return ok({ shard: worker_index(), sessions: gate.sessions.count(), committed_kb: stat("committed_kb"), live_kb: stat("live_kb") });
}
