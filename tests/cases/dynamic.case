// inputs of the wrong kind stop at the edge; or() of a dead reference; a collection returned by a function; integer limits
--- program
struct T { n: i64; }
struct App {
    ts: pool<T, 4>;
    top: Top;
}
state app: App;
struct Top { r: i64; }

@post("/t")
fn post_t() -> Response<{}> { let t = app.ts.add(); t.n = slot(t) * 10; return created({}); }
@get("/index")
fn get_index(k: i64 from body) -> Response<{ n: i64 }> { return ok({ "n": app.ts[k].n }); }
@get("/limit")
fn get_limit(n: i64 from body) -> Response<{ x: [i64] }> { return ok({ "x": [foreach t in app.ts limit n t.n] }); }
@get("/minmax")
fn get_minmax(a: i64 from body) -> Response<{ min: i64, max: i64 }> { return ok({ "min": min(a, 5), "max": max(3, a) }); }
@get("/neg")
fn get_neg(x: f64 from body) -> Response<{ neg: f64 }> { return ok({ "neg": -x }); }
@get("/arith")
fn get_arith(x: f64 from body) -> Response<{ sum: f64, lt: bool }> { return ok({ "sum": x + 1.0, "lt": x < 2.0 }); }
@post("/set")
fn post_set(x: i64) -> Response<{ n: i64 }> { let t = app.ts[0]; t.n = x; return ok({ "n": t.n }); }
@get("/ornotlive")
fn get_ornotlive(k: i64 from body) -> Response<{ a: i64, b: bool, c: i64 }> { return ok({ "a": or(app.ts[3].n, -1), "b": exists(app.ts[9]), "c": or(app.ts[k].n, 0) }); }
fn pool_of() -> pool<T> { return app.ts; }
fn find(k: i64) -> T? { if k < 0 { return app.ts[99]; } if k == 0 { return app.ts[0]; } return find(k - 1); }
@get("/coll")
fn get_coll() -> Response<{ n: i64, x: [i64] }> { return ok({ "n": pool_of().count(), "x": [foreach t in pool_of() t.n] }); }
@get("/recor")
fn get_recor(k: i64 from body) -> Response<{ a: i64 }> { return ok({ "a": or(find(k).n, -1) }); }
@get("/divmin")
fn get_divmin(d: i64 from body) -> Response<{ d: i64 }> { return ok({ "d": (0 - 9223372036854775807 - 1) / d }); }
@get("/modmin")
fn get_modmin(d: i64 from body) -> Response<{ m: i64 }> { return ok({ "m": (0 - 9223372036854775807 - 1) % d }); }
@post("/setstr")
fn post_setstr() -> Response<{}> { let t = app.ts[0]; t.n = "text"; return ok({}); }
@get("/min_int")
fn get_min_int() -> Response<{ neg: i64 }> { return ok({ "neg": -(0 - 9223372036854775807 - 1) }); }
--- requests
// the Rust runtime builds the text of a "not live" error before or() discards it
*3 POST /t
GET /index {"k": 1}
GET /index {"k": "1"}
GET /index {"k": 1.5}
GET /index {}
GET /limit {"n": 2}
GET /limit {"n": -1}
GET /limit {"n": "2"}
GET /minmax {"a": 1}
GET /minmax {"a": 9}
GET /minmax {"a": "x"}
GET /neg {"x": 4}
GET /neg {"x": 2.5}
GET /neg {"x": "s"}
GET /neg {}
GET /arith {"x": 1}
GET /arith {"x": 1.5}
GET /arith {"x": "a"}
POST /set {"x": 7}
POST /set {"x": 7.5}
POST /set {"x": true}
GET /min_int
GET /divmin {"d": -1}
GET /divmin {"d": 2}
GET /modmin {"d": -1}
POST /setstr
GET /ornotlive {"k": 9}
GET /ornotlive {"k": 1}
GET /coll
GET /recor {"k": 3}
GET /recor {"k": -1}
