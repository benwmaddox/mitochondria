// lib/ring.mito: ring buffer of struct items, overwrite oldest, index from newest, clear
--- program
struct Sample { value: i64; label: string<8>; }
struct App { r: ring<Sample, 4>; }
state app: App;

@post("/push/{value}")
fn post_push_value(value: i64) -> Response<{ count: i64 }> { let sample = app.r.push(); sample.value = value; sample.label = "s" + value; return ok({ "count": app.r.count() }); }
@get("/get/{age}")
fn get_get_age(age: i64) -> Response<{ value: i64, label: string }> { let sample = app.r.get(age); return ok({ "value": sample.value, "label": sample.label }); }
@get("/count")
fn get_count() -> Response<{ count: i64, full: bool }> { return ok({ "count": app.r.count(), "full": app.r.is_full() }); }
@post("/clear")
fn post_clear() -> Response<{ count: i64 }> { app.r.clear(); return ok({ "count": app.r.count() }); }
