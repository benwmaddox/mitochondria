// A Campfire-like chat server's hot state. Message history here is a bounded window per room;
// durable history would live in a database.
struct Meta { next_seq: i64; rate: i64; typing_ttl: i64; }
struct Session { name: string<32>; secret: i64; window: i64; sent: i64; }
struct Msg { seq: i64; at: i64; author: i64; body: string<2000>; } // author: the session's slot
struct Typing { who: i64; until: i64; } // who: the session's slot
struct Room {
    name: string<48>;
    created: i64;
    messages: list<Msg, 1000> drop_oldest;   // the newest 1000 per room
    typing: pool<Typing, 32>;
}

struct Chat {
    meta: Meta;
    sessions: pool<Session, 2000> checked;
    rooms: sorted<Room, 64, created>;   // kept in order of creation (lib/sorted.mito)
}
state chat: Chat;

fn typing_until(t: i64) -> i64 { return t + max(chat.meta.typing_ttl, 5000); }

@post("/sessions")
fn sign_in(name: string<1..32>) -> Response<{ token: string, slot: i64 }> {
    let s = chat.sessions.add { name: name, secret: random(), window: now() };
    return created({ token: token(s), slot: slot(s) });
}

@delete("/session")
fn sign_out(who: Session from header("X-Session")) -> Response<{ ok: bool }> {
    chat.sessions.remove(who);
    return ok({ ok: true });
}

@post("/rooms")
fn add_room(who: Session from header("X-Session"), name: string<1..48>) -> Response<{ id: Room, name: string }> {
    let r = chat.rooms.add(now()) { name: name };
    return created({ id: r, name: r.name });
}

@get("/rooms")
fn rooms(who: Session from header("X-Session")) -> Response<{ rooms: [{ id: Room, name: string }] }> {
    return ok({ rooms: [foreach r in chat.rooms { id: r, name: r.name }] });
}

@post("/rooms/{room}/messages")
fn post_message(who: Session from header("X-Session"), room: Room, body: string<1..2000>) -> Response<{ seq: i64 }> {
    let t = now();
    if t - who.window > 60000 { who.window = t; who.sent = 0; }
    if who.sent >= max(chat.meta.rate, 30) { fail 429 "slow down"; }
    who.sent += 1;
    chat.meta.next_seq += 1;
    let m = room.messages.add { seq: chat.meta.next_seq, at: t, author: slot(who), body: body };
    return created({ seq: m.seq });
}

@get("/rooms/{room}/messages")
fn messages(who: Session from header("X-Session"), room: Room, limit: i64 = 50) -> Response<{ room: string, messages: [{ seq: i64, author: string, at: i64, body: string }] }> {
    return ok({
        room: room.name,
        messages: [foreach m in room.messages reverse limit min(limit, 100) {
            seq: m.seq, author: or(chat.sessions[m.author].name, "[deleted]"), at: m.at, body: m.body
        }]
    });
}

@post("/rooms/{room}/typing")
fn typing(who: Session from header("X-Session"), room: Room) -> Response<{ ok: bool }> {
    let t = now();
    var found = false;
    foreach ty in room.typing {
        if ty.who == slot(who) { ty.until = typing_until(t); found = true; }
        else if ty.until < t { room.typing.remove(ty); }
    }
    if !found { room.typing.add { who: slot(who), until: typing_until(t) }; }
    return ok({ ok: true });
}

@get("/rooms/{room}/typing")
fn who_is_typing(who: Session from header("X-Session"), room: Room) -> Response<{ typing: [{ name: string }] }> {
    let t = now();
    return ok({ typing: [foreach ty in room.typing where ty.until >= t { name: or(chat.sessions[ty.who].name, "[gone]") }] });
}

@get("/stats")
fn stats() -> Response<{ sessions: i64, rooms: i64, messages: i64, next_seq: i64, committed_kb: i64, live_kb: i64, reserved_kb: i64 }> {
    var messages = 0;
    foreach r in chat.rooms { messages += r.messages.count(); }
    return ok({
        sessions: chat.sessions.count(), rooms: chat.rooms.size(), messages: messages, next_seq: chat.meta.next_seq,
        committed_kb: stat("committed_kb"), live_kb: stat("live_kb"), reserved_kb: stat("reserved_kb")
    });
}

// ---- tests (`mito test chat.mito`): each starts from an empty server
test "a signed-in user posts and reads messages, newest first" {
    let s = post("/sessions", { name: "ann" });
    if s.status != 201 { return "sign in: " + str(s.status) + " " + s.body; }
    let token = field(s.body, "token");
    let room = post("/rooms", { name: "general" }, { "X-Session": token });
    let msgs = "/rooms/" + field(room.body, "id") + "/messages";
    post(msgs, { body: "first" }, { "X-Session": token });
    post(msgs, { body: "second" }, { "X-Session": token });
    let r = get(msgs + "?limit=1", { }, { "X-Session": token });
    if r.status != 200 { return "read: " + str(r.status) + " " + r.body; }
    return r.body == "{\"room\":\"general\",\"messages\":[{\"seq\":2,\"author\":\"ann\",\"at\":1767225600000,\"body\":\"second\"}]}";
}
test "a request without a session is refused" {
    let r = get("/rooms");
    if r.status != 401 { return "expected 401, got " + str(r.status); }
    return get("/rooms", { }, { "X-Session": "1.2.3" }).status == 401;
}
test "the 31st message in a minute is refused" {
    let token = field(post("/sessions", { name: "bo" }).body, "token");
    let room = field(post("/rooms", { name: "busy" }, { "X-Session": token }).body, "id");
    var last = 0;
    foreach i in 1..31 { last = post("/rooms/" + room + "/messages", { body: "m" + str(i) }, { "X-Session": token }).status; }
    if last != 429 { return "the 31st message answered " + str(last); }
    return chat.meta.next_seq == 30;
}
