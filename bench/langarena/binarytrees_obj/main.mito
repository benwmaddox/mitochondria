// LangArena Binarytrees::Obj (kostya/LangArena, MIT): build a complete binary tree of depth 20 (2,097,151 nodes) of node objects linked by references, sum its
// items, and drop it, `iterations` times. Same recursion as the reference: new(item, depth) makes a node and, when depth > 0, a left child (item - 2^(depth-1)) and a
// right child (item + 2^(depth-1)); sum adds item + 1 over the tree. Each node is a pool item naming its children by slot + 1, 0 for none (the reference's Option<Box<TreeNode>>), and
// dropping the tree at the end of a run is coll.clear(). The checksum adds each run's sum, warmup runs included, modulo 2^32 (item as u32 is item modulo 2^32).
struct Node { item: i32; left: i32; right: i32; } // children: their slots + 1, 0 for none
struct T { nodes: pool<Node, 2097151> checked unlogged; depth: i64; result: i64; }
state tree: T;

fn build(item: i64, depth: i64) -> Node {
    let node = tree.nodes.add();
    node.item = item;
    if depth == 0 { return node; }
    let half = 1 << (depth - 1);
    node.left = slot(build(item - half, depth - 1)) + 1;
    node.right = slot(build(item + half, depth - 1)) + 1;
    return node;
}
fn sum(node: Node) -> i64 {
    var total = (node.item + 4294967297) % 4294967296;
    if node.left == 0 && node.right == 0 { return total; }
    if node.left != 0 { total = (total + sum(tree.nodes[node.left - 1])) % 4294967296; }
    if node.right != 0 { total = (total + sum(tree.nodes[node.right - 1])) % 4294967296; }
    return total;
}
fn one_run() {
    let root = build(0, tree.depth);
    tree.result = (tree.result + sum(root)) % 4294967296;
    tree.nodes.clear();
}

@post("/prepare/{depth}")
fn prepare(depth: i64 in 0..20) -> Response<{}> { tree.depth = depth; tree.result = 0; return ok({}); }
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> { return ok({ "checksum": tree.result }); }
