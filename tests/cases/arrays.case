// fixed arrays: in items and in plain state, read and written by index, bounds checked
--- program
struct Grid { cells: i32[4]; total: i64; }
struct Player { hits: i16[3]; name: string<8>; }
struct App {
    grid: Grid;
    players: pool<Player, 2>;
}
state app: App;

@post("/grid/{k}")
fn post_grid_k(k: i64, v: i64) -> Response<{ cell: i64 }> { app.grid.cells[k] = v; app.grid.total = app.grid.total + v; return ok({ "cell": app.grid.cells[k] }); }
@get("/grid")
fn get_grid() -> Response<{ c0: i64, c3: i64, total: i64 }> { return ok({ "c0": app.grid.cells[0], "c3": app.grid.cells[3], "total": app.grid.total }); }
@get("/grid/{k}")
fn get_grid_k(k: i64) -> Response<{ v: i64 }> { return ok({ "v": app.grid.cells[k] }); }
@post("/players")
fn post_players(name: string<4096>?) -> Response<{ slot: i64 }> { let p = app.players.add(); p.name = name; p.hits[0] = 1; p.hits[2] = 3; return created({ "slot": slot(p) }); }
@post("/players/{p}/hit/{k}")
fn post_players_p_hit_k(p: i64, k: i64) -> Response<{ hits: i64 }> {
    let p = app.players[p];
    
    p.hits[k] = p.hits[k] + 1;
    return ok({ "hits": p.hits[k] });
}
@get("/players")
fn get_players() -> Response<{ x: [{ name: string, h0: i64, h1: i64, h2: i64 }] }> {
    return ok({ "x": [foreach p in app.players { "name": p.name, "h0": p.hits[0], "h1": p.hits[1], "h2": p.hits[2] }] });
}
@post("/overflow")
fn post_overflow() -> Response<{}> { let p = app.players[0]; p.hits[1] = 40000; return ok({}); }
--- requests
GET /grid
POST /grid/1 {"v": 7}
POST /grid/3 {"v": -2}
POST /grid/4 {"v": 1}
POST /grid/-1 {"v": 1}
GET /grid
GET /grid/1
GET /grid/9
POST /players {"name": "ann"}
POST /players/0/hit/1
POST /players/0/hit/1
POST /players/0/hit/2
POST /players/0/hit/3
POST /players/1/hit/0
GET /players
POST /overflow
GET /players
