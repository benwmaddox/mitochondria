// lib/grid.mito: W by H grid of i64 cells, row-major, in_bounds, fill, out of bounds is 400
--- program
struct App { cells: grid<5, 3>; }
state app: App;

@post("/set/{x}/{y}/{value}")
fn post_set_x_y_value(x: i64, y: i64, value: i64) -> Response<{ ok: bool }> { app.cells.set(x, y, value); return ok({ "ok": true }); }
@get("/get/{x}/{y}")
fn get_get_x_y(x: i64, y: i64) -> Response<{ value: i64 }> { return ok({ "value": app.cells.get(x, y) }); }
@get("/in/{x}/{y}")
fn get_in_x_y(x: i64, y: i64) -> Response<{ inside: bool }> { return ok({ "inside": app.cells.in_bounds(x, y) }); }
@get("/size")
fn get_size() -> Response<{ width: i64, height: i64 }> { return ok({ "width": app.cells.width(), "height": app.cells.height() }); }
@post("/fill/{value}")
fn post_fill_value(value: i64) -> Response<{ ok: bool }> { app.cells.fill(value); return ok({ "ok": true }); }
