// An ordered map from i64 keys to rows of W i64 values, up to N entries: put(key, col, value) sets one value of the row of a
// key (adding the key with a row of zeros if it is not there), get_or / add_to / range_sum read and change one column. The
// same B+tree as `ordmap`, whose single value is the case W = 1; wider rows keep a record's numbers beside its key instead
// of in a pool of their own, so a scan reads them in order. Name the columns in the program (`let price = 0;`). Nothing
// outside the map names an entry. (Local names are never a single letter: see lib/btree.mito.)
module rowmap<N: count, W: count>
struct Leaf { count: u32; keys: i64[17]; vals: i64[17 * W]; next: u32; prev: u32; parent: u32; } // entry i's values are vals[i * W .. i * W + W - 1]
struct Inner { count: u32; keys: i64[16]; kids: u32[17]; parent: u32; }
struct Head { root: u32; height: u32; first: u32; last: u32; size: i64; }
// what an instance holds
state {
    leaves: pool<Leaf, N / 2 + 8>;
    inners: pool<Inner, N / 4 + 8>;
    head: Head;
}

pub fn size() -> i64 { return self.head.size; }
pub fn leaf_count() -> i64 { return self.leaves.count(); }
pub fn inner_count() -> i64 { return self.inners.count(); }

// ---- searching
// In leaf `leaf` (its id): how many keys are below target.
fn leaf_pos(leaf: i64, target: i64) -> i64 {
    let node = self.leaves[leaf - 1];
    var pos = 0;
    foreach at in 0..16 while at < node.count && node.keys[at] < target { pos = at + 1; }
    return pos;
}
// In inner node `node_id`: which child holds target: the number of separators at or below it.
fn kid_pos(node_id: i64, target: i64) -> i64 {
    let node = self.inners[node_id - 1];
    var pos = 0;
    foreach at in 0..15 while at < node.count - 1 && node.keys[at] <= target { pos = at + 1; }
    return pos;
}
// The leaf where a search for target ends, 0 if the map is empty.
fn descend(target: i64) -> i64 {
    var node = self.head.root;
    foreach level in 0..self.head.height - 1 { node = self.inners[node - 1].kids[self.kid_pos(node, target)]; }
    return node;
}

// The value of key target, or dflt when there is none.
pub fn get_or(target: i64, col: i64, dflt: i64) -> i64 {
    var found = dflt;
    if self.head.root != 0 {
        let leaf = self.descend(target);
        let node = self.leaves[leaf - 1];
        let pos = self.leaf_pos(leaf, target);
        if pos < node.count && node.keys[pos] == target { found = node.vals[pos * W + col]; }
    }
    return found;
}
// Add delta to the value of key target if there is one; true if there was.
pub fn add_to(target: i64, col: i64, delta: i64) -> bool {
    var done = false;
    if self.head.root != 0 {
        let leaf = self.descend(target);
        let node = self.leaves[leaf - 1];
        let pos = self.leaf_pos(leaf, target);
        if pos < node.count && node.keys[pos] == target { node.vals[pos * W + col] = node.vals[pos * W + col] + delta; done = true; }
    }
    return done;
}
// The sum of the values of up to limit entries from the first key at or above start, in key order.
pub fn range_sum(start: i64, limit: i64, col: i64) -> i64 {
    var total = 0;
    var taken = 0;
    if self.head.root != 0 {
        var leaf = self.descend(start);
        var pos = self.leaf_pos(leaf, start);
        foreach step in 0..limit + 2 - 1 while leaf != 0 && taken < limit {
            // the rest of this leaf, as far as the limit allows
            let node = self.leaves[leaf - 1];
            var stop = node.count;
            if stop - pos > limit - taken { stop = pos + limit - taken; }
            foreach at in 0..16 where at >= pos && at < stop { total = total + node.vals[at * W + col]; }
            if stop > pos { taken = taken + stop - pos; }
            leaf = node.next;
            pos = 0;
        }
    }
    return total;
}

// ---- inserting
fn new_leaf() -> i64 { let made = self.leaves.add(); return slot(made) + 1; }
// Set the value of key new_key, adding the key if it is not there.
pub fn put(new_key: i64, col: i64, value: i64) {
    if self.head.root == 0 {
        let only = self.new_leaf();
        self.head.root = only;
        self.head.first = only;
        self.head.last = only;
        self.head.height = 0;
    }
    let leaf = self.descend(new_key);
    let node = self.leaves[leaf - 1];
    let count = node.count;
    let pos = self.leaf_pos(leaf, new_key);
    if pos < count && node.keys[pos] == new_key {
        node.vals[pos * W + col] = value;
    } else {
        node.keys.move(pos, pos + 1, count - pos);
        node.vals.move(pos * W, pos * W + W, (count - pos) * W);
        node.keys[pos] = new_key;
        foreach clear in 0..W - 1 { node.vals[pos * W + clear] = 0; }
        node.vals[pos * W + col] = value;
        node.count = count + 1;
        self.head.size = self.head.size + 1;
        if count + 1 == 17 { self.split_leaf(leaf); }
    }
}
// leaf `leaf` holds 17: the first 9 stay, the last 8 move to a new leaf after it
fn split_leaf(leaf: i64) {
    let right = self.new_leaf();
    let from = self.leaves[leaf - 1];
    let to = self.leaves[right - 1];
    foreach offset in 0..7 {
        to.keys[offset] = from.keys[9 + offset];
        foreach part in 0..W - 1 { to.vals[offset * W + part] = from.vals[(9 + offset) * W + part]; }
    }
    to.count = 8;
    from.count = 9;
    let after = from.next;
    to.next = after;
    to.prev = leaf;
    from.next = right;
    if after != 0 { self.leaves[after - 1].prev = right; } else { self.head.last = right; }
    self.insert_up(leaf, right, to.keys[0], 0);
}
// node `right_node` (at level `first_level`: 0 leaves, 1 their parents, ...) now follows node `left_node`, and its keys
// start at `separator`: record that in the left node's parent, splitting parents that overflow
fn insert_up(left_node: i64, right_node: i64, separator: i64, first_level: i64) {
    var left = left_node;
    var right = right_node;
    var up_key = separator;
    var level = first_level;
    var going = 1;
    foreach step in 0..19 while going == 1 {
        let parent = self.parent_of(left, level);
        if parent == 0 {
            // left was the root: a new root above both
            let made = self.inners.add();
            let root = slot(made) + 1;
            self.inners[root - 1].count = 2;
            self.inners[root - 1].keys[0] = up_key;
            self.inners[root - 1].kids[0] = left;
            self.inners[root - 1].kids[1] = right;
            self.set_parent(left, level, root);
            self.set_parent(right, level, root);
            self.head.root = root;
            self.head.height = self.head.height + 1;
            going = 0;
        } else {
            let at = self.kid_index(parent, left);
            let node = self.inners[parent - 1];
            let kids = node.count;
            node.kids.move(at + 1, at + 2, kids - at - 1);
            node.keys.move(at, at + 1, kids - 1 - at);
            node.kids[at + 1] = right;
            node.keys[at] = up_key;
            node.count = kids + 1;
            self.set_parent(right, level, parent);
            if kids + 1 < 17 {
                going = 0;
            } else {
                // the parent holds 17 children: the first 9 stay, the key after them goes up, the last 8 move to a new node
                let made = self.inners.add();
                let sibling = slot(made) + 1;
                foreach offset in 0..7 {
                    let kid = self.inners[parent - 1].kids[9 + offset];
                    self.inners[sibling - 1].kids[offset] = kid;
                    self.set_parent(kid, level, sibling);
                }
                foreach offset in 0..6 { self.inners[sibling - 1].keys[offset] = self.inners[parent - 1].keys[9 + offset]; }
                self.inners[sibling - 1].count = 8;
                let promoted = self.inners[parent - 1].keys[8];
                self.inners[parent - 1].count = 9;
                left = parent;
                right = sibling;
                up_key = promoted;
                level = level + 1;
            }
        }
    }
}
// the parent of a node at the given level (0 for a leaf), 0 for the root
fn parent_of(node: i64, level: i64) -> i64 { if level == 0 { return self.leaves[node - 1].parent; } return self.inners[node - 1].parent; }
fn set_parent(node: i64, level: i64, parent: i64) { if level == 0 { self.leaves[node - 1].parent = parent; } else { self.inners[node - 1].parent = parent; } }
// the position of child `child` in inner node `node`
fn kid_index(node: i64, child: i64) -> i64 {
    var index = 0;
    foreach step in 0..16 while self.inners[node - 1].kids[index] != child { index = index + 1; }
    return index;
}

// ---- removing
// Remove key target if it is there; true if it was.
pub fn del(target: i64) -> bool {
    var done = false;
    if self.head.root != 0 {
        let leaf = self.descend(target);
        let node = self.leaves[leaf - 1];
        let count = node.count;
        let index = self.leaf_pos(leaf, target);
        if index < count && node.keys[index] == target {
            node.keys.move(index + 1, index, count - index - 1);
            node.vals.move((index + 1) * W, index * W, (count - index - 1) * W);
            node.count = count - 1;
            self.head.size = self.head.size - 1;
            if count == 1 { self.drop_leaf(leaf); } else { self.merge_leaf(leaf); }
            done = true;
        }
    }
    return done;
}
// leaf `leaf` is empty: out of the list and the tree
fn drop_leaf(leaf: i64) {
    let before = self.leaves[leaf - 1].prev;
    let after = self.leaves[leaf - 1].next;
    if before != 0 { self.leaves[before - 1].next = after; } else { self.head.first = after; }
    if after != 0 { self.leaves[after - 1].prev = before; } else { self.head.last = before; }
    let parent = self.leaves[leaf - 1].parent;
    self.leaves.remove(self.leaves[leaf - 1]);
    if parent == 0 { self.head.root = 0; self.head.height = 0; } else { self.drop_kid(parent, leaf); }
}
// child `gone` of inner node `first_node` is already freed: take it out; a node left without children goes too, and
// a root left with one child gives way to it
fn drop_kid(first_node: i64, gone: i64) {
    var node = first_node;
    var child = gone;
    var going = 1;
    foreach step in 0..19 while going == 1 {
        let index = self.kid_index(node, child);
        let inner = self.inners[node - 1];
        let count = inner.count;
        inner.kids.move(index + 1, index, count - 1 - index);
        if count > 1 {
            var key_at = 0;
            if index > 0 { key_at = index - 1; }
            inner.keys.move(key_at + 1, key_at, count - 2 - key_at);
        }
        inner.count = count - 1;
        if count == 1 {
            let above = self.inners[node - 1].parent;
            self.inners.remove(self.inners[node - 1]);
            if above == 0 { self.head.root = 0; self.head.height = 0; going = 0; } else { child = node; node = above; }
        } else {
            going = 0;
        }
    }
    self.collapse_root();
}
// a root with one child is replaced by it, as often as that holds
fn collapse_root() {
    foreach step in 0..19 while self.head.height > 0 && self.inners[self.head.root - 1].count == 1 {
        let old_root = self.head.root;
        let only = self.inners[old_root - 1].kids[0];
        if self.head.height == 1 { self.leaves[only - 1].parent = 0; } else { self.inners[only - 1].parent = 0; }
        self.head.root = only;
        self.head.height = self.head.height - 1;
        self.inners.remove(self.inners[old_root - 1]);
    }
}
// leaf `leaf` lost an entry: when it and a neighbor under the same parent fit in one leaf, they become one
fn merge_leaf(leaf: i64) {
    let count = self.leaves[leaf - 1].count;
    let after = self.leaves[leaf - 1].next;
    let before = self.leaves[leaf - 1].prev;
    let parent = self.leaves[leaf - 1].parent;
    if after != 0 && self.leaves[after - 1].parent == parent && count + self.leaves[after - 1].count <= 16 {
        self.absorb(leaf, after);
    } else if before != 0 && self.leaves[before - 1].parent == parent && count + self.leaves[before - 1].count <= 16 {
        self.absorb(before, leaf);
    }
}
// leaf `later` (the one after leaf `earlier`) moves its entries into `earlier` and is freed
fn absorb(earlier: i64, later: i64) {
    let into = self.leaves[earlier - 1];
    let from = self.leaves[later - 1];
    let into_count = into.count;
    let from_count = from.count;
    foreach offset in 0..from_count - 1 {
        into.keys[into_count + offset] = from.keys[offset];
        foreach part in 0..W - 1 { into.vals[(into_count + offset) * W + part] = from.vals[offset * W + part]; }
    }
    into.count = into_count + from_count;
    from.count = 0;
    self.drop_leaf(later);
}
