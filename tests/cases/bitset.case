// lib/bitset.mito: bits across byte boundaries, set/clear/flip/test/count, out of range is 400
--- program
struct App { bits: bitset<20>; }
state app: App;

@post("/set/{bit}")
fn post_set_bit(bit: i64) -> Response<{ changed: bool, count: i64 }> { let changed = app.bits.set(bit); return ok({ "changed": changed, "count": app.bits.count() }); }
@post("/clear/{bit}")
fn post_clear_bit(bit: i64) -> Response<{ changed: bool, count: i64 }> { let changed = app.bits.unset(bit); return ok({ "changed": changed, "count": app.bits.count() }); }
@post("/flip/{bit}")
fn post_flip_bit(bit: i64) -> Response<{ now: bool, count: i64 }> { let now = app.bits.flip(bit); return ok({ "now": now, "count": app.bits.count() }); }
@get("/test/{bit}")
fn get_test_bit(bit: i64) -> Response<{ on: bool }> { return ok({ "on": app.bits.test(bit) }); }
@get("/info")
fn get_info() -> Response<{ size: i64, count: i64 }> { return ok({ "size": app.bits.size(), "count": app.bits.count() }); }
@post("/clear_all")
fn post_clear_all() -> Response<{ count: i64 }> { app.bits.clear_all(); return ok({ "count": app.bits.count() }); }
