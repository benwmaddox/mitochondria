// `{...}` between elements inside a `{if ...}` branch: the same as in the markup (a piece's call, an escaped value), in `else if` too;
// the branch is code, so the space between `</h2>` and `{app.n}` is not text
--- program
struct App { n: i64; }
state app: App;

fn steps(name: utf8<16>) -> html { <ol><li>{name}</li></ol> }
fn help() -> html {
    <div>{if app.n == 0 {
        <h2>none</h2>
        {steps("<zero>");}
    } else if app.n == 1 {
        <h2>one</h2> {app.n}
    } else {
        <h2>many</h2>
    }}</div>
}
@post("/n/{n}")
fn set(n: i64) -> Response<{}> { app.n = n; return ok({}); }
@get("/")
fn home() -> Response<html> { return ok(<main>{help();}</main>); }
--- requests
GET /
POST /n/1
GET /
POST /n/2
GET /
