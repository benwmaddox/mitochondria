// a module instance (lib/bag.mito): its functions, its state read from outside, and references to its items
--- state
struct Score { name: string<16>; points: i64; }
struct Fav { s: ref<app.scores>; }
struct App {
    scores: bag<Score, 3>;
    others: bag<Score, 2>;
    fav: Fav;
}
state app: App;
--- api
endpoint POST /scores {
    let s = app.scores.add();
    s.name = body("name");
    s.points = int(body("points"));
    respond 201 { "slot": slot(s), "size": app.scores.size(), "room": app.scores.room() };
}
endpoint GET /scores/{k} { let s = app.scores.get(int(param("k"))); respond 200 { "name": s.name, "points": s.points }; }
endpoint DELETE /scores/{k} { app.scores.remove(app.scores.get(int(param("k")))); respond 200 { "size": app.scores.size() }; }
endpoint POST /fav/{k} { app.fav.s = app.scores.get(int(param("k"))); respond 200 {}; }
endpoint GET /fav { respond 200 { "fav": or(app.fav.s.name, "-") }; }
endpoint GET /stats {
    respond 200 {
        "added": app.scores.added(), "removed": app.scores.removed(), "count": count(app.scores.items),
        "others": app.others.size(), "names": [each s in app.scores.items s.name]
    };
}
endpoint GET /walk {
    var total = 0;
    each s in app.scores where s.points > 15 { total = total + s.points; }
    respond 200 {
        "all": [each s in app.scores s.name], "back": [each s in app.scores reverse s.name], "from1": [each s in app.scores from 1 s.name],
        "back_from1": [each s in app.scores from 1 reverse s.name], "first": [each s in app.scores limit 1 s.name], "total": total
    };
}
endpoint POST /others { let o = app.others.add(); o.points = 1; respond 201 { "size": app.others.size() }; }
--- requests
GET /walk
GET /stats
POST /scores {"name": "ann", "points": 10}
POST /scores {"name": "bob", "points": 20}
POST /scores {"name": "cy", "points": 30}
POST /scores {"name": "dee", "points": 40}
POST /scores {"name": "a name that is too long", "points": 1}
GET /scores/1
GET /scores/7
POST /fav/1
GET /fav
DELETE /scores/1
GET /fav
GET /scores/1
POST /scores {"name": "eve", "points": 50}
GET /fav
GET /stats
GET /walk
POST /others
POST /others
POST /others
GET /stats
