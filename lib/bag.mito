// A bag of up to N items of struct T: added and removed only through its functions, which count what they did.
// The smallest module: it exists to exercise the module mechanism (parameters, instance state, `self`, refs).
module bag<T: struct, N: count>
struct Counts { added: i64; removed: i64; }
// what an instance holds
state {
    items: pool<T, N> checked;
    counts: Counts;
}

pub fn add() -> T {
    let it = self.items.add();
    self.counts.added = self.counts.added + 1;
    return it;
}
pub fn remove(it: T) {
    self.items.remove(it);
    self.counts.removed = self.counts.removed + 1;
}
pub fn size() -> i64 { return self.items.count(); }
pub fn room() -> i64 { return N - self.items.count(); }
pub fn get(k: i64) -> T { return self.items[k]; }
pub fn added() -> i64 { return self.counts.added; }
pub fn removed() -> i64 { return self.counts.removed; }
// iteration (foreach s in bag [from slot] [reverse] ...): slot order; a cursor is a slot number, -1 for none
fn iter_first(from: i64?) -> i64 { foreach i in or(from, 0)..N - 1 where exists(self.items[i]) limit 1 { return i; } return -1; }
fn iter_next(cur: i64) -> i64 { foreach i in cur + 1..N - 1 where exists(self.items[i]) limit 1 { return i; } return -1; }
fn iter_last(from: i64?) -> i64 { foreach i in 0..or(from, N - 1) reverse where exists(self.items[i]) limit 1 { return i; } return -1; }
fn iter_prev(cur: i64) -> i64 { foreach i in 0..cur - 1 reverse where exists(self.items[i]) limit 1 { return i; } return -1; }
fn iter_item(cur: i64) -> T { return self.items[cur]; }
