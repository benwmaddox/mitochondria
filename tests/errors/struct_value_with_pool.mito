// expect: `Level` contains a collection (`tiles`): a struct with a pool, list or table inside is part of the state; it cannot be a value
struct Tile { n: i64; } struct Level { tiles: pool<Tile, 4>; k: i64; } struct W { l: Level; } state w: W;
@get("/a") fn a() -> Response<{ n: i64 }> { let c = Level { ..w.l }; return ok({ n: 0 }); }
