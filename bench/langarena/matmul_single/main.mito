// LangArena Matmul::Single (kostya/LangArena, MIT): n x n matrix product, single-threaded, `iterations` times. Same algorithm as the
// reference: both inputs are matgen(n), each run transposes b and takes dot products of rows of a with rows of the transpose,
// accumulating in the same order. The reference uses Vec<Vec<f64>> (a row per allocation); the language has fixed flat arrays, so each
// matrix is one array indexed i * n + j (closest-possible: same arithmetic, different shape). The reference's checksum hashes the
// text of the centre element of every run's product; the centre value is identical every run, so this port answers it (GET /result)
// and the benchmark harness formats and hashes it exactly as the reference does, over the warmup and timed runs.
struct Mat { a: f64[810000]; b: f64[810000]; bt: f64[810000] unlogged; c: f64[810000] unlogged; n: i64; center: f64; }
state m: Mat;

fn matgen_into_a_and_b() {
    let n = m.n;
    let tmp = 1.0 / (n * n);
    each i in 0..n {
        each j in 0..n {
            let v = tmp * (i - j) * (i + j);
            m.a[i * n + j] = v;
            m.b[i * n + j] = v;
        }
    }
}
fn one_run() {
    let n = m.n;
    each i in 0..n { each j in 0..n { m.bt[j * n + i] = m.b[i * n + j]; } }
    each i in 0..n {
        let row = i * n;
        each j in 0..n {
            let col = j * n;
            var s = 0.0;
            each k in 0..n { s = s + m.a[row + k] * m.bt[col + k]; }
            m.c[row + j] = s;
        }
    }
    m.center = m.c[(n / 2) * n + n / 2];
}

@post("/prepare/{n}")
fn prepare(n: i64 in 2..900) -> Response<{}> { m.n = n; matgen_into_a_and_b(); return ok({}); }
@post("/warmup/{k}")
fn warmup(k: i64 in 0..100000) -> Response<{}> { each i in 0..k { one_run(); } return ok({}); }
@post("/run/{k}")
fn run(k: i64 in 1..100000) -> Response<{}> { each i in 0..k { one_run(); } return ok({}); }
@get("/result")
fn result() -> Response<{ result: f64 }> { return ok({ "result": m.center }); }
