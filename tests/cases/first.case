// `first x in coll where ...`: the first item the loop would visit, or null. On a table it is one SELECT ... LIMIT 1 (on an indexed
// field over a whole table); on a pool or list the same loop stops at the first match.
--- program
struct User { email: ascii<40>; name: utf8<20>; }
struct Note { text: utf8<20>; pinned: bool; }
struct App { users: table<User> unique(email); notes: pool<Note, 8>; }
state app: App;

@post("/users/{email}/{name}")
fn join(email: ascii<40>, name: utf8<20>) -> Response<{ id: User }> { let u = app.users.add(); u.email = email; u.name = name; return created({ id: u }); }
@get("/users/by-email/{email}")
fn by_email(email: ascii<40>) -> Response<{ name: string }> {
    let u = first u in app.users where u.email == email;
    if !exists(u) { fail 404 "no user with that email"; }
    return ok({ name: u.name });
}
@get("/users/newest")
fn newest() -> Response<{ name: string? }> { let u = first u in app.users reverse; return ok({ name: or(u.name, null) }); }
@post("/notes/{text}/{pinned}")
fn note(text: utf8<20>, pinned: bool) -> Response<{}> { let n = app.notes.add(); n.text = text; n.pinned = pinned; return ok({}); }
@get("/notes/pinned")
fn pinned() -> Response<{ first: string }> { let n = first n in app.notes where n.pinned; return ok({ first: or(n.text, "none") }); }
--- requests
POST /users/ann%40example.com/Ann
POST /users/bob%40example.com/Bob
GET /users/by-email/bob%40example.com
GET /users/by-email/cy%40example.com
GET /users/newest
GET /notes/pinned
POST /notes/a/false
POST /notes/b/true
POST /notes/c/true
GET /notes/pinned
