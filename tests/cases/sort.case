// `array.sort(from, count, scratch)`: a stable ascending sort of integer elements of a fixed array, in the array's own range only, with a scratch array of the same element type the program
// declares (no allocation); presorted and reversed data, negatives, 8-bit and 64-bit elements, an empty and a one-element range, ranges that do not fit the array or the scratch
--- program
struct A { xs: i32[200]; tmp: i32[200]; small: i32[10]; bs: u8[64]; btmp: u8[64]; big: i64[50]; btmp2: i64[50]; }
state app: A;

@post("/fill/{seed}")
fn fill(seed: i64 in 0..1000) -> Response<{}> {
    foreach i in 0..199 { app.xs[i] = (i * 7919 + seed * 31) % 1000 - 500; }
    foreach i in 0..63 { app.bs[i] = (i * 37 + seed) % 256; }
    foreach i in 0..49 { app.big[i] = ((i * 1000003 + seed) % 17 - 8) * 1000000007000; }
    return ok({});
}
@post("/fill-sorted")
fn fill_sorted() -> Response<{}> { foreach i in 0..199 { app.xs[i] = i - 100; } return ok({}); }
@post("/fill-reversed")
fn fill_reversed() -> Response<{}> { foreach i in 0..199 { app.xs[i] = 100 - i; } return ok({}); }
@post("/sort/{from}/{count}")
fn sort_xs(from: i64, count: i64) -> Response<{ sorted: bool, hash: i64, first: i64, last: i64 }> {
    app.xs.sort(from, count, app.tmp);
    var sorted = true;
    foreach i in from + 1..from + count - 1 { if app.xs[i - 1] > app.xs[i] { sorted = false; } }
    var hash = 0;
    foreach i in 0..199 { hash = (hash * 31 + app.xs[i] + 1000) & 0xFFFFFFF; }
    return ok({ "sorted": sorted, "hash": hash, "first": app.xs[0], "last": app.xs[199] });
}
@post("/sort-small/{count}")
fn sort_small(count: i64) -> Response<{ ok: bool }> { app.xs.sort(0, count, app.small); return ok({ "ok": true }); }
@post("/sort-bytes")
fn sort_bytes() -> Response<{ hash: i64, sorted: bool }> {
    app.bs.sort(0, 64, app.btmp);
    var sorted = true;
    var hash = 0;
    foreach i in 0..63 { hash = (hash * 31 + app.bs[i]) & 0xFFFFFFF; if i > 0 && app.bs[i - 1] > app.bs[i] { sorted = false; } }
    return ok({ "hash": hash, "sorted": sorted });
}
@post("/sort-big")
fn sort_big() -> Response<{ hash: i64, sorted: bool, lo: i64, hi: i64 }> {
    app.big.sort(0, 50, app.btmp2);
    var sorted = true;
    var hash = 0;
    foreach i in 0..49 { hash = (hash * 31 + app.big[i] / 1000007) & 0xFFFFFFF; if i > 0 && app.big[i - 1] > app.big[i] { sorted = false; } }
    return ok({ "hash": hash, "sorted": sorted, "lo": app.big[0], "hi": app.big[49] });
}
--- requests
POST /fill/3
POST /sort/0/200
POST /fill/5
POST /sort/10/50
POST /fill/7
POST /sort/0/0
POST /sort/5/1
POST /sort/150/50
POST /fill-sorted
POST /sort/0/200
POST /fill-reversed
POST /sort/0/200
POST /fill/9
POST /sort/190/20
POST /sort/-1/5
POST /sort-small/10
POST /sort-small/11
POST /sort-bytes
POST /sort-big
