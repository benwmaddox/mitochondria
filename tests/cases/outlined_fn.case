// small: inlined
fn small(t: utf8<64>) -> text { return "(" + t + ")"; }
@post("/a")
fn a(t: utf8<64>, k: i64) -> Response<{ r: string; s: string }> {
    let r = big(t, k) + "!";
    return ok({ r: r, s: small(t) });
}
@post("/b")
fn b(t: utf8<64>) -> Response<{ r: string; n: i64 }> {
    let r = big(t, 699) + big(t, 5000);
    return ok({ r: r, n: len(r) });
}
--- requests
POST /a {"t": "x", "k": 3}
POST /a {"t": "yz", "k": 9999}
POST /b {"t": "q"}
