// an HTML answer written by code alone (`ok({...})`), for a fragment with no single element around it: items in a loop, none at all;
// `ok({ n: 1 })` is still a JSON object (no statement in it)
--- program
struct App { n: i64; }
state app: App;

fn item(k: i64) -> html { <li id="i{k}">{k}</li> }
@post("/n/{n}")
fn set(n: i64) -> Response<{ n: i64 }> { app.n = n; return ok({ n: app.n }); }
@get("/items")
fn items() -> Response<html> { return ok({ foreach k in 1..app.n { item(k); } }); }
--- requests
GET /items
POST /n/3
GET /items
