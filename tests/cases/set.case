// lib/set.mito: hash set of i64 keys, duplicates, full is 507, removal frees a slot, negative and large keys, clear
--- program
struct App { keys: set<6>; }
state app: App;

@post("/add/{key}")
fn post_add_key(key: i64) -> Response<{ added: bool, count: i64 }> { let added = app.keys.add(key); return ok({ "added": added, "count": app.keys.count() }); }
@get("/has/{key}")
fn get_has_key(key: i64) -> Response<{ has: bool }> { return ok({ "has": app.keys.has(key) }); }
@delete("/remove/{key}")
fn delete_remove_key(key: i64) -> Response<{ removed: bool, count: i64 }> { let removed = app.keys.remove(key); return ok({ "removed": removed, "count": app.keys.count() }); }
@get("/count")
fn get_count() -> Response<{ count: i64, room: i64 }> { return ok({ "count": app.keys.count(), "room": app.keys.room() }); }
@post("/clear")
fn post_clear() -> Response<{ count: i64 }> { app.keys.clear(); return ok({ "count": app.keys.count() }); }
