// references held in vars and returned by functions (an item, or null when there is none)
--- program
struct Node { name: string<8>; next: i64; } // the next node's slot + 1; 0 at the end
struct App {
    nodes: pool<Node, 4> checked;
    top: Top;
}
state app: App;
struct Work { names: string<64>; }
request work: Work;
struct Top { head: i64; }

fn find(name: string) -> Node? { foreach n in app.nodes { if n.name == name { return n; } } return null; }
@post("/nodes")
fn post_nodes(name: string<4096>?) -> Response<{ slot: i64 }> {
    let n = app.nodes.add();
    n.name = name;
    n.next = app.top.head;
    app.top.head = slot(n) + 1;
    return created({ "slot": slot(n) });
}
@delete("/nodes/{name}")
fn delete_nodes_name(name: string<4096>) -> Response<{}> { let n = find(name); if n == null { fail 404 "no such node"; } app.nodes.remove(n); return ok({}); }
@get("/walk")
fn get_walk() -> Response<{ names: string, steps: i64 }> {
    var cur = app.top.head;
    var steps = 0;
    foreach n in app.nodes {
        if cur != 0 && exists(app.nodes[cur - 1]) { let node = app.nodes[cur - 1]; work.names += node.name + ","; cur = node.next; steps = steps + 1; }
    }
    return ok({ "names": work.names, "steps": steps });
}
@get("/find/{name}")
fn get_find_name(name: string<4096>) -> Response<{ found: bool, name: string }> { let n = find(name); return ok({ "found": exists(n), "name": or(n.name, "-") }); }
--- requests
GET /walk
POST /nodes {"name": "a"}
POST /nodes {"name": "b"}
POST /nodes {"name": "c"}
GET /walk
GET /find/b
GET /find/z
DELETE /nodes/b
GET /walk
GET /find/b
DELETE /nodes/zz
