// array.count_below(n, target, inclusive): how many of the first n elements are below target (at most it when inclusive);
// for a sorted array, where the target belongs. All integer widths, signed and unsigned, n at its limits, bad n refused.
--- program
struct Node { keys: i64[9]; small: i8[6]; bytes: u8[5]; wide: u64[4]; }
struct App { sorted: i64[9]; n: Node; }
state app: App;

@post("/set/{i}/{v}")
fn post_set(i: i64, v: i64) -> Response<{}> { app.sorted[i] = v; app.n.keys[i] = v; return ok({}); }
@get("/count/{n}/{target}/{inc}")
fn get_count(n: i64, target: i64, inc: i64) -> Response<{ plain: i64, item: i64 }> {
    return ok({ "plain": app.sorted.count_below(n, target, inc == 1), "item": app.n.keys.count_below(n, target, inc == 1) });
}
@post("/small/{i}/{v}")
fn post_small(i: i64, v: i64) -> Response<{}> { app.n.small[i] = v; return ok({}); }
@get("/small/{n}/{target}")
fn get_small(n: i64, target: i64) -> Response<{ lt: i64, le: i64 }> { return ok({ "lt": app.n.small.count_below(n, target, false), "le": app.n.small.count_below(n, target, true) }); }
@post("/bytes/{i}/{v}")
fn post_bytes(i: i64, v: i64) -> Response<{}> { app.n.bytes[i] = v; return ok({}); }
@get("/bytes/{n}/{target}")
fn get_bytes(n: i64, target: i64) -> Response<{ lt: i64, le: i64 }> { return ok({ "lt": app.n.bytes.count_below(n, target, false), "le": app.n.bytes.count_below(n, target, true) }); }
