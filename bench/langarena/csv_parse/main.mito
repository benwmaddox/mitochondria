// LangArena CSV::Parse (kostya/LangArena, MIT): a CSV text of `rows` records of six fields (a quoted field with an escaped quote, a comma and a backslash-n, three decimals with ten digits and an empty field between
// them, another quoted field, a last decimal) is parsed `iterations` times; each run reads the decimals of fields 1, 3 and 5 of every record, and averages them. The reference's checksum adds, per run, the hash of
// each average formatted with 7 decimals, plus the hash of the whole text at the end; the three averages are the same every run, so this port answers them with the hash of the text (GET /result) and the
// benchmark harness formats and hashes them exactly as the reference does. The text is built in prepare with the reference's pieces and random sequence; a decimal is written as its ten digits (the random
// numbers are multiples of 1/139968, so the correctly rounded ten digits are an exact integer division, never a tie) and read back as digits / 10^10, which is the correctly rounded value of the decimal text
// (both are exact doubles). The parser is a quote-aware field scanner: a quoted field ends at a quote not followed by another, a record at a newline outside quotes. The reference's simd_csv is a SIMD library.
struct Csv { text: u8[12582912]; text_len: i64; rows: i64; last: i64; x_avg: f64; y_avg: f64; z_avg: f64; }
state c: Csv;

fn put(literal: string) {
    foreach index in 0..len(literal) - 1 { c.text[c.text_len] = literal[index]; c.text_len = c.text_len + 1; }
}
fn put_byte(byte: i64) { c.text[c.text_len] = byte; c.text_len = c.text_len + 1; }
fn put_int(value: i64) {
    var digits = 1;
    var rest = value;
    foreach step in 0..19 while rest >= 10 { rest = rest / 10; digits = digits + 1; }
    var slot = c.text_len + digits - 1;
    var remaining = value;
    foreach step in 0..digits - 1 {
        c.text[slot] = 48 + remaining % 10;
        remaining = remaining / 10;
        slot = slot - 1;
    }
    c.text_len = c.text_len + digits;
}
// a random number n / 139968 written as 0.dddddddddd: the ten digits are round(n * 10^10 / 139968), exact in integers
fn put_digits(state: i64) {
    let digits = (state * 20000000000 + 139968) / 279936;
    put("0.");
    var place = 1000000000;
    var rest = digits;
    foreach step in 0..9 {
        put_byte(48 + rest / place);
        rest = rest % place;
        place = place / 10;
    }
}
fn next_state() -> i64 {
    c.last = (c.last * 3877 + 29573) % 139968;
    return c.last;
}

@post("/prepare/{rows}")
fn prepare(rows: i64 in 1..120000) -> Response<{}> {
    c.rows = rows;
    c.last = 42;
    c.text_len = 0;
    foreach i in 0..rows - 1 {
        // "point <letter>\n, ""<i % 100>""",x,,z,"[<flag>\n, <i % 100>]",y
        put_byte(34); put("point "); put_byte(65 + i % 26); put_byte(92); put_byte(110); put(", "); put_byte(34); put_byte(34); put_int(i % 100); put_byte(34); put_byte(34); put_byte(34); put(",");
        let x_state = next_state();
        let z_state = next_state();
        let y_state = next_state();
        put_digits(x_state);
        put(",,");
        put_digits(z_state);
        put(",");
        put_byte(34); put("["); if i % 2 == 0 { put("true"); } else { put("false"); } put_byte(92); put_byte(110); put(", "); put_int(i % 100); put("]"); put_byte(34); put(",");
        put_digits(y_state);
        put("\n");
    }
    return ok({});
}

// the decimal in text[from..to] (digits, a point, digits): its digits as an integer over a power of ten, one correctly rounded division
fn parse_decimal(from: i64, to: i64) -> f64 {
    var mantissa = 0;
    var fraction = 0;
    var seen_point = 0;
    foreach at in from..to - 1 {
        let byte = c.text[at];
        if byte == 46 {
            seen_point = 1;
        } else {
            mantissa = mantissa * 10 + (byte - 48);
            if seen_point == 1 { fraction = fraction + 1; }
        }
    }
    var scale = 1.0;
    foreach step in 0..fraction - 1 { scale = scale * 10.0; }
    return mantissa / scale;
}
fn one_run() {
    let size = c.text_len;
    var at = 0;
    var x_sum = 0.0;
    var y_sum = 0.0;
    var z_sum = 0.0;
    var records = 0;
    foreach step in 0..size while at < size {
        var field = 0;
        var record_done = 0;
        foreach unused in 0..7 while record_done == 0 {
            // one field: quoted (ends at a quote not followed by a quote) or plain (ends at a comma or newline)
            let start = at;
            if at < size && c.text[at] == 34 {
                at = at + 1;
                var closed = 0;
                foreach scan in 0..size while closed == 0 && at < size {
                    if c.text[at] == 34 {
                        if at + 1 < size && c.text[at + 1] == 34 { at = at + 2; } else { closed = 1; at = at + 1; }
                    } else {
                        at = at + 1;
                    }
                }
            } else {
                foreach scan in 0..size while at < size && c.text[at] != 44 && c.text[at] != 10 { at = at + 1; }
            }
            if field == 1 { x_sum = x_sum + parse_decimal(start, at); }
            if field == 3 { z_sum = z_sum + parse_decimal(start, at); }
            if field == 5 { y_sum = y_sum + parse_decimal(start, at); }
            field = field + 1;
            if at < size && c.text[at] == 44 { at = at + 1; } else { record_done = 1; if at < size { at = at + 1; } }
        }
        records = records + 1;
    }
    let count = records * 1.0;
    c.x_avg = x_sum / count;
    c.y_avg = y_sum / count;
    c.z_avg = z_sum / count;
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/result")
fn result() -> Response<{ x: f64, y: f64, z: f64, hash: i64 }> {
    var hash = 5381;
    foreach index in 0..c.text_len - 1 { hash = (hash * 33 + c.text[index]) % 4294967296; }
    return ok({ "x": c.x_avg, "y": c.y_avg, "z": c.z_avg, "hash": hash });
}
