// expect: parameter `p` of `score_of` is `P`, given a value that may be null: check it first with `if exists(x)`, or declare `P?`
struct P { name: string<16>; score: i64; } struct App { ps: pool<P, 8>; total: i64; } state app: App;
fn score_of(p: P) -> i64 { return p.score; }
fn best() -> P? { foreach p in app.ps { return p; } return null; }
@get("/a") fn a() -> Response<{ n: i64 }> { return ok({ n: score_of(best()) }); }
