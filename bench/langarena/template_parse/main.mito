// LangArena Template::Parse (kostya/LangArena, MIT): render an HTML template by scanning it for {{ name }} markers (the reference's hand-written scanner, no regular expression) and replacing each with
// the value of the variable of that name (trimmed; unknown names give nothing), copying everything else; the text is built in prepare from the reference's pieces (a table of `count` rows, three
// variables per row, a comment every third row, a few single-brace pieces the scanner leaves alone) together with the variables. The checksum adds the rendered length of every run, warmup
// included, and the hash of the last rendered text. The reference's HashMap<String, String> variables are lib/strmap.mito mapping each name to a number that names its value text (a table of 23
// texts); the template is an ascii<8 MB> field built with `+=`, the rendered output a byte array written a byte at a time; a name is a window onto the text
// (`substr`, nothing copied), as the reference borrows it.
struct T {
    text: ascii<8388608>; rendered: u8[8388608]; rendered_len: i64;
    vars: strmap<150016>;
    names: u8[256]; name_off: i32[32]; name_len: i32[32]; names_len: i64;
    count: i64; result: i64;
}
state t: T;

// value text number `code`: the characters kept in `names`
fn define(code: i64, literal: string) {
    t.name_off[code] = t.names_len;
    t.name_len[code] = len(literal);
    foreach index in 0..len(literal) - 1 { t.names[t.names_len + index] = literal[index]; }
    t.names_len = t.names_len + len(literal);
}

@post("/prepare/{count}")
fn prepare(count: i64 in 1..60000) -> Response<{}> {
    t.count = count;
    t.vars.clear();
    t.names_len = 0;
    define(0, "Template title");
    define(1, "John"); define(2, "Jane"); define(3, "Bob"); define(4, "Alice"); define(5, "Charlie"); define(6, "Diana"); define(7, "Sarah"); define(8, "Mike");
    define(9, "Smith"); define(10, "Johnson"); define(11, "Brown"); define(12, "Taylor"); define(13, "Wilson"); define(14, "Davis"); define(15, "Miller"); define(16, "Jones");
    define(17, "New York"); define(18, "Los Angeles"); define(19, "Chicago"); define(20, "Houston"); define(21, "Phoenix"); define(22, "San Francisco");
    t.text = "";
    t.text += "<html><body>";
    t.text += "<h1>{{TITLE}}</h1>";
    t.vars.put("TITLE", 0);
    t.text += "<p>";
    t.text += "Lorem {ipsum} dolor {sit} amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore {et} dolore magna aliqua. ";
    t.text += "</p>";
    t.text += "<table>";
    foreach i in 0..count - 1 {
        if i % 3 == 0 { t.text += "<!-- {comment} -->"; }
        t.text += "<tr>";
        t.text += "<td>{{ FIRST_NAME"; t.text += i; t.text += " }}</td>";
        t.text += "<td>{{LAST_NAME"; t.text += i; t.text += "}}</td>";
        t.text += "<td>{{  CITY"; t.text += i; t.text += "  }}</td>";
        t.vars.put("FIRST_NAME" + i, 1 + i % 8);
        t.vars.put("LAST_NAME" + i, 9 + i % 8);
        t.vars.put("CITY" + i, 17 + i % 6);
        t.text += "<td>{balance: "; t.text += i % 100; t.text += "}</td>";
        t.text += "</tr>\n";
    }
    t.text += "</table>";
    t.text += "</body></html>";
    t.result = 0;
    t.rendered_len = 0;
    return ok({});
}

fn one_run() {
    let size = len(t.text);
    var at = 0;
    var out = 0;
    foreach step in 0..size while at < size {
        var copied = 1;
        if at + 1 < size && t.text[at] == 123 && t.text[at + 1] == 123 {
            var close = at + 2;
            foreach scan in 0..size while close + 1 < size && !(t.text[close] == 125 && t.text[close + 1] == 125) { close = close + 1; }
            if close + 1 < size {
                // the name between the braces, trimmed
                var low = at + 2;
                var high = close;
                foreach skip in 0..size while low < high && (t.text[low] == 32 || t.text[low] == 9 || t.text[low] == 10 || t.text[low] == 13) { low = low + 1; }
                foreach skip in 0..size while high > low && (t.text[high - 1] == 32 || t.text[high - 1] == 9 || t.text[high - 1] == 10 || t.text[high - 1] == 13) { high = high - 1; }
                let code = t.vars.get_or(substr(t.text, low, high - low), -1);
                if code >= 0 {
                    foreach index in 0..t.name_len[code] - 1 { t.rendered[out + index] = t.names[t.name_off[code] + index]; }
                    out = out + t.name_len[code];
                }
                at = close + 2;
                copied = 0;
            }
        }
        if copied == 1 {
            t.rendered[out] = t.text[at];
            out = out + 1;
            at = at + 1;
        }
    }
    t.rendered_len = out;
    t.result = (t.result + out) % 4294967296;
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> {
    var hash = 5381;
    foreach index in 0..t.rendered_len - 1 { hash = (hash * 33 + t.rendered[index]) % 4294967296; }
    return ok({ "checksum": (t.result + hash) % 4294967296 });
}
