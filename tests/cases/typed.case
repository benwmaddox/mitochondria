// sized number types on `let`, `var`, parameters and results: a value outside the type's range fails the request (400, naming it), an f32 is rounded to a float,
// and a loop that keeps a u32 by masking it needs no test (the compiler proves the range)
--- program
struct S { n: i64; }
state s: S;
fn mix(h: u32, b: u8) -> u32 { return ((h ^ b) * 16777619) as u32; }
fn half(x: f32) -> f32 { return x * 0.5; }
fn narrow(x: i64) -> u8 { return x; }
fn pick(flag: bool, x: i64) -> i8 { if flag { return 5; } return x; }
@get("/fnv/{n}")
fn fnv(n: i64 in 0..300) -> Response<{ h: i64 }> {
    var h: u32 = 2166136261;
    foreach i in 1..n { h = mix(h, i as u8); }
    return ok({ h: h });
}
@get("/f/{x}")
fn f(x: i64) -> Response<{ a: f64, b: f64 }> {
    let y: f32 = 16777217;
    let z: f64 = 0.1;
    return ok({ a: y, b: half(x) });
}
@get("/set/{x}")
fn set(x: i64) -> Response<{ v: i64 }> {
    var b: u8 = 250;
    b += x;
    return ok({ v: b });
}
@get("/let/{x}")
fn lets(x: i64) -> Response<{ v: i64 }> {
    let c: i16 = x;
    return ok({ v: c });
}
@get("/ret/{x}")
fn ret(x: i64) -> Response<{ v: i64 }> { return ok({ v: narrow(x) }); }
@get("/pick/{x}")
fn picks(x: i64) -> Response<{ v: i64 }> { return ok({ v: pick(x > 0, x) }); }
@get("/arg/{x}")
fn arg(x: i64) -> Response<{ v: i64 }> { return ok({ v: mix(x, 1) }); }
--- requests
