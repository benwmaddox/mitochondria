// `ascii<N>` text: bytes 0..127 only (storing, appending or copying any other fails, 400), written by index; `utf8<N>` (and
// `string<N>`, the same) takes any bytes and is never written by index
--- program
struct Word { text: ascii<8>; }
struct App { code: ascii<16>; name: utf8<16>; words: pool<Word, 4>; }
state app: App;

@post("/code")
fn set_code(v: string<16>) -> Response<{ code: string }> { app.code = v; return ok({ code: app.code }); }
@post("/name")
fn set_name(v: string<16>) -> Response<{ name: string }> { app.name = v; return ok({ name: app.name }); }
@post("/append")
fn append(v: string<16>) -> Response<{ code: string }> { app.code += v; return ok({ code: app.code }); }
@post("/copy")
fn copy_name() -> Response<{ code: string }> { app.code = substr(app.name, 0, len(app.name)); return ok({ code: app.code }); }
@post("/upper")
fn upper() -> Response<{ code: string, word: string }> {
    foreach i in 0..len(app.code) - 1 { if app.code[i] >= 97 && app.code[i] <= 122 { app.code[i] = app.code[i] - 32; } }
    let w = app.words.add();
    w.text = "abc";
    w.text[1] = 66;
    return ok({ code: app.code, word: w.text });
}
@post("/poke/{i}/{b}")
fn poke(i: i64, b: i64) -> Response<{ code: string }> { app.code[i] = b; return ok({ code: app.code }); }
--- requests
POST /code {"v": "abc-12"}
POST /code {"v": "café"}
POST /name {"v": "café"}
POST /append {"v": "xé"}
POST /copy
POST /code {"v": "hello"}
POST /upper
POST /poke/1/200
POST /poke/9/65
POST /poke/0/104
