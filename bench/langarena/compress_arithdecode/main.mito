// LangArena Compress::ArithDecode (kostya/LangArena, MIT): decode the arithmetic coding of a repeating text, `iterations` times.
// The input is `size` bytes of the repeating pattern "ABRACADABRA"; the coder is the reference's 32-bit integer arithmetic coder (low/high range, cumulative frequency tables,
// pending bits for the straddle case, bits packed most significant first). The checksum adds the length of every run's decoded text, warmup included; plus 100000 when the decoded text equals the input.
struct AR {
    data: u8[131072]; out: u8[131072]; freq: i32[256]; low_table: i64[256]; high_table: i64[256];
    size: i64; total: i64; buffer: i64; bit_pos: i64; out_len: i64; result: i64; decoded: u8[131072] unlogged; decoded_len: i64; in_pos: i64; in_bit: i64; in_cur: i64;
}
state ar: AR;

fn make_data(size: i64) {
    foreach i in 0..size - 1 {
        let slot = i % 11;
        var byte = 65;
        if slot == 1 { byte = 66; } else if slot == 2 { byte = 82; } else if slot == 3 { byte = 65; } else if slot == 4 { byte = 67; }
        else if slot == 5 { byte = 65; } else if slot == 6 { byte = 68; } else if slot == 7 { byte = 65; } else if slot == 8 { byte = 66; }
        else if slot == 9 { byte = 82; } else if slot == 10 { byte = 65; }
        ar.data[i] = byte;
    }
}
// the reference's cumulative tables: low[i] .. high[i] is symbol i's slice of 0..total
fn make_tables() {
    var total = 0;
    var cum = 0;
    foreach i in 0..255 {
        ar.low_table[i] = cum;
        cum = cum + ar.freq[i];
        ar.high_table[i] = cum;
        total = total + ar.freq[i];
    }
    ar.total = total;
}
// the reference's BitOutputStream
fn write_bit(bit: i64) {
    ar.buffer = (ar.buffer << 1) | (bit & 1);
    ar.bit_pos = ar.bit_pos + 1;
    if ar.bit_pos == 8 {
        ar.out[ar.out_len] = ar.buffer;
        ar.out_len = ar.out_len + 1;
        ar.buffer = 0;
        ar.bit_pos = 0;
    }
}
fn encode() {
    ar.freq.fill(0, 256, 0);
    foreach i in 0..ar.size - 1 { ar.freq[ar.data[i]] = ar.freq[ar.data[i]] + 1; }
    make_tables();
    var low = 0;
    var high = 4294967295;
    var pending = 0;
    ar.buffer = 0;
    ar.bit_pos = 0;
    ar.out_len = 0;
    foreach i in 0..ar.size - 1 {
        let byte = ar.data[i];
        let range = high - low + 1;
        high = low + (range * ar.high_table[byte] / ar.total) - 1;
        low = low + (range * ar.low_table[byte] / ar.total);
        var going = 1;
        foreach step in 0..999 while going == 1 {
            if high < 2147483648 {
                write_bit(0);
                foreach p in 0..pending - 1 { write_bit(1); }
                pending = 0;
            } else if low >= 2147483648 {
                write_bit(1);
                foreach p in 0..pending - 1 { write_bit(0); }
                pending = 0;
                low = low - 2147483648;
                high = high - 2147483648;
            } else if low >= 1073741824 && high < 3221225472 {
                pending = pending + 1;
                low = low - 1073741824;
                high = high - 1073741824;
            } else {
                going = 0;
            }
            if going == 1 {
                low = low << 1;
                high = ((high << 1) | 1) & 4294967295;
            }
        }
    }
    pending = pending + 1;
    if low < 1073741824 {
        write_bit(0);
        foreach p in 0..pending - 1 { write_bit(1); }
    } else {
        write_bit(1);
        foreach p in 0..pending - 1 { write_bit(0); }
    }
    // flush
    if ar.bit_pos > 0 {
        ar.buffer = ar.buffer << (8 - ar.bit_pos);
        ar.out[ar.out_len] = ar.buffer;
        ar.out_len = ar.out_len + 1;
    }
}

// the reference's BitInputStream::read_bit
fn read_bit() -> i64 {
    if ar.in_bit == 8 {
        ar.in_pos = ar.in_pos + 1;
        ar.in_bit = 0;
        if ar.in_pos < ar.out_len { ar.in_cur = ar.out[ar.in_pos]; } else { ar.in_cur = 0; }
    }
    let bit = (ar.in_cur >> (7 - ar.in_bit)) & 1;
    ar.in_bit = ar.in_bit + 1;
    return bit;
}
fn decode() {
    make_tables();
    let data_size = ar.total;
    ar.in_pos = 0;
    ar.in_bit = 0;
    if ar.out_len > 0 { ar.in_cur = ar.out[0]; } else { ar.in_cur = 0; }
    var value = 0;
    foreach i in 0..31 { value = (value << 1) | read_bit(); }
    var low = 0;
    var high = 4294967295;
    foreach j in 0..data_size - 1 {
        let range = high - low + 1;
        let scaled = ((value - low + 1) * ar.total - 1) / range;
        // partition_point: the first symbol whose cumulative high is above `scaled`
        var first = 0;
        var past = 256;
        foreach w in 0..8 while first < past {
            let mid = (first + past) / 2;
            if ar.high_table[mid] <= scaled { first = mid + 1; } else { past = mid; }
        }
        let symbol = first & 255;
        ar.decoded[j] = symbol;
        high = low + (range * ar.high_table[symbol] / ar.total) - 1;
        low = low + (range * ar.low_table[symbol] / ar.total);
        var going = 1;
        foreach step in 0..999 while going == 1 {
            if high >= 2147483648 && low < 2147483648 && (low < 1073741824 || high >= 3221225472) {
                going = 0;
            } else {
                if high < 2147483648 {
                } else if low >= 2147483648 {
                    value = value - 2147483648;
                    low = low - 2147483648;
                    high = high - 2147483648;
                } else if low >= 1073741824 && high < 3221225472 {
                    value = value - 1073741824;
                    low = low - 1073741824;
                    high = high - 1073741824;
                }
                low = low << 1;
                high = ((high << 1) | 1);
                value = (value << 1) | read_bit();
            }
        }
    }
    ar.decoded_len = data_size;
}
fn one_run() {
    decode();
    ar.result = (ar.result + ar.decoded_len) % 4294967296;
}
@post("/prepare/{size}")
fn prepare(size: i64 in 2..131072) -> Response<{}> {
    ar.size = size;
    ar.result = 0;
    make_data(size);
    encode();
    ar.decoded.fill(0, size, 0);
    return ok({});
}
@post("/warmup/{n}")
fn warmup(n: i64 in 0..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@post("/run/{n}")
fn run(n: i64 in 1..100000) -> Response<{}> { foreach i in 0..n - 1 { one_run(); } return ok({}); }
@get("/checksum")
fn checksum() -> Response<{ checksum: i64 }> {
    var same = 0;
    if ar.decoded_len == ar.size { same = 1; }
    foreach i in 0..ar.size - 1 { if ar.decoded[i] != ar.data[i] { same = 0; } }
    return ok({ "checksum": (ar.result + same * 100000) % 4294967296 });
}
